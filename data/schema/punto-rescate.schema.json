{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enlacesismo.com/schemas/punto-rescate.schema.json",
  "title": "Punto de rescate verificado",
  "description": "Entrada de data/puntos-rescate.json: punto promovido tras verificación contra fuente oficial. Cumple la regla de oro (fuente, verificado_por, fecha_verificacion) como todo catálogo.",
  "allOf": [{ "$ref": "https://enlacesismo.com/schemas/verificado.schema.json" }],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
    "nombre": { "type": "string", "minLength": 3 },
    "tipo": { "type": "string", "enum": ["derrumbe", "deslizamiento", "inundacion", "incendio", "punto-rescate", "otro"] },
    "ciudad": { "type": "string", "minLength": 2 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "coordenadas_nivel": {
      "type": "string",
      "enum": ["premisa", "via", "barrio"],
      "description": "Se copia de la entrada en vivo al promover (regla del proyecto: toda entrada lleva coordenadas_nivel)."
    },
    "direccion": { "type": "string", "minLength": 5 },
    "descripcion": { "type": "string" },
    "necesidades": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["agua", "comida", "linternas", "palas", "picos", "mascarillas", "cuerdas", "botiquin", "mantas", "maquinaria", "generador", "voluntarios"]
      },
      "uniqueItems": true
    },
    "otras_necesidades": { "type": "string" },
    "contacto": { "type": "string" },
    "estado": { "type": "string", "enum": ["confirmado", "en-curso", "resuelto"] },
    "reporte_id": { "type": "string", "pattern": "^p-[a-z0-9-]{6,20}$" },
    "created_at": { "type": "string", "minLength": 10 }
  },
  "required": ["id", "nombre", "tipo", "ciudad", "lat", "lng", "direccion", "estado", "reporte_id"]
}
