{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enlacesismo.com/schemas/reporte-punto.schema.json",
  "title": "Punto de rescate (registro en vivo)",
  "description": "Entrada de web/public/datos/reportes-puntos.json. Un punto comienza como reporte ciudadano (sin verificación). Cuando un mantenedor lo verifica contra fuente oficial, agrega nombre, fuente, verificado_por, fecha_verificacion y verificacion — en el mismo registro, sin moverlo a otro archivo.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^p-[a-z0-9-]{6,20}$" },
    "tipo": { "type": "string", "enum": ["derrumbe", "deslizamiento", "inundacion", "incendio", "punto-rescate", "otro"] },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "coordenadas_nivel": {
      "type": "string",
      "enum": ["premisa", "via", "barrio"],
      "description": "premisa = edificio/POI exacto · via = calle · barrio = centroide. Lo decide el formulario según el origen del pin (GPS/clic/manual = premisa; resultado de búsqueda = su precisión)."
    },
    "ciudad": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "description": "Ciudad del reporte, derivada del reverse geocode y normalizada. Opcional: si el geocoder falla, el punto queda sin ciudad (se oculta bajo un filtro de ciudad activo)."
    },
    "direccion": { "type": "string", "maxLength": 300 },
    "descripcion": { "type": "string", "maxLength": 1000 },
    "necesidades": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["agua", "comida", "linternas", "palas", "picos", "mascarillas", "cuerdas", "botiquin", "mantas", "maquinaria", "generador", "voluntarios"]
      },
      "uniqueItems": true
    },
    "otras_necesidades": { "type": "string", "maxLength": 300 },
    "contacto": { "type": "string", "maxLength": 200 },
    "estado": { "type": "string", "enum": ["sin-confirmar", "confirmado", "en-curso", "resuelto", "falso", "promovido"] },
    "confirmaciones": {
      "type": "array",
      "items": { "$ref": "#/$defs/confirmacion" }
    },
    "flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/flag" }
    },
    "ultima_confirmacion": { "type": "string", "minLength": 10 },
    "ediciones": {
      "type": "array",
      "items": { "$ref": "#/$defs/edicion" },
      "description": "Historial de IPs que han actualizado este reporte."
    },
    "ip_hash": { "type": "string", "minLength": 8 },
    "created_at": { "type": "string", "minLength": 10 },
    "nombre": {
      "type": "string",
      "minLength": 3,
      "description": "Nombre legible asignado por un mantenedor al verificar el punto."
    },
    "fuente": {
      "type": "string",
      "format": "uri",
      "description": "URL de la fuente oficial que respalda el punto. Se agrega al verificar."
    },
    "verificado_por": {
      "type": "string",
      "minLength": 2,
      "description": "Nombre o handle de quien verificó el dato contra la fuente."
    },
    "fecha_verificacion": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se verificó (YYYY-MM-DD)."
    },
    "verificacion": {
      "type": "string",
      "enum": ["oficial", "confirmado", "sin-confirmar"],
      "default": "sin-confirmar",
      "description": "oficial = entidad oficial · confirmado = verificado por 2+ revisores · sin-confirmar = pendiente."
    }
  },
  "$defs": {
    "confirmacion": {
      "type": "object",
      "properties": {
        "bucket": { "type": "string", "pattern": "^[-0-9.,]+$" },
        "ip_hash": { "type": "string", "minLength": 8 },
        "created_at": { "type": "string", "minLength": 10 }
      },
      "required": ["bucket", "ip_hash", "created_at"]
    },
    "flag": {
      "type": "object",
      "properties": {
        "detalle": { "type": "string", "maxLength": 500 },
        "ip_hash": { "type": "string", "minLength": 8 },
        "created_at": { "type": "string", "minLength": 10 }
      },
      "required": ["detalle", "ip_hash", "created_at"]
    },
    "edicion": {
      "type": "object",
      "properties": {
        "ip_hash": { "type": "string", "minLength": 8 },
        "created_at": { "type": "string", "minLength": 10 }
      },
      "required": ["ip_hash", "created_at"]
    }
  },
  "required": ["id", "tipo", "lat", "lng", "coordenadas_nivel", "descripcion", "necesidades", "estado", "confirmaciones", "flags", "ip_hash", "created_at"],
  "additionalProperties": false
}
