{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enlacesismo.com/schemas/acopio.schema.json",
  "title": "Punto de acopio",
  "description": "Lugar donde se reciben donaciones (alimentos, ropa, agua, medicamentos, aseo).",
  "allOf": [{ "$ref": "https://enlacesismo.com/schemas/verificado.schema.json" }],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
    "nombre": { "type": "string", "minLength": 3 },
    "ciudad": { "type": "string", "minLength": 2 },
    "departamento": { "type": "string", "minLength": 2 },
    "direccion": { "type": "string", "minLength": 5 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "coordenadas_nivel": { "type": "string", "enum": ["premisa", "via", "barrio"], "description": "premisa = edificio/POI exacto · via = calle · barrio = centroide." },
    "tipo": { "type": "string", "enum": ["oficial-comunal", "oficial-gobierno", "no-oficial"] },
    "horario": { "type": "string" },
    "necesidades": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "alimentos-no-perecederos", "agua", "ropa", "medicamentos",
          "elementos-aseo", "cobijas", "colchonetas", "alimentos-bebe",
          "mascotas", "herramientas", "voluntarios"
        ]
      },
      "uniqueItems": true
    },
    "detalles": { "type": "string" },
    "estado": {
      "type": "string",
      "enum": ["abierto", "cerrado", "sin-confirmar"],
      "description": "Estado operativo del punto de acopio."
    },
    "contacto": { "type": "string" },
    "fecha_limite": { "type": "string", "format": "date" },
    "recoleccion_periodica": { "type": "boolean" },
    "recoleccion_detalle": { "type": "string" },
    "evidencia_links": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "imagen_url": { "type": "string", "format": "uri" }
  },
  "required": ["id", "nombre", "ciudad", "departamento", "direccion", "lat", "lng", "estado"]
}
