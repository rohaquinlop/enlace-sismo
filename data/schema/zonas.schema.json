{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enlacesismo.app/schemas/zonas.schema.json",
  "title": "Zona afectada / epicentro",
  "description": "Epicentro y ciudades donde se sintió el sismo, según el SGC.",
  "allOf": [{ "$ref": "https://enlacesismo.app/schemas/verificado.schema.json" }],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{3,40}$" },
    "nombre": { "type": "string", "minLength": 2 },
    "tipo": { "type": "string", "enum": ["epicentro", "ciudad"] },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "detalle": { "type": "string" }
  },
  "required": ["id", "nombre", "tipo", "lat", "lng"]
}
