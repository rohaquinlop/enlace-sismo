{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enlacesismo.com/schemas/albergue.schema.json",
  "title": "Albergue / refugio",
  "allOf": [
    {
      "$ref": "https://enlacesismo.com/schemas/verificado.schema.json"
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,40}$"
    },
    "nombre": {
      "type": "string",
      "minLength": 3
    },
    "ciudad": {
      "type": "string",
      "minLength": 2
    },
    "departamento": {
      "type": "string",
      "minLength": 2
    },
    "direccion": {
      "type": "string",
      "minLength": 5
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "coordenadas_nivel": {
      "type": "string",
      "enum": [
        "premisa",
        "via",
        "barrio"
      ],
      "description": "premisa = edificio/POI exacto · via = calle · barrio = centroide."
    },
    "capacidad": {
      "type": "integer",
      "minimum": 1
    },
    "ocupacion": {
      "type": "integer",
      "minimum": 0
    },
    "admite_mascotas": {
      "type": "boolean"
    },
    "servicios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "estado": {
      "type": "string",
      "enum": [
        "abierto",
        "cerrado",
        "sin-confirmar"
      ]
    },
    "tipo": {
      "type": "string",
      "enum": [
        "albergue",
        "refugio"
      ]
    },
    "contacto": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "nombre",
    "ciudad",
    "departamento",
    "direccion",
    "lat",
    "lng",
    "estado",
    "tipo"
  ]
}