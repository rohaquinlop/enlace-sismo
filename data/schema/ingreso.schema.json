{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enlacesismo.com/schemas/ingreso.schema.json",
  "title": "Ingreso hospitalario",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]{3,60}$" },
    "nombre": { "type": "string", "minLength": 3 },
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "hora": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
    "lugar": { "type": "string", "minLength": 3 }
  },
  "required": ["id", "nombre", "fecha", "hora", "lugar"]
}
