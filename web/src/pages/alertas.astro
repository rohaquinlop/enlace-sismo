---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Alertas oficiales — Enlace Sismo"
  description="Boletines oficiales sobre el sismo en Colombia: réplicas del SGC, comunicados de UNGRD y alcaldías. Solo fuentes oficiales."
>
  <section class="seccion-titulo">
    <h1>Alertas oficiales</h1>
    <p>
      Boletines de entidades oficiales (SGC, UNGRD, alcaldías, Cruz Roja). Cada alerta
      publicada aquí tiene su fuente oficial enlazada.
    </p>
  </section>

  <div class="aviso">
    <strong>Fuente primaria:</strong> el SGC publica la información sísmica oficial (magnitud,
    epicentro, réplicas) en <a href="https://www.sgc.gov.co/sismos" target="_blank" rel="noopener">sgc.gov.co/sismos</a>
    y en su cuenta <a href="https://x.com/sgcol" target="_blank" rel="noopener">@sgcol</a>.
  </div>

  <div id="lista-alertas">
    <p class="vacio">Cargando alertas…</p>
  </div>
</BaseLayout>

<script>
  import { apiGet } from "../lib/api";

  interface Alerta {
    id: number;
    titulo: string;
    contenido: string;
    fuente: string;
    prioridad: string;
    created_at: string;
  }

  async function cargar() {
    const lista = document.getElementById("lista-alertas");
    if (!lista) return;
    const datos = await apiGet<Alerta[]>("/api/alertas");
    if (!datos || datos.length === 0) {
      lista.innerHTML = `
        <div class="vacio">
          <h3>Aún no hay boletines publicados</h3>
          <p>Las alertas se publican desde el API oficial de la plataforma conforme las entidades emiten comunicados.</p>
          <p style="font-size:0.85rem">Mientras tanto, consulta las fuentes oficiales: <a href="https://www.sgc.gov.co/sismos" target="_blank" rel="noopener">SGC</a> · <a href="https://gestiondelriesgo.gov.co/" target="_blank" rel="noopener">UNGRD</a> · <a href="https://www.cruzrojacolombiana.org/" target="_blank" rel="noopener">Cruz Roja</a></p>
        </div>`;
      return;
    }
    lista.innerHTML = datos
      .map(
        (a) => `
        <article class="alerta ${a.prioridad === "alta" ? "oficial" : ""}">
          <h3>${a.titulo}</h3>
          <p>${a.contenido}</p>
          <p class="alerta-meta">
            ${new Date(a.created_at).toLocaleString("es-CO")} ·
            Fuente: <a href="${a.fuente}" target="_blank" rel="noopener">${a.fuente}</a>
          </p>
        </article>`
      )
      .join("");
  }

  cargar();
</script>
