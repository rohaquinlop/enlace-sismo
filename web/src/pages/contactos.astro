---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import contactos from "../../../data/contactos.json";

// La sección se llama "Líneas de emergencia" (antes "Contactos"): muestra
// SOLO las líneas de emergencia (tipo === "emergencia"). UNGRD y SGC ya
// están como canales verificados en /ayuda (ajustes-ux-frontend).
const lineas = contactos.filter((c) => c.tipo === "emergencia");
---

<BaseLayout
  title="Líneas de emergencia — Enlace Sismo"
  description="Números oficiales de emergencia para el sismo en Colombia: 123, Bomberos 119, Cruz Roja 132 y Defensa Civil 144."
>
  <section class="seccion-titulo">
    <h1>Líneas de emergencia</h1>
    <p>Números oficiales de emergencia. Todos verificados contra fuentes oficiales.</p>
  </section>

  <div class="aviso warning">
    <strong>En una emergencia llama al 123.</strong> Si no tienes señal, busca un punto fijo,
    una estación de policía o bomberos, o un refugio oficial cercano.
  </div>

  <table class="tabla">
    <thead>
      <tr><th>Servicio</th><th>Número</th><th>Descripción</th><th>Verificación</th></tr>
    </thead>
    <tbody>
      {
        lineas.map((c) => (
          <tr>
            <td data-label="Servicio"><strong>{c.nombre}</strong></td>
            <td data-label="Número"><strong>{c.telefono}</strong></td>
            <td data-label="Descripción">
              {c.descripcion}
              <br />
              <small><a href={c.fuente} target="_blank" rel="noopener">Fuente</a> · verificado por {c.verificado_por}</small>
            </td>
            <td data-label="Verificación"><StatusBadge estado={c.estado} /></td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <p style="margin-top: var(--space-md)">
    ¿Falta una línea oficial de tu ciudad? <a href="https://github.com/rohaquinlop/enlace-sismo/issues" target="_blank" rel="noopener">Repórtalo</a>.
  </p>
</BaseLayout>
