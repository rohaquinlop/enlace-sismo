---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UbicacionPicker from "../../components/UbicacionPicker.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import type { DedupeItem } from "../../lib/ubicacion-picker";
import alberguesData from "../../../../data/albergues.json";

const dedupeDatos: DedupeItem[] = alberguesData.albergues.map((a) => ({
  id: a.id,
  nombre: a.nombre,
  lat: a.lat,
  lng: a.lng,
  ciudad: a.ciudad,
  tipo: "Albergue",
  url: `/albergues#${a.id}`,
}));
---

<BaseLayout
  title="Sugerir albergue — Enlace Sismo"
  description="Sugiere un albergue o refugio para incluir en la plataforma. Los datos serán verificados antes de publicarse."
>
  <section class="seccion-titulo">
    <Breadcrumb items={[{ label: "Albergues y refugios", href: "/albergues" }, { label: "Sugerir un albergue" }]} />
    <h1>Sugerir un albergue</h1>
    <p>
      Los datos enviados serán revisados por un mantenedor antes de publicarse.
      Todos los albergues publicados aparecen como "sin confirmar" hasta ser verificados contra una fuente oficial.
    </p>
  </section>

  <div class="aviso warning">
    <strong>Importante</strong>
    Incluye siempre la URL de la fuente oficial (comunicado de la alcaldía, UNGRD, defensa civil, etc.).
    Sin fuente verificable, la sugerencia no puede procesarse.
  </div>

  <form id="form-albergue" class="panel form-albergue" novalidate>
    <h2>Datos del albergue</h2>

    <div class="form-group">
      <label for="nombre">Nombre del albergue *</label>
      <input type="text" id="nombre" name="nombre" required minlength="3" placeholder="Coliseo Mayor de Pereira" />
      <span class="helper" id="helper-nombre"></span>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="ciudad">Ciudad *</label>
        <input type="text" id="ciudad" name="ciudad" required minlength="2" placeholder="Pereira" />
        <span class="helper" id="helper-ciudad"></span>
      </div>

      <div class="form-group">
        <label for="departamento">Departamento *</label>
        <input type="text" id="departamento" name="departamento" required minlength="2" placeholder="Risaralda" />
        <span class="helper" id="helper-departamento"></span>
      </div>
    </div>

    <div class="form-group">
      <label for="direccion">Dirección *</label>
      <input type="text" id="direccion" name="direccion" required minlength="5" placeholder="Calle 100 #15-20" />
      <span class="helper">Se completa con la dirección del pin; corrígela si no es la exacta.</span>
      <span class="helper" id="helper-direccion"></span>
    </div>

    <h2>Ubicación exacta *</h2>
    <UbicacionPicker
      dedupeDatos={dedupeDatos}
      mostrarPanelDedupe
      tituloDedupe="Este albergue ya está en el catálogo"
    />

    <div class="form-row">
      <div class="form-group">
        <label for="capacidad">Capacidad (personas)</label>
        <input type="number" id="capacidad" name="capacidad" min="1" placeholder="200" />
        <span class="helper" id="helper-capacidad"></span>
      </div>

      <div class="form-group">
        <label for="ocupacion">Ocupación actual</label>
        <input type="number" id="ocupacion" name="ocupacion" min="0" placeholder="50" />
        <span class="helper" id="helper-ocupacion"></span>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="tipo">Tipo de espacio *</label>
        <select id="tipo" name="tipo" required>
          <option value="">Seleccionar...</option>
          <option value="albergue">Albergue</option>
          <option value="refugio">Refugio</option>
        </select>
        <span class="helper" id="helper-tipo"></span>
      </div>

      <div class="form-group">
        <label for="estado">Estado *</label>
        <select id="estado" name="estado" required>
          <option value="sin-confirmar" selected>Sin confirmar</option>
          <option value="abierto">Abierto</option>
          <option value="cerrado">Cerrado</option>
        </select>
        <span class="helper" id="helper-estado"></span>
      </div>

      <div class="form-group">
        <label for="admite_mascotas">Admite mascotas</label>
        <select id="admite_mascotas" name="admite_mascotas">
          <option value="">No sé</option>
          <option value="true">Sí</option>
          <option value="false">No</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="servicios">Servicios disponibles (separados por coma)</label>
      <input type="text" id="servicios" name="servicios" placeholder="agua, alimentación, atención médica, colchonetas" />
      <span class="helper" id="helper-servicios"></span>
    </div>

    <div class="form-group">
      <label for="contacto">Contacto (opcional)</label>
      <input type="text" id="contacto" name="contacto" placeholder="Teléfono, email o ambos" />
    </div>

    <div class="form-group">
      <label for="fuente">Fuente oficial *</label>
      <input type="url" id="fuente" name="fuente" required placeholder="https://www.pereira.gov.co/albergues" />
      <span class="helper" id="helper-fuente"></span>
    </div>

    <!-- Honeypot: oculto para humanos, visible para bots -->
    <div class="form-honeypot" aria-hidden="true">
      <label for="website">Website</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-acciones">
      <button type="submit" class="btn btn-primary" id="btn-enviar">Enviar sugerencia</button>
    </div>
  </form>

  <div class="modal-resultado" id="modal-resultado" data-tipo="" role="dialog" aria-modal="true" aria-labelledby="modal-titulo">
    <div class="modal-resultado-card">
      <div class="modal-resultado-icono" id="modal-icono"></div>
      <div class="modal-resultado-titulo" id="modal-titulo"></div>
      <div class="modal-resultado-mensaje" id="modal-mensaje"></div>
      <div class="modal-acciones" id="modal-acciones"></div>
      <button class="btn btn-primary" id="modal-cerrar">Cerrar</button>
    </div>
  </div>
</BaseLayout>

<script>
  import { apiPost } from "../../lib/api";
  import { compartirSeccion } from "../../lib/compartir";
  import { EVENTO_FIJADA, EVENTO_REINICIAR, type UbicacionFijada } from "../../lib/ubicacion-picker";

  interface SugerenciaResponse {
    ok: boolean;
    issue_url?: string;
    error?: string;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("form-albergue") as HTMLFormElement | null;
    const btnEnviar = document.getElementById("btn-enviar") as HTMLButtonElement | null;
    const modal = document.getElementById("modal-resultado") as HTMLDivElement | null;
    const modalIcono = document.getElementById("modal-icono") as HTMLDivElement | null;
    const modalTitulo = document.getElementById("modal-titulo") as HTMLDivElement | null;
    const modalMensaje = document.getElementById("modal-mensaje") as HTMLDivElement | null;
    const modalAcciones = document.getElementById("modal-acciones") as HTMLDivElement | null;
    const modalCerrar = document.getElementById("modal-cerrar") as HTMLButtonElement | null;

    // ---------- Pre-relleno de la dirección desde el picker ----------
    const direccionEl = document.getElementById("direccion") as HTMLInputElement | null;
    let ultimaAutoDireccion = "";
    document.addEventListener(EVENTO_FIJADA, ((e: Event) => {
      const d = (e as CustomEvent<UbicacionFijada>).detail;
      if (!direccionEl || !d.direccion) return;
      // Pre-rellena solo si el campo está vacío o aún conserva el valor
      // anterior del picker (el usuario no lo editó a mano).
      if (direccionEl.value === "" || direccionEl.value === ultimaAutoDireccion) {
        direccionEl.value = d.direccion;
        ultimaAutoDireccion = d.direccion;
      }
    }) as EventListener);

    // ---------- Modal ----------
    // Iconos SVG propios (design.md: sin emojis como iconos; los glifos ✓/✗
    // pueden renderizar como emoji en móvil). El color lo da el CSS del modal.
    const ICONO_OK = `<svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" fill="none"><path d="M2.5 8.5 6 12l7.5-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    const ICONO_ERROR = `<svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" fill="none"><path d="m3.5 3.5 9 9m0-9-9 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>`;
    function mostrarModal(tipo: "ok" | "error", titulo: string, mensaje: string, accionesHtml = "") {
      if (!modal || !modalIcono || !modalTitulo || !modalMensaje) return;
      modal.dataset.tipo = tipo;
      modalIcono.innerHTML = tipo === "ok" ? ICONO_OK : ICONO_ERROR;
      modalTitulo.textContent = titulo;
      modalMensaje.textContent = mensaje;
      if (modalAcciones) modalAcciones.innerHTML = accionesHtml;
      modal.dataset.open = "true";
      // Diálogo modal: el foco entra al control de cierre (mismo patrón que /reportar).
      requestAnimationFrame(() => modalCerrar?.focus());
    }

    // Compartir (review de diseño): acción secundaria del modal de éxito.
    modal?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-compartir]");
      if (!btn) return;
      void compartirSeccion("/albergues", "Albergues y refugios").then((r) => {
        if (r === "copiado") {
          const previo = btn.textContent;
          btn.textContent = "Enlace copiado";
          setTimeout(() => (btn.textContent = previo), 2000);
        }
      });
    });

    function cerrarModal() {
      if (modal) modal.dataset.open = "false";
      window.location.href = "/albergues";
    }

    modalCerrar?.addEventListener("click", cerrarModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) cerrarModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal?.dataset.open === "true") cerrarModal();
    });

    // ---------- Validación ----------
    const REQUIRED: Record<string, { min?: number; label: string }> = {
      nombre: { min: 3, label: "nombre" },
      ciudad: { min: 2, label: "ciudad" },
      departamento: { min: 2, label: "departamento" },
      direccion: { min: 5, label: "dirección" },
      tipo: { label: "tipo de espacio" },
      fuente: { label: "fuente" },
      lat: { label: "latitud" },
      lng: { label: "longitud" },
    };

    function clearErrors() {
      if (!form) return;
      form.querySelectorAll<HTMLElement>("[aria-invalid]").forEach((el) => {
        el.removeAttribute("aria-invalid");
      });
      form.querySelectorAll<HTMLElement>(".helper.error").forEach((el) => {
        el.classList.remove("error");
      });
    }

    function showFieldError(field: string, msg: string) {
      const input = document.getElementById(field) as HTMLInputElement | HTMLSelectElement | null;
      const helper = document.getElementById(`helper-${field}`);
      if (input) input.setAttribute("aria-invalid", "true");
      if (helper) {
        helper.textContent = msg;
        helper.classList.add("error");
      }
    }

    function validate(): boolean {
      let ok = true;
      for (const [id, rule] of Object.entries(REQUIRED)) {
        const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;
        if (!el) continue;
        const val = el.value.trim();
        if (!val) {
          showFieldError(id, `${rule.label} es obligatorio`);
          ok = false;
        } else if (rule.min && val.length < rule.min) {
          showFieldError(id, `${rule.label} requiere al menos ${rule.min} caracteres`);
          ok = false;
        }
      }

      const tipoEl = document.getElementById("tipo") as HTMLSelectElement | null;
      const tipo = tipoEl?.value ?? "";
      if (tipo !== "albergue" && tipo !== "refugio") {
        showFieldError("tipo", "tipo de espacio inválido");
        ok = false;
      }

      const latEl = document.getElementById("lat") as HTMLInputElement | null;
      const lngEl = document.getElementById("lng") as HTMLInputElement | null;
      if (latEl?.value) {
        const v = Number(latEl.value);
        if (isNaN(v) || v < -90 || v > 90) {
          showFieldError("lat", "latitud debe estar entre -90 y 90");
          ok = false;
        }
      }
      if (lngEl?.value) {
        const v = Number(lngEl.value);
        if (isNaN(v) || v < -180 || v > 180) {
          showFieldError("lng", "longitud debe estar entre -180 y 180");
          ok = false;
        }
      }

      const nivelEl = document.getElementById("coordenadas_nivel") as HTMLInputElement | null;
      const nivel = nivelEl?.value ?? "";
      if (nivel !== "premisa" && nivel !== "via" && nivel !== "barrio") {
        showFieldError("lat", "La ubicación no es válida: fija el pin en el mapa");
        ok = false;
      }

      const capacidadEl = document.getElementById("capacidad") as HTMLInputElement | null;
      if (capacidadEl?.value) {
        const v = Number(capacidadEl.value);
        if (isNaN(v) || v < 1 || !Number.isInteger(v)) {
          showFieldError("capacidad", "capacidad debe ser un número entero mayor a 0");
          ok = false;
        }
      }

      const ocupacionEl = document.getElementById("ocupacion") as HTMLInputElement | null;
      if (ocupacionEl?.value) {
        const v = Number(ocupacionEl.value);
        if (isNaN(v) || v < 0 || !Number.isInteger(v)) {
          showFieldError("ocupacion", "ocupación debe ser un número entero mayor o igual a 0");
          ok = false;
        }
      }

      const fuenteEl = document.getElementById("fuente") as HTMLInputElement | null;
      if (fuenteEl?.value && !/^https?:\/\//.test(fuenteEl.value)) {
        showFieldError("fuente", "debe ser una URL válida (https://...)");
        ok = false;
      }

      return ok;
    }

    // ---------- Submit ----------
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearErrors();

        if (!validate()) return;

        if (btnEnviar) {
          btnEnviar.disabled = true;
          btnEnviar.setAttribute("aria-busy", "true");
          btnEnviar.textContent = "Enviando...";
        }

        const getVal = (id: string) => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          return el?.value.trim() ?? "";
        };

        const serviciosRaw = getVal("servicios");
        const servicios = serviciosRaw
          ? serviciosRaw.split(",").map((s) => s.trim()).filter(Boolean)
          : undefined;

        const admiteMascotasVal = (document.getElementById("admite_mascotas") as HTMLSelectElement | null)?.value;

        const body = {
          nombre: getVal("nombre"),
          ciudad: getVal("ciudad"),
          departamento: getVal("departamento"),
          direccion: getVal("direccion"),
          lat: Number(getVal("lat")),
          lng: Number(getVal("lng")),
          coordenadas_nivel: getVal("coordenadas_nivel") || "via",
          tipo: (document.getElementById("tipo") as HTMLSelectElement | null)?.value || "",
          capacidad: getVal("capacidad") !== "" ? Number(getVal("capacidad")) : undefined,
          ocupacion: getVal("ocupacion") !== "" ? Number(getVal("ocupacion")) : undefined,
          estado: (document.getElementById("estado") as HTMLSelectElement | null)?.value || "sin-confirmar",
          admite_mascotas: admiteMascotasVal === "" ? undefined : admiteMascotasVal === "true",
          servicios,
          contacto: getVal("contacto") || undefined,
          fuente: getVal("fuente"),
          website: getVal("website"),
        };

        const data = await apiPost<SugerenciaResponse>("/api/sugerencias/albergues", body);

        if (btnEnviar) {
          btnEnviar.disabled = false;
          btnEnviar.removeAttribute("aria-busy");
          btnEnviar.textContent = "Enviar sugerencia";
        }

        if (data?.ok) {
          mostrarModal(
            "ok",
            "Sugerencia enviada",
            "La sugerencia entró a la cola de revisión del repositorio y llegará a la sección Albergues y refugios. Un mantenedor verificará la fuente antes de publicarla.",
            `<button type="button" class="btn" data-compartir>Compartir</button>`
          );
          form.reset();
          document.dispatchEvent(new CustomEvent(EVENTO_REINICIAR));
        } else {
          mostrarModal("error", "No se pudo enviar", data?.error ?? "Intenta nuevamente más tarde.");
        }
      });
    }
  });
</script>
