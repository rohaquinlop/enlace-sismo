---
import BaseLayout from "../layouts/BaseLayout.astro";
import Map from "../components/Map.astro";
import MapLegend from "../components/MapLegend.astro";
import ZonasLista from "../components/ZonasLista.astro";
import DatosEvento from "../components/DatosEvento.astro";
import IndiceSecciones from "../components/IndiceSecciones.astro";
import { acopios, albergues, centrosSalud, todasLasCiudades } from "../lib/catalogs";
import { zonas } from "../lib/zonas";
---

<BaseLayout
  title="Mapa de zonas afectadas — Enlace Sismo"
  description="Epicentro y ciudades donde se sintió el sismo M7.4 según el SGC, más los puntos de acopio, albergues y centros de salud verificados."
>
  <main class="wide">
    <!-- Progresivo: el panel se lee en flujo sin mapa; con mapa, superpuesto. -->
    <div class="mapa-wrap">
      <Map acopios={acopios} albergues={albergues} centros={centrosSalud} zonas={zonas} />

      <aside class="dash-panel">
        <MapLegend ciudades={todasLasCiudades} mostrarZonas />
        <DatosEvento />
        <ZonasLista zonas={zonas} />
        <IndiceSecciones />
      </aside>

      <details class="dash-sheet">
        <summary>Zonas afectadas · Secciones</summary>
        <div class="dash-sheet-body">
          <MapLegend ciudades={todasLasCiudades} mostrarZonas />
          <DatosEvento />
          <ZonasLista zonas={zonas} />
          <IndiceSecciones />
        </div>
      </details>
    </div>
  </main>
</BaseLayout>
