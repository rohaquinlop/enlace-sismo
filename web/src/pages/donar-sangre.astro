---
import BaseLayout from "../layouts/BaseLayout.astro";
import JornadaSangreCard from "../components/JornadaSangreCard.astro";
import { jornadasSangre, agruparPorCiudad } from "../lib/catalogs";

const grupos = agruparPorCiudad(jornadasSangre);
---

<BaseLayout
  title="Donar sangre — Enlace Sismo"
  description="Jornadas de donación de sangre para los damnificados del sismo en Colombia: dónde, cuándo y qué grupos se necesitan. Verificadas contra fuentes."
>
  <section class="seccion-titulo">
    <h1>Donar sangre</h1>
    <p>
      Jornadas de donación de sangre habilitadas tras el sismo. Cada jornada está verificada contra una fuente.
      Confirma por teléfono antes de desplazarte: las jornadas pueden cambiar o cerrarse.
    </p>
  </section>

  <div id="contenido-sangre">
  {
    jornadasSangre.length === 0 ? (
      <div class="vacio">
        <h3>Aún no hay jornadas de donación verificadas</h3>
        <p>
          Las jornadas oficiales están siendo confirmadas por la Cruz Roja y las alcaldías.
          Este es un proyecto open-source: si tienes un dato verificado, súbelo y publícalo.
        </p>
        <a class="btn btn-primary" href="https://github.com/rohaquinlop/enlace-sismo/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Agregar una jornada (guía)</a>
      </div>
    ) : (
      <>
        {grupos.map((grupo) => (
          <section class="ciudad-grupo" data-ciudad={grupo.ciudad} data-lat={grupo.lat} data-lng={grupo.lng}>
            <h2 class="ciudad-titulo">{grupo.ciudad}</h2>
            <div class="grid">
              {grupo.items.map((j) => (
                <div class="card-item" data-ciudad={j.ciudad}>
                  <JornadaSangreCard jornada={j} />
                </div>
              ))}
            </div>
          </section>
        ))}
      </>
    )
  }
  </div>
</BaseLayout>

<script>
  import { haversineKm } from "../lib/geo";
  import { fetchCatalogo } from "../lib/datos";
  import { renderSangrePagina } from "../lib/render-catalogos";
  import type { JornadaSangre } from "../lib/catalogs";

  let ultimaPos: { latitude: number; longitude: number } | null = null;

  function reordenarPorProximidad(latitude: number, longitude: number) {
    const secciones = Array.from(document.querySelectorAll<HTMLElement>(".ciudad-grupo"));
    if (secciones.length < 2) return;

    const distancias = secciones.map((s) => {
      const lat = Number(s.dataset.lat);
      const lng = Number(s.dataset.lng);
      return { seccion: s, km: haversineKm(latitude, longitude, lat, lng) };
    });

    distancias.sort((a, b) => a.km - b.km);
    const padre = secciones[0].parentNode;
    const primera = distancias[0].seccion;

    for (const d of distancias) {
      padre?.appendChild(d.seccion);
    }

    const ciudad = primera.dataset.ciudad;
    const indicador = document.createElement("p");
    indicador.className = "geo-indicador";
    indicador.textContent = `Mostrando ${ciudad} primero (más cercana a ti)`;
    primera.insertBefore(indicador, primera.querySelector(".grid"));
  }

  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        ultimaPos = { latitude: pos.coords.latitude, longitude: pos.coords.longitude };
        reordenarPorProximidad(ultimaPos.latitude, ultimaPos.longitude);
      },
      () => {},
      { enableHighAccuracy: false, timeout: 10000 }
    );
  }

  // Refresco runtime (desacoplar-datos-deploy): datos frescos del API con
  // fallback al SSG. Si el API falla, la página queda como se renderizó.
  async function refrescar() {
    const data = await fetchCatalogo<{ jornadas: JornadaSangre[] }>("donacion-sangre");
    if (!data || !Array.isArray(data.jornadas)) return;
    const cont = document.getElementById("contenido-sangre");
    if (!cont) return;
    cont.innerHTML = renderSangrePagina(data.jornadas);
    if (ultimaPos) reordenarPorProximidad(ultimaPos.latitude, ultimaPos.longitude);
  }
  void refrescar();
</script>
