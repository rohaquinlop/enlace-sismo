---
import BaseLayout from "../layouts/BaseLayout.astro";
import Map from "../components/Map.astro";
import MapLegend from "../components/MapLegend.astro";
import DatosEvento from "../components/DatosEvento.astro";
import ZonasLista from "../components/ZonasLista.astro";
import IndiceSecciones from "../components/IndiceSecciones.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { acopios, albergues, centrosSalud, todasLasCiudades } from "../lib/catalogs";
import { zonas } from "../lib/zonas";
---

<BaseLayout
  title="Enlace Sismo — Información verificada para el sismo en Colombia"
  description="Mapa de zonas afectadas y epicentro del sismo M7.4 del 10 de agosto de 2026: intensidad, distancias y puntos de ayuda cerca de ti. Cada dato tiene fuente verificable."
  rail={false}
>
  <main class="wide">
    <!-- Progresivo: sin JavaScript o sin mapa, el contenido se lee en flujo
         (evento → zonas → secciones → leyenda). Solo cuando el mapa carga,
         .con-mapa posiciona esos bloques como overlays sobre el mapa. -->
    <section class="dash" id="mapa" aria-label="Mapa de ayuda">
      <Map acopios={acopios} albergues={albergues} centros={centrosSalud} zonas={zonas} />

      <DatosEvento />

      <div class="mapa-overlays">
        <ZonasLista zonas={zonas} />

        <div class="mapa-base">
          <details class="secciones-box">
            <summary>Secciones</summary>
            <div class="box-body">
              <IndiceSecciones />
            </div>
          </details>
          <details class="mapa-leyenda-box">
            <summary>Leyenda</summary>
            <div class="box-body">
              <MapLegend ciudades={todasLasCiudades} mostrarZonas />
            </div>
          </details>
        </div>
      </div>
    </section>

    <section class="verif-strip" aria-label="Niveles de verificación">
      <StatusBadge estado="oficial" /> publicado por entidad oficial
      <StatusBadge estado="confirmado" /> verificado por 2+ revisores
      <StatusBadge estado="sin-confirmar" /> pendiente — cautela
      <span style="flex: 1"></span>
      <a href="https://github.com/rohaquinlop/enlace-sismo/issues" target="_blank" rel="noopener">
        ¿Ves un dato incorrecto? Repórtalo
      </a>
    </section>
  </main>
</BaseLayout>
