---
import { readFileSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import Map from "../components/Map.astro";
import MapLegend from "../components/MapLegend.astro";
import DatosEvento from "../components/DatosEvento.astro";
import ZonasLista from "../components/ZonasLista.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { acopios, albergues, centrosSalud, jornadasSangre, todasLasCiudades } from "../lib/catalogs";
import { zonas } from "../lib/zonas";
import evento from "../../../data/evento.json";
import { puntoAyudaVisible, lineaCobertura, actualizadoHace, agregarItemsNecesarios, etiquetaAgregado, type PuntoAyuda } from "../lib/puntos-ayuda";
import { agruparCiudades, fusionarCiudadesSelect, nombreCiudadNormalizado, type CiudadReportada } from "../lib/ciudades";
import { etiquetaTipo, etiquetaModalidadCorta, etiquetaItemAyuda, etiquetaPrecision, ESTADOS_AYUDA } from "../lib/items-ayuda";
import { estadoVerificacion } from "../lib/verificacion";

// Ciudades del filtro = unión de las que tienen puntos de datos, las zonas
// afectadas y las ciudades derivadas de los puntos de ayuda en vivo:
// clic en una zona sin puntos registrados filtra a "0 puntos" (información
// honesta) en vez de quedarse en "todas".
const catalogadas = Array.from(
  new Set([
    ...todasLasCiudades,
    ...zonas.filter((z) => z.tipo === "ciudad").map((z) => z.nombre),
  ])
);
// Dedupe insensible a acentos/caja: "Bogotá" del catálogo y "bogota" del
// reporte son la misma ciudad.
const catalogadasNorm = new Set(catalogadas.map(nombreCiudadNormalizado));

// Puntos de ayuda: el snapshot lo genera el deploy (GET /api/ayuda → D1);
// el build lo lee para la lista SSG (fallback sin JS/API).
let vivos: PuntoAyuda[] = [];
try {
  const raw = readFileSync(new URL("../../public/datos/reportes-ayuda.json", import.meta.url), "utf8");
  const parsed = JSON.parse(raw);
  if (Array.isArray(parsed)) vivos = parsed as PuntoAyuda[];
} catch {
  // Sin snapshot todavía (primer clon o antes del primer deploy).
}
const visibles = vivos.filter((p) => puntoAyudaVisible(p)).sort((a, b) => b.ultima_actualizacion.localeCompare(a.ultima_actualizacion));

// Ítems agregados de los puntos que necesitan (modalidad necesita/ambos):
// suma de cantidades, no solo conteo de puntos (coherente con las tarjetas).
const cuentanItems = (p: PuntoAyuda) => p.modalidad === "necesita" || p.modalidad === "ambos";
const agregado = agregarItemsNecesarios(visibles);

// Badge de verificación de un punto (derivado de los datos sin inventar).
const badgeVerificacion = (p: PuntoAyuda): string => estadoVerificacion(p);

// Ciudades con puntos de ayuda: agrupadas del registro y deduplicadas
// contra el catálogo (una ciudad oficial no se lista como reportada).
const ciudadesReportadas: CiudadReportada[] = agruparCiudades(vivos).filter(
  (c) => !catalogadasNorm.has(nombreCiudadNormalizado(c.nombre))
);
const ciudadesFiltro = fusionarCiudadesSelect(
  catalogadas,
  ciudadesReportadas.map((c) => c.nombre)
);
const enlaceMaps = (lat: number, lng: number) =>
  `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
const lineaDestino = (p: PuntoAyuda): string => {
  if (!p.destino) return "";
  if (p.destino.transporta && p.destino.ciudades.length > 0) {
    return `Lleva a: ${p.destino.ciudades.join(", ")}`;
  }
  return "Entrega solo en este punto";
};
---

<BaseLayout
  title="Enlace Sismo — Información verificada para el sismo en Colombia"
  description="Mapa de zonas afectadas y epicentro del sismo M7.4 del 10 de agosto de 2026: intensidad, distancias y puntos de ayuda cerca de ti. Cada dato tiene fuente verificable."
>
  <!-- Progresivo: sin JavaScript o sin mapa, el contenido se lee en flujo
       (evento → zonas → secciones → leyenda). Solo cuando el mapa carga,
       .con-mapa posiciona esos bloques como overlays sobre el mapa.
       (Sin <main> propio: BaseLayout ya lo aporta; un main anidado
       constreñía el mapa al ancho de 68rem y añadía scroll vertical.) -->
  <section class="dash" id="mapa" aria-label="Mapa de ayuda">
      <Map acopios={acopios} albergues={albergues} centros={centrosSalud} jornadas={jornadasSangre} zonas={zonas} ciudadesReportadas={ciudadesReportadas} />

      <DatosEvento />

      <div class="mapa-overlays">
        <button type="button" class="rail-toggle" id="rail-toggle" aria-expanded="true" aria-controls="rail-panel-aside" aria-label="Ocultar panel">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <aside class="rail" id="rail-panel-aside" aria-label="Panel de información">
          <div class="rail-tabs" role="tablist" aria-label="Contenido del panel">
            <button type="button" class="rail-tab" role="tab" id="tab-zonas" aria-controls="panel-zonas" aria-selected="true">
              Zonas
            </button>
            <button type="button" class="rail-tab" role="tab" id="tab-ayuda" aria-controls="panel-ayuda" aria-selected="false" tabindex="-1">
              Ayuda
            </button>
          </div>
          <div class="rail-panel" role="tabpanel" id="panel-zonas" aria-labelledby="tab-zonas">
            <!-- Slot con el estado SSG (ciudades reportadas + fecha del evento):
                 el refresco runtime re-renderiza el panel con datos frescos del
                 API y conserva estos valores como respaldo (desacoplar-datos-deploy). -->
            <div id="zonas-slot" data-ciudades-reportadas={JSON.stringify(ciudadesReportadas)} data-fecha-evento={evento.fecha.slice(0, 10)}>
              <ZonasLista zonas={zonas} ciudadesReportadas={ciudadesReportadas} />
            </div>
          </div>
          <!-- Puntos de ayuda: reportes ciudadanos en vivo (D1 vía API; el
               snapshot es SSG, el script la refresca tras crear/editar). -->
          <div class="rail-panel" role="tabpanel" id="panel-ayuda" aria-labelledby="tab-ayuda">
            <div class="dash-index">
              <div class="dash-index-head">
                <h3>Puntos de ayuda</h3>
                <span class="zonas-count" id="ayuda-conteo" aria-label={`${visibles.length} puntos activos`}>{visibles.length}</span>
              </div>
              <!-- Acción principal del panel: barra de acción sticky al inicio
                   (acceso rápido a /reportar; el contenido scrollea debajo). -->
              <a class="dash-row dash-cta" href="/reportar">
                <span class="dash-row-top">
                  <span class="dash-row-nombre">Reportar una necesidad u oferta</span>
                  <span class="dash-row-meta">en vivo</span>
                </span>
                <p>¿Tu lugar necesita algo o recolecta para otras zonas? Publícalo con ubicación, ítems y destino.</p>
              </a>
              <!-- Contenido re-renderizado por el refresco runtime y por el
                   filtro de zona activa (clic en una zona → sus puntos).
                   data-ayuda: el SSG alimenta el filtro desde el primer
                   momento (antes del primer refresco del API). -->
              <div id="ayuda-panel" data-ayuda={JSON.stringify(vivos)}>
                {
                  visibles.length === 0 ? (
                    <p class="ayuda-vacio">
                      Sin puntos de ayuda ahora.
                      {vivos.filter((p) => !puntoAyudaVisible(p)).length > 0 ? ` Hay ${vivos.filter((p) => !puntoAyudaVisible(p)).length} en el histórico.` : ""}{" "}
                      <a href="/reportar">Reportar una necesidad u oferta</a>
                    </p>
                  ) : (
                    <>
                      {
                        agregado.length > 0 && (
                          <span class="ayuda-agregado" id="ayuda-agregado">
                            {visibles.filter(cuentanItems).length} punto{visibles.filter(cuentanItems).length === 1 ? "" : "s"} necesitan:{" "}
                            {agregado
                              .slice(0, 4)
                              .map((a) => `${etiquetaItemAyuda({ tipo: "catalogo", id: a.id })} ×${etiquetaAgregado(a)}`)
                              .join(", ")}
                          </span>
                        )
                      }
                      <div id="ayuda-lista">
                        {visibles.map((p) => (
                          <article class="ayuda-fila" data-id={p.id} data-volar-ayuda={p.id} title="Ver en el mapa">
                            <div class="dash-row-top">
                              <span class="dash-row-nombre">
                                {p.nombre ?? etiquetaTipo(p.tipo)}{p.direccion ? ` — ${p.direccion}` : ""}
                              </span>
                              <span class="dash-row-meta">
                                {p.ciudad ? `${p.ciudad} · ` : ""}{etiquetaModalidadCorta(p.modalidad)}
                                {p.coordenadas_nivel ? ` · ${etiquetaPrecision(p.coordenadas_nivel)}` : ""}
                              </span>
                            </div>
                            <span class="ayuda-badges">
                              <StatusBadge estado={badgeVerificacion(p)} />
                              <span class="ayuda-estado">{ESTADOS_AYUDA[p.estado] ?? p.estado}</span>
                            </span>
                            {p.descripcion && <p class="ayuda-descripcion">{p.descripcion}</p>}
                            {
                              p.items.length > 0 && (
                                <span class="popup-ayuda-ns">
                                  {p.items.map((i) => (
                                    <span>{etiquetaItemAyuda(i)}</span>
                                  ))}
                                </span>
                              )
                            }
                            {lineaDestino(p) && <p class="ayuda-destino">{lineaDestino(p)}</p>}
                            {
                              lineaCobertura(p, vivos, acopios) && (
                                <p class="ayuda-cobertura">{lineaCobertura(p, vivos, acopios)}</p>
                              )
                            }
                            {p.horario && <p class="ayuda-destino">Horario: {p.horario}</p>}
                            {p.flags > 0 && <p class="ayuda-destino">{p.flags} reporte(s) de falso</p>}
                            {actualizadoHace(p) && <p class="ayuda-destino">Actualizado {actualizadoHace(p)}</p>}
                            <div class="ayuda-acciones">
                              <a class="btn" href={enlaceMaps(p.lat, p.lng)} target="_blank" rel="noopener">Cómo llegar</a>
                              <button type="button" class="btn" data-flag={p.id}>Reportar punto falso</button>
                              <!-- Actualizar / Cerrar punto: solo con token del
                                   navegador; el render JS los agrega (SSG sin token). -->
                            </div>
                          </article>
                        ))}
                      </div>
                    </>
                  )
                }
              </div>
            </div>
          </div>
          <!-- Pie del panel: cómo leer la verificación de cada dato (fuera de
               las pestañas, visible siempre) -->
          <div class="rail-verif" role="group" aria-label="Niveles de verificación de los datos">
            <span class="verif-label">Verificación</span>
            <StatusBadge estado="oficial" />
            <StatusBadge estado="confirmado" />
            <StatusBadge estado="sin-confirmar" />
          </div>
        </aside>

        <MapLegend ciudades={ciudadesFiltro} mostrarZonas mostrarAyuda ayudaActivos={visibles.length} />
      </div>
    </section>

    <!-- Diálogo de acción del panel Ayuda: reportar punto falso / cerrar punto.
         Los botones "Actualizar" se habilitan solo con token (script). -->
    <div class="dialogo-accion" id="dialogo-accion" hidden>
      <div class="dialogo-accion-caja" role="dialog" aria-modal="true" aria-labelledby="dialogo-titulo">
        <h3 id="dialogo-titulo"></h3>
        <p id="dialogo-texto"></p>
        <textarea id="dialogo-detalle" aria-label="Detalle del reporte" hidden placeholder="Explica por qué es falso…"></textarea>
        <p class="dialogo-accion-msg" id="dialogo-msg" aria-live="polite"></p>
        <div class="dialogo-accion-acciones">
          <button type="button" class="btn" id="dialogo-cancelar">Cancelar</button>
          <button type="button" class="btn btn-primary" id="dialogo-ok">Confirmar</button>
        </div>
      </div>
    </div>

<script>
  import { apiUrl } from "../lib/api";
  import { fetchCatalogo, fetchPuntosAyuda } from "../lib/datos";
  import { puntoAyudaVisible, lineaCobertura, actualizadoHace, agregarItemsNecesarios, etiquetaAgregado, type PuntoAyuda } from "../lib/puntos-ayuda";
  import { agruparCiudades, nombreCiudadNormalizado, type CiudadReportada } from "../lib/ciudades";
  import { estadoVerificacion } from "../lib/verificacion";
  import { etiquetaTipo, etiquetaModalidadCorta, etiquetaItemAyuda, etiquetaPrecision, ESTADOS_AYUDA, type ItemAyuda } from "../lib/items-ayuda";
  import { renderZonasListaHTML } from "../lib/render-catalogos";
  import { acopios, albergues, centrosSalud, jornadasSangre } from "../lib/catalogs";
  import type { Acopio, Albergue, CentroSalud, JornadaSangre } from "../lib/catalogs";
  import { zonas } from "../lib/zonas";
  import type { Zona } from "../lib/zonas";

  // Tokens de edición de los puntos creados desde este navegador (localStorage).
  // El token se entrega al crear y permite editar/cerrar el punto desde
  // cualquier dispositivo (respaldo por IP en el worker).
  const CLAVE_TOKENS = "enlace-ayuda:tokens";
  function leerTokens(): Record<string, string> {
    try {
      return JSON.parse(localStorage.getItem(CLAVE_TOKENS) ?? "{}") as Record<string, string>;
    } catch {
      return {};
    }
  }

  // Tabs del rail (mejora progresiva): sin JS, ambos paneles quedan visibles
  // y el tablist es inerte. Con JS, solo el panel activo se muestra.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".rail-tab"));
  const paneles = tabs.map((t) => document.getElementById(t.getAttribute("aria-controls") ?? ""));

  // Toggle del rail en móvil: colapsa/expande el aside + la tira de leyenda
  const railToggle = document.getElementById("rail-toggle") as HTMLButtonElement | null;
  const railAside = document.getElementById("rail-panel-aside") as HTMLElement | null;
  const leyendaTira = railToggle?.parentElement?.querySelector<HTMLElement>(".leyenda-tira") ?? null;

  function colapsarPanel() {
    if (!railToggle || railToggle.getAttribute("aria-expanded") !== "true") return;
    railToggle.setAttribute("aria-expanded", "false");
    railToggle.setAttribute("aria-label", "Mostrar panel");
    if (railAside) railAside.hidden = true;
    if (leyendaTira) leyendaTira.hidden = true;
  }

  railToggle?.addEventListener("click", () => {
    const expanded = railToggle.getAttribute("aria-expanded") === "true";
    railToggle.setAttribute("aria-expanded", String(!expanded));
    railToggle.setAttribute("aria-label", expanded ? "Mostrar panel" : "Ocultar panel");
    if (railAside) railAside.hidden = expanded;
    if (leyendaTira) leyendaTira.hidden = expanded;
  });

  // Auto-colapsar panel en móvil al hacer click en un punto del mapa
  function esMovil() {
    return railToggle ? getComputedStyle(railToggle).display !== "none" : false;
  }
  window.addEventListener("enlace:mapa:punto-click", () => {
    if (esMovil()) colapsarPanel();
  });
  const tabZonas = tabs.find((t) => t.id === "tab-zonas");

  function activar(tab: HTMLButtonElement) {
    tabs.forEach((t, i) => {
      const activo = t === tab;
      t.setAttribute("aria-selected", String(activo));
      t.tabIndex = activo ? 0 : -1;
      const panel = paneles[i];
      if (panel) panel.hidden = !activo;
    });
  }

  tabs.forEach((t) => t.addEventListener("click", () => activar(t)));

  const tablist = document.querySelector<HTMLElement>(".rail-tabs");
  tablist?.addEventListener("keydown", (e: KeyboardEvent) => {
    const actual = tabs.indexOf(document.activeElement as HTMLButtonElement);
    if (actual === -1) return;
    let siguiente = actual;
    if (e.key === "ArrowRight") siguiente = (actual + 1) % tabs.length;
    else if (e.key === "ArrowLeft") siguiente = (actual - 1 + tabs.length) % tabs.length;
    else if (e.key === "Home") siguiente = 0;
    else if (e.key === "End") siguiente = tabs.length - 1;
    else return;
    e.preventDefault();
    tabs[siguiente].focus();
    activar(tabs[siguiente]);
  });

  // Sync con el mapa: popup de zona o geolocalización → pestaña Zonas.
  // Un id vacío solo limpia el resaltado; no cambia de pestaña.
  // La zona activa además filtra el panel Ayuda (epicentro = todas).
  /** Navegación zona → ayuda: filtra el panel por ciudad y muestra la
      pestaña Ayuda (el usuario ve los puntos de esa zona al instante). */
  function activarZonaAyuda(nombre: string | null, cambiarPestana = false) {
    if (zonaAyuda !== nombre) {
      zonaAyuda = nombre;
      if (ultimoAyuda) aplicarAyuda(ultimoAyuda);
    }
    if (cambiarPestana && nombre) {
      const tabAyuda = document.getElementById("tab-ayuda") as HTMLButtonElement | null;
      if (tabAyuda) activar(tabAyuda);
    }
  }

  // Clic en una fila de zona (ZonasLista): filtra ayuda por esa ciudad y
  // muestra la pestaña Ayuda. Funciona aunque el mapa no haya cargado
  // (modo flujo): el evento lo emite la fila, no el mapa.
  window.addEventListener("enlace:mapa:volar-zona", (e) => {
    const id = (e as CustomEvent<{ id?: string }>).detail?.id;
    if (!id) return;
    const z = zonasActuales.find((x) => x.id === id);
    activarZonaAyuda(z && z.tipo !== "epicentro" ? z.nombre : null, !!z && z.tipo !== "epicentro");
  });

  // Popup de zona abierto en el mapa (marcador o select de ciudad): filtra
  // el panel SIN cambiar de pestaña — el usuario está explorando el mapa; el
  // salto a Ayuda es solo del clic explícito en las filas (volar-zona).
  window.addEventListener("enlace:mapa:zona-activa", (e) => {
    const id = (e as CustomEvent<{ id?: string }>).detail?.id;
    if (!id) {
      activarZonaAyuda(null);
      return;
    }
    const z = zonasActuales.find((x) => x.id === id);
    activarZonaAyuda(z && z.tipo !== "epicentro" ? z.nombre : null);
  });
  window.addEventListener("enlace:mapa:ciudad-reportada", (e) => {
    const nombre = (e as CustomEvent<{ nombre?: string }>).detail?.nombre;
    if (nombre) activarZonaAyuda(nombre, true);
  });
  window.addEventListener("enlace:mapa:posicion", () => tabZonas && activar(tabZonas));

  // Chip "Ayuda" ↔ pestaña del rail: marcado muestra el panel, desmarcado
  // vuelve a Zonas si la pestaña activa era Ayuda.
  const chipAyuda = document.querySelector<HTMLInputElement>(".leyenda-tira input[value='ayuda']");
  const tabAyuda = tabs.find((t) => t.id === "tab-ayuda");
  chipAyuda?.addEventListener("change", () => {
    if (chipAyuda.checked) {
      if (tabAyuda) activar(tabAyuda);
    } else if (tabAyuda?.getAttribute("aria-selected") === "true") {
      if (tabZonas) activar(tabZonas);
    }
  });

  const panelAyuda = document.getElementById("panel-ayuda");

  // Navegación del panel Ayuda: clic en la fila → el mapa vuela al punto
  // y abre su popup (los botones no disparan el vuelo).
  panelAyuda?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("a, button")) return;
    const fila = target.closest<HTMLElement>("[data-volar-ayuda]");
    if (fila?.dataset.volarAyuda) {
      window.dispatchEvent(
        new CustomEvent("enlace:mapa:volar-ayuda", { detail: { id: fila.dataset.volarAyuda } })
      );
    }
  });

  // Abrir el diálogo de acción desde las tarjetas (flag / cerrar).
  panelAyuda?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const flagBtn = target.closest<HTMLButtonElement>("[data-flag]");
    if (flagBtn?.dataset.flag) {
      abrirDialogo({ tipo: "flag", id: flagBtn.dataset.flag });
      return;
    }
    const cerrarBtn = target.closest<HTMLButtonElement>("[data-cerrar]");
    if (cerrarBtn?.dataset.cerrar) {
      abrirDialogo({ tipo: "cerrar", id: cerrarBtn.dataset.cerrar });
    }
  });

  // Clic en un punto de ayuda del mapa → el panel Ayuda muestra su tarjeta:
  // activa la pestaña, resalta la fila y la trae a la vista (misma dirección
  // que volar-ayuda, pero disparada por el mapa). El resaltado se conserva
  // tras los re-renders del refresco (ultimoPuntoActivo).
  let ultimoPuntoActivo: string | null = null;
  window.addEventListener("enlace:mapa:punto-ayuda-activo", (e) => {
    const id = (e as CustomEvent<{ id?: string }>).detail?.id;
    if (!id) return;
    ultimoPuntoActivo = id;
    const tabAyudaAct = document.getElementById("tab-ayuda") as HTMLButtonElement | null;
    if (tabAyudaAct) activar(tabAyudaAct);
    resaltarPuntoAyuda(id);
  });

  function resaltarPuntoAyuda(id: string) {
    document.querySelectorAll<HTMLElement>(".ayuda-fila.activa").forEach((f) => f.classList.remove("activa"));
    const fila = document.querySelector<HTMLElement>(`#ayuda-lista [data-id="${CSS.escape(id)}"]`);
    if (!fila) return;
    fila.classList.add("activa");
    fila.setAttribute("aria-current", "true");
    fila.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  // "Ver todos" del filtro de zona: limpia el panel y el select del mapa.
  panelAyuda?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-ayuda-todos]");
    if (!btn) return;
    zonaAyuda = null;
    const select = document.querySelector<HTMLSelectElement>(".leyenda-tira select");
    if (select && select.value !== "") {
      select.value = "";
      select.dispatchEvent(new Event("change")); // el mapa vuelve a "Ciudad: Todas"
    }
    if (ultimoAyuda) aplicarAyuda(ultimoAyuda);
  });

  const escapar = (s: string) =>
    s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!
    );

  // ---------- Diálogo de acción: Reportar punto falso / Cerrar punto ----------
  const dialogo = document.getElementById("dialogo-accion") as HTMLDivElement | null;
  const dialogoTitulo = document.getElementById("dialogo-titulo") as HTMLHeadingElement | null;
  const dialogoTexto = document.getElementById("dialogo-texto") as HTMLParagraphElement | null;
  const dialogoDetalle = document.getElementById("dialogo-detalle") as HTMLTextAreaElement | null;
  const dialogoMsg = document.getElementById("dialogo-msg") as HTMLParagraphElement | null;
  const dialogoOk = document.getElementById("dialogo-ok") as HTMLButtonElement | null;
  const dialogoCancelar = document.getElementById("dialogo-cancelar") as HTMLButtonElement | null;

  type AccionDialogo = { tipo: "flag" | "cerrar"; id: string } | null;
  let accionDialogo: AccionDialogo = null;
  // Foco: se restaura al botón que abrió el diálogo al cerrar (a11y).
  let ultimoFoco: HTMLElement | null = null;

  function abrirDialogo(accion: NonNullable<AccionDialogo>) {
    if (!dialogo || !dialogoTitulo || !dialogoTexto || !dialogoDetalle || !dialogoMsg || !dialogoOk) return;
    accionDialogo = accion;
    ultimoFoco = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    dialogoDetalle.value = "";
    dialogoDetalle.removeAttribute("aria-invalid");
    dialogoMsg.textContent = "";
    if (accion.tipo === "flag") {
      dialogoTitulo.textContent = "Reportar punto falso";
      dialogoTexto.textContent =
        "Tres reportes de la comunidad ocultan el punto. Explica por qué crees que no es real:";
      dialogoDetalle.hidden = false;
      dialogoOk.textContent = "Enviar reporte";
    } else {
      dialogoTitulo.textContent = "Cerrar este punto";
      dialogoTexto.textContent =
        "El punto dejará de mostrarse. ¿El lugar ya no necesita ayuda o dejó de recolectar?";
      dialogoDetalle.hidden = true;
      dialogoOk.textContent = "Cerrar punto";
    }
    dialogo.hidden = false;
    requestAnimationFrame(() => (accion.tipo === "flag" ? dialogoDetalle.focus() : dialogoOk?.focus()));
  }

  function cerrarDialogo() {
    if (!dialogo) return;
    accionDialogo = null;
    dialogo.hidden = true;
    ultimoFoco?.focus();
    ultimoFoco = null;
  }

  dialogoCancelar?.addEventListener("click", cerrarDialogo);
  dialogo?.addEventListener("click", (e) => {
    if (e.target === dialogo) cerrarDialogo();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && dialogo && !dialogo.hidden) cerrarDialogo();
  });

  dialogoOk?.addEventListener("click", async () => {
    const accion = accionDialogo;
    if (!accion || !dialogoMsg) return;
    dialogoOk.disabled = true;
    try {
      if (accion.tipo === "flag") {
        const detalle = dialogoDetalle?.value.trim() ?? "";
        if (detalle.length < 3) {
          dialogoDetalle?.setAttribute("aria-invalid", "true");
          dialogoMsg.textContent = "El detalle es obligatorio (mínimo 3 caracteres).";
          return;
        }
        const res = await fetch(apiUrl(`/api/ayuda/${encodeURIComponent(accion.id)}/flag`), {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ detalle }),
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
        if (res.ok && data?.ok) {
          cerrarDialogo();
          await refrescarAyuda();
        } else {
          dialogoMsg.textContent = data?.error ?? "No se pudo enviar el reporte.";
        }
      } else {
        const token = leerTokens()[accion.id];
        const res = await fetch(apiUrl(`/api/ayuda/${encodeURIComponent(accion.id)}`), {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ estado: "cerrado", token }),
        });
        const data = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
        if (res.ok && data?.ok) {
          cerrarDialogo();
          await refrescarAyuda();
        } else {
          dialogoMsg.textContent = data?.error ?? "No se pudo cerrar el punto.";
        }
      }
    } finally {
      dialogoOk.disabled = false;
    }
  });

  // ---------- Refresco runtime de datos (desacoplar-datos-deploy) ----------
  // Catálogos, zonas y evento se leen del API (/api/datos/:catalogo); los
  // puntos de ayuda de GET /api/ayuda (D1). Si el API falla o tarda, la
  // página conserva lo renderizado en build (SSG).

  interface EventoBoletin {
    id?: string;
    titulo?: string;
    magnitud?: number;
    profundidad_km?: number;
    epicentro?: string;
    ciudades_sentido?: string[];
    replicas?: number | string;
    fuente?: string;
    fuente_url?: string;
    fecha?: string;
  }

  interface DatosFrescos {
    acopios?: Acopio[];
    albergues?: Albergue[];
    centros?: CentroSalud[];
    jornadas?: JornadaSangre[];
    zonas?: Zona[];
    evento?: EventoBoletin;
    ayuda?: PuntoAyuda[];
  }

  // Estado actual: arranca en los datos del build y se actualiza con cada
  // refresco que trae datos frescos (catálogos y zonas del API).
  let catalogoActual: {
    acopios: Acopio[];
    albergues: Albergue[];
    centros: CentroSalud[];
    jornadas: JornadaSangre[];
  } = { acopios, albergues, centros: centrosSalud, jornadas: jornadasSangre };
  let zonasActuales: Zona[] = zonas;
  // Puntos de ayuda: arrancan con el SSG del build (panel ya renderizado) y
  // se actualizan con cada refresco del API o con la copia estática si cae.
  // Declarado arriba: lo usan los listeners de zona→ayuda (TDZ-safe).
  let ultimoAyuda: PuntoAyuda[] | null = null;
  const ayudaSSG = document.getElementById("ayuda-panel")?.getAttribute("data-ayuda");
  if (ayudaSSG) {
    try {
      const p = JSON.parse(ayudaSSG) as unknown;
      if (Array.isArray(p)) ultimoAyuda = p as PuntoAyuda[];
    } catch {
      // SSG sin snapshot (primer clon): el refresco lo llenará.
    }
  }
  // Zona activa que filtra el panel Ayuda (null = todas).
  let zonaAyuda: string | null = null;
  // Huella del último render de la sección de ciudades reportadas (evita
  // re-renders duplicados en el mismo ciclo de refresco).
  let ultimaHuellaCiudades = "";

  const slotZonas = document.getElementById("zonas-slot");
  const ciudadesSSG: CiudadReportada[] = slotZonas
    ? (JSON.parse(slotZonas.dataset.ciudadesReportadas ?? "[]") as CiudadReportada[])
    : [];
  let fechaZonas = slotZonas?.dataset.fechaEvento ?? "";

  /** Ciudades con puntos de ayuda vigentes (dedupe contra catálogo + zonas SGC). */
  function ciudadesReportadasActuales(): CiudadReportada[] {
    if (!ultimoAyuda) return ciudadesSSG;
    const catalogadas = new Set(
      [
        ...catalogoActual.acopios.map((e) => e.ciudad),
        ...catalogoActual.albergues.map((e) => e.ciudad),
        ...catalogoActual.centros.map((e) => e.ciudad),
        ...catalogoActual.jornadas.map((e) => e.ciudad),
        ...zonasActuales.filter((z) => z.tipo === "ciudad").map((z) => z.nombre),
      ].map(nombreCiudadNormalizado)
    );
    return agruparCiudades(ultimoAyuda).filter(
      (c) => !catalogadas.has(nombreCiudadNormalizado(c.nombre))
    );
  }

  /** Re-renderiza el panel Zonas (filas SGC + ciudades reportadas) con datos frescos. */
  let ultimoRenderZonas = "";
  function reRenderZonas() {
    const slot = document.getElementById("zonas-slot");
    if (!slot) return;
    const ciudades = ciudadesReportadasActuales();
    // Solo re-renderizar cuando algo cambió: el re-render resetea scroll y
    // resaltado del panel (y reemplazaría el DOM en cada poll de 60 s).
    const huella = JSON.stringify([zonasActuales, ciudades, fechaZonas]);
    if (huella === ultimoRenderZonas) return;
    ultimoRenderZonas = huella;
    slot.innerHTML = renderZonasListaHTML(zonasActuales, ciudades, fechaZonas);
    window.dispatchEvent(new CustomEvent("enlace:zonas:re-render"));
  }

  /** Fila del panel Ayuda (mismo markup SSG; clic en la fila = ver en el mapa). */
  function badgeVerificacionHTML(p: PuntoAyuda): string {
    const estado = estadoVerificacion(p);
    const clase =
      estado === "oficial"
        ? "badge-oficial"
        : estado === "confirmado"
          ? "badge-confirmado"
          : "badge-sin-confirmar";
    const texto = estado === "oficial" ? "Oficial" : estado === "confirmado" ? "Confirmado" : "Sin confirmar";
    return `<span class="badge ${clase}">${texto}</span>`;
  }

  function chipsItemsHTML(items: ItemAyuda[]): string {
    if (items.length === 0) return "";
    return `<span class="popup-ayuda-ns">${items.map((i) => `<span>${escapar(etiquetaItemAyuda(i))}</span>`).join("")}</span>`;
  }

  function filaAyudaHTML(p: PuntoAyuda): string {
    const nombre = p.nombre ?? etiquetaTipo(p.tipo);
    const direccion = p.direccion ? ` — ${p.direccion}` : "";
    const meta = `${p.ciudad ? `${escapar(p.ciudad)} · ` : ""}${escapar(etiquetaModalidadCorta(p.modalidad))}${p.coordenadas_nivel ? ` · ${escapar(etiquetaPrecision(p.coordenadas_nivel))}` : ""}`;
    let destino = "";
    if (p.destino) {
      destino = p.destino.transporta && p.destino.ciudades.length > 0
        ? `<p class="ayuda-destino">Lleva a: ${escapar(p.destino.ciudades.join(", "))}</p>`
        : `<p class="ayuda-destino">Entrega solo en este punto</p>`;
    }
    const cobertura = lineaCobertura(p, ultimoAyuda ?? [], catalogoActual.acopios);
    const coberturaHtml = cobertura ? `<p class="ayuda-cobertura">${escapar(cobertura)}</p>` : "";
    const horario = p.horario ? `<p class="ayuda-destino">Horario: ${escapar(p.horario)}</p>` : "";
    const flags = p.flags > 0 ? `<p class="ayuda-destino">${p.flags} reporte(s) de falso</p>` : "";
    const actualizado = actualizadoHace(p);
    const actualizadoHtml = actualizado ? `<p class="ayuda-destino">Actualizado ${escapar(actualizado)}</p>` : "";
    const conToken = Boolean(leerTokens()[p.id]);
    const acciones = [
      `<a class="btn" href="https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}" target="_blank" rel="noopener">Cómo llegar</a>`,
      `<button type="button" class="btn" data-flag="${escapar(p.id)}">Reportar punto falso</button>`,
    ];
    if (conToken) {
      acciones.push(
        `<a class="btn" href="/reportar?editar=${encodeURIComponent(p.id)}">Actualizar</a>`,
        `<button type="button" class="btn" data-cerrar="${escapar(p.id)}">Cerrar punto</button>`
      );
    }
    return (
      `<article class="ayuda-fila" data-id="${escapar(p.id)}" data-volar-ayuda="${escapar(p.id)}" title="Ver en el mapa">` +
      `<div class="dash-row-top"><span class="dash-row-nombre">${escapar(nombre)}${escapar(direccion)}</span>` +
      `<span class="dash-row-meta">${meta}</span></div>` +
      `<span class="ayuda-badges">${badgeVerificacionHTML(p)}<span class="ayuda-estado">${escapar(ESTADOS_AYUDA[p.estado] ?? p.estado)}</span></span>` +
      `${p.descripcion ? `<p class="ayuda-descripcion">${escapar(p.descripcion)}</p>` : ""}` +
      `${chipsItemsHTML(p.items)}` +
      `${destino}${coberturaHtml}${horario}${flags}${actualizadoHtml}` +
      `<div class="ayuda-acciones">${acciones.join("")}</div>` +
      `</article>`
    );
  }

  /** Contenido del panel Ayuda: filtro de zona activa + lista o vacío. */
  function htmlPanelAyuda(vivos: PuntoAyuda[]): string {
    const enZona = (p: PuntoAyuda) =>
      !zonaAyuda || nombreCiudadNormalizado(p.ciudad ?? "") === nombreCiudadNormalizado(zonaAyuda);
    const visibles = vivos
      .filter((p) => puntoAyudaVisible(p) && enZona(p))
      .sort((a, b) => b.ultima_actualizacion.localeCompare(a.ultima_actualizacion));
    const filtro = zonaAyuda
      ? `<div class="ayuda-filtro"><span>Ayuda en <strong>${escapar(zonaAyuda)}</strong></span>` +
        `<button type="button" class="btn" data-ayuda-todos>Ver todos</button></div>`
      : "";
    if (visibles.length === 0) {
      const historico = vivos.filter((p) => !puntoAyudaVisible(p)).length;
      return (
        filtro +
        `<p class="ayuda-vacio">` +
        `${zonaAyuda ? `Sin puntos de ayuda en ${escapar(zonaAyuda)} ahora. ` : "Sin puntos de ayuda ahora. "}` +
        `${historico > 0 ? ` Hay ${historico} en el histórico.` : ""} ` +
        `<a href="/reportar">Reportar una necesidad u oferta</a></p>`
      );
    }
    // Ítems agregados de los puntos que necesitan (modalidad necesita/ambos):
    // suma de cantidades vía lib compartida (coherente con las tarjetas).
    const cuentanItems = (p: PuntoAyuda) => p.modalidad === "necesita" || p.modalidad === "ambos";
    const agregado = agregarItemsNecesarios(visibles);
    const nNecesitan = visibles.filter(cuentanItems).length;
    const agregadoHtml =
      agregado.length > 0
        ? `<span class="ayuda-agregado" id="ayuda-agregado">${nNecesitan} punto${nNecesitan === 1 ? "" : "s"} necesitan: ${agregado
            .slice(0, 4)
            .map((a) => `${escapar(etiquetaItemAyuda({ tipo: "catalogo", id: a.id }))} ×${escapar(etiquetaAgregado(a))}`)
            .join(", ")}</span>`
        : "";
    return (
      filtro +
      agregadoHtml +
      `<div id="ayuda-lista">${visibles.map(filaAyudaHTML).join("")}</div>`
    );
  }

  /** Aplica los puntos de ayuda al rail, chip, ciudades y select. */
  function aplicarAyuda(vivos: PuntoAyuda[], detalle: DatosFrescos = {}) {
    if (!Array.isArray(vivos)) return;
    ultimoAyuda = vivos;
    detalle.ayuda = vivos;
    const panel = document.getElementById("ayuda-panel");
    if (panel) panel.innerHTML = htmlPanelAyuda(vivos);
    // El re-render destruyó el resaltado: re-aplicarlo si hay un punto activo.
    if (ultimoPuntoActivo) resaltarPuntoAyuda(ultimoPuntoActivo);
    const conteoPanel = document.getElementById("ayuda-conteo");
    if (conteoPanel) {
      const n = vivos.filter(
        (p) =>
          puntoAyudaVisible(p) &&
          (!zonaAyuda || nombreCiudadNormalizado(p.ciudad ?? "") === nombreCiudadNormalizado(zonaAyuda))
      ).length;
      conteoPanel.textContent = String(n);
      conteoPanel.setAttribute("aria-label", `${n} puntos activos`);
    }
    const conteo = document.querySelector<HTMLSpanElement>(".leyenda-tira input[value='ayuda'] ~ .tira-label");
    if (conteo) conteo.textContent = `Ayuda (${vivos.filter((p) => puntoAyudaVisible(p)).length})`;

    // Ciudades reportadas: sección del panel Zonas + opciones del select.
    // Guard de huella: el mismo ciclo de refresco ya re-renderizó el panel
    // Zonas (reRenderZonas) — no repetir el render con contenido idéntico.
    const reportadas = ciudadesReportadasActuales();
    const huellaCiudades = JSON.stringify(reportadas);
    const seccion = document.getElementById("zonas-ciudadanas");
    if (seccion && huellaCiudades !== ultimaHuellaCiudades) {
      ultimaHuellaCiudades = huellaCiudades;
      seccion.hidden = reportadas.length === 0;
      if (reportadas.length > 0) {
        seccion.innerHTML =
          `<div class="zonas-ciudadanas-head">` +
          `<span class="zonas-ciudadanas-label">Ciudades con reportes ciudadanos</span>` +
          `<span class="zonas-count" aria-label="${reportadas.length} ciudades reportadas">${reportadas.length}</span></div>` +
          reportadas
            .map(
              (c) =>
                `<button type="button" class="dash-row zona-fila zona-fila-ciudadana" data-ciudad-nombre="${escapar(c.nombre)}" aria-pressed="false" title="Ciudad reportada por ciudadanos — sin intensidad hasta verificación oficial">` +
                `<span class="zona-fila-top"><span class="zona-dot zona-dot-ciudad" aria-hidden="true"></span>` +
                `<span class="zona-fila-nombre">${escapar(c.nombre)}</span>` +
                `<span class="zona-fila-meta">${c.puntos.length} punto${c.puntos.length === 1 ? "" : "s"} · sin confirmar</span>` +
                `<span class="dash-row-chevron" aria-hidden="true">›</span></span>` +
                `<span class="zona-fila-linea">Reportada por ciudadanos · sin intensidad (falta fuente oficial)</span>` +
                `</button>`
            )
            .join("");
      }
    }
    const catalogadas = new Set([
      ...catalogoActual.acopios.map((e) => e.ciudad),
      ...catalogoActual.albergues.map((e) => e.ciudad),
      ...catalogoActual.centros.map((e) => e.ciudad),
      ...catalogoActual.jornadas.map((e) => e.ciudad),
      ...zonasActuales.filter((z) => z.tipo === "ciudad").map((z) => z.nombre),
    ]);
    const select = document.querySelector<HTMLSelectElement>(".leyenda-tira select");
    if (select) {
      const actual = select.value;
      const opciones = Array.from(new Set([...catalogadas, ...reportadas.map((c) => c.nombre)])).sort((a, b) =>
        a.localeCompare(b, "es")
      );
      const actuales = Array.from(select.options).map((o) => o.value);
      if (opciones.length !== actuales.length - 1 || opciones.some((n) => !actuales.includes(n))) {
        select.innerHTML =
          `<option value="">Ciudad: Todas</option>` +
          opciones.map((n) => `<option value="${escapar(n)}">${escapar(n)}</option>`).join("");
        if (actual && opciones.includes(actual)) select.value = actual;
      }
    }
    // Las filas ciudadanas re-renderizadas ignoran el estado del chip "Zonas".
    const chipZonas = Array.from(
      document.querySelectorAll<HTMLInputElement>(".leyenda-tira input[type='checkbox']:checked")
    ).some((i) => i.value === "zona");
    document.querySelectorAll<HTMLButtonElement>(".zona-fila-ciudadana").forEach((f) => {
      f.hidden = !chipZonas;
    });
  }

  /** Refresco de los puntos de ayuda tras crear/editar/flag/cerrar. */
  async function refrescarAyuda() {
    if (!panelAyuda) return;
    const detalle: DatosFrescos = {};
    const vivos = await fetchPuntosAyuda();
    if (!Array.isArray(vivos)) return;
    aplicarAyuda(vivos, detalle);
    window.dispatchEvent(new CustomEvent("enlace:mapa:datos-frescos", { detail: detalle }));
  }

  const CONTEOS_LEYENDA: Record<string, string> = {
    acopio: "Acopios",
    albergue: "Albergues",
    salud: "Salud",
    sangre: "Donar sangre",
  };

  function actualizarConteoLeyenda(tipo: string, n: number) {
    const label = document.querySelector<HTMLSpanElement>(
      `.leyenda-tira input[value='${tipo}'] ~ .tira-label`
    );
    if (label && CONTEOS_LEYENDA[tipo]) label.textContent = `${CONTEOS_LEYENDA[tipo]} (${n})`;
  }

  function actualizarPuntosConteo() {
    const total =
      catalogoActual.acopios.length +
      catalogoActual.albergues.length +
      catalogoActual.centros.length +
      catalogoActual.jornadas.length;
    const el = document.getElementById("puntos-conteo");
    if (el) el.textContent = total === 1 ? "1 punto" : `${total} puntos`;
  }

  /** Barra de estado: lectura del boletín SGC con el evento fresco. */
  function actualizarBarraEvento(ev: EventoBoletin) {
    const l1 = document.getElementById("barra-linea1");
    if (l1 && ev.magnitud != null && ev.epicentro) {
      l1.textContent = `SISMO M${ev.magnitud} · EPICENTRO ${String(ev.epicentro).toUpperCase()}`;
    }
    const l2 = document.getElementById("barra-linea2");
    if (l2 && ev.profundidad_km != null && Array.isArray(ev.ciudades_sentido)) {
      l2.textContent = `PROFUNDIDAD ${ev.profundidad_km} KM · SENTIDO EN ${ev.ciudades_sentido.length} CIUDADES`;
    }
    const l3 = document.getElementById("barra-linea3");
    if (l3 && ev.replicas != null) l3.textContent = `RÉPLICAS ${ev.replicas}`;
    const enlace = document.getElementById("barra-fuente-enlace") as HTMLAnchorElement | null;
    if (enlace && ev.fuente_url) {
      enlace.href = ev.fuente_url;
      enlace.textContent = ev.fuente ?? "";
    }
    const fec = document.getElementById("barra-fuente-fecha");
    if (fec && ev.fecha) {
      fec.textContent = ev.fecha.slice(0, 10);
      fechaZonas = ev.fecha.slice(0, 10);
    }
  }

  /** Ciclo completo: catálogos + zonas + evento + puntos de ayuda, una vez por poll. */
  async function refrescarDatos() {
    const [acopiosD, alberguesD, centrosD, jornadasD, zonasD, eventoD, ayudaD] = await Promise.all([
      fetchCatalogo<{ acopios: Acopio[] }>("acopios"),
      fetchCatalogo<{ albergues: Albergue[] }>("albergues"),
      fetchCatalogo<{ centros: CentroSalud[] }>("centros-salud"),
      fetchCatalogo<{ jornadas: JornadaSangre[] }>("donacion-sangre"),
      fetchCatalogo<Zona[]>("zonas-afectadas"),
      fetchCatalogo<EventoBoletin>("evento"),
      fetchPuntosAyuda(),
    ]);
    const detalle: DatosFrescos = {};
    if (acopiosD?.acopios) {
      catalogoActual.acopios = acopiosD.acopios;
      detalle.acopios = acopiosD.acopios;
      actualizarConteoLeyenda("acopio", acopiosD.acopios.length);
    }
    if (alberguesD?.albergues) {
      catalogoActual.albergues = alberguesD.albergues;
      detalle.albergues = alberguesD.albergues;
      actualizarConteoLeyenda("albergue", alberguesD.albergues.length);
    }
    if (centrosD?.centros) {
      catalogoActual.centros = centrosD.centros;
      detalle.centros = centrosD.centros;
      actualizarConteoLeyenda("salud", centrosD.centros.length);
    }
    if (jornadasD?.jornadas) {
      catalogoActual.jornadas = jornadasD.jornadas;
      detalle.jornadas = jornadasD.jornadas;
      actualizarConteoLeyenda("sangre", jornadasD.jornadas.length);
    }
    if (zonasD) {
      zonasActuales = zonasD;
      detalle.zonas = zonasD;
    }
    if (eventoD) {
      detalle.evento = eventoD;
      actualizarBarraEvento(eventoD);
    }
    if (ayudaD) {
      ultimoAyuda = ayudaD;
    } else {
      // API caída: la copia estática desplegada mantiene el filtro de
      // ayuda por zona (misma fuente que el SSG del panel).
      try {
        // cache: no-store — el snapshot puede cambiar entre deploys.
        const res = await fetch("/datos/reportes-ayuda.json", { cache: "no-store" });
        if (res.ok) {
          const estatico = (await res.json()) as PuntoAyuda[];
          if (Array.isArray(estatico)) ultimoAyuda = estatico;
        }
      } catch {
        // Sin red: el panel queda como SSG (sin filtro aplicado).
      }
    }
    if (Object.keys(detalle).length === 0) {
      // API caída: aplicar el snapshot estático para que el filtro por zona
      // funcione igual (ultimoAyuda se llenó en el else de arriba).
      if (ultimoAyuda && !ayudaD) aplicarAyuda(ultimoAyuda, {});
      return; // API caída: queda el SSG
    }
    // eventoD también re-renderiza el panel Zonas: la fecha de las filas
    // (fila-linea) debe seguir a la barra de estado (la huella evita
    // re-renders inútiles).
    if (zonasD || ayudaD || eventoD) reRenderZonas();
    if (ayudaD) aplicarAyuda(ayudaD, detalle);
    actualizarPuntosConteo();
    window.dispatchEvent(new CustomEvent("enlace:mapa:datos-frescos", { detail: detalle }));
  }

  // Primer refresco + poll cada 60 s mientras la pestaña está visible.
  void refrescarDatos();
  window.setInterval(() => {
    if (!document.hidden) void refrescarDatos();
  }, 60_000);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) void refrescarDatos();
  });

  // Estado inicial con JS: solo Zonas visible; re-render del panel Ayuda con
  // el token del navegador (botones Actualizar/Cerrar solo para puntos propios).
  if (ultimoAyuda) aplicarAyuda(ultimoAyuda);
  if (tabZonas) activar(tabZonas);
</script>
</BaseLayout>
