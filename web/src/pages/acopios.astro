---
import { readFileSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderCatalogoPagina } from "../lib/render-catalogos";
import { puntoAyudaVisible, type PuntoAyuda } from "../lib/puntos-ayuda";

// Los puntos de acopio viven en el registro unificado (D1): el snapshot SSG
// (generado por el deploy) es el baseline; el refresco runtime los actualiza
// desde GET /api/ayuda. Sin snapshot (primer clon), la página queda en el
// estado vacío y el refresco la llena.
let vivos: PuntoAyuda[] = [];
try {
  const raw = readFileSync(new URL("../../public/datos/reportes-ayuda.json", import.meta.url), "utf8");
  const parsed = JSON.parse(raw);
  if (Array.isArray(parsed)) vivos = parsed as PuntoAyuda[];
} catch {
  // Sin snapshot todavía (primer clon o antes del primer deploy).
}
const visibles = vivos
  .filter((p) => p.tipo === "acopio" && puntoAyudaVisible(p))
  .sort((a, b) => b.ultima_actualizacion.localeCompare(a.ultima_actualizacion));
const contenido = renderCatalogoPagina("acopio", visibles);
---

<BaseLayout
  title="Puntos de acopio — Enlace Sismo"
  description="Dónde entregar alimentos, ropa, agua y medicamentos para los damnificados del sismo en Colombia. Puntos de acopio verificados por ciudad."
>
  <section class="seccion-titulo">
    <h1>Puntos de acopio</h1>
    <p>
      Lugares donde se reciben donaciones. Cada punto está verificado contra una fuente.
      En una emergencia, confirma por teléfono antes de desplazarte: el estado puede cambiar.
    </p>
  </section>

  <!-- El contenido (filtros + tarjetas) lo renderiza la misma función que el
       refresco runtime: el SSG y el runtime nunca divergen. -->
  <div id="contenido-acopios" set:html={contenido}></div>
</BaseLayout>

<script>
  import { haversineKm } from "../lib/geo";
  import { fetchPuntosAyuda } from "../lib/datos";
  import { renderCatalogoPagina } from "../lib/render-catalogos";
  import { puntoAyudaVisible, type PuntoAyuda } from "../lib/puntos-ayuda";

  let ultimaPos: { latitude: number; longitude: number } | null = null;

  function bindFiltros() {
    const checkOficiales = document.getElementById("filtro-oficiales") as HTMLInputElement | null;
    const selectCiudad = document.getElementById("filtro-ciudad") as HTMLSelectElement | null;

    function filtrar() {
      const ciudad = selectCiudad?.value ?? "";
      const soloOficiales = checkOficiales?.checked ?? false;
      document.querySelectorAll<HTMLElement>(".ciudad-grupo").forEach((grupo) => {
        const coincideCiudad = !ciudad || grupo.dataset.ciudad === ciudad;
        let visibles = 0;
        grupo.querySelectorAll<HTMLElement>(".card-item").forEach((card) => {
          const esOficial = card.dataset.verificacion === "oficial";
          const coincideOficial = !soloOficiales || esOficial;
          card.style.display = coincideOficial ? "" : "none";
          if (coincideOficial) visibles++;
        });
        grupo.style.display = coincideCiudad && visibles > 0 ? "" : "none";
      });
    }

    selectCiudad?.addEventListener("change", filtrar);
    checkOficiales?.addEventListener("change", filtrar);
    return filtrar;
  }

  let filtrar = bindFiltros();

  function reordenarPorProximidad(latitude: number, longitude: number) {
    const secciones = Array.from(document.querySelectorAll<HTMLElement>(".ciudad-grupo"));
    if (secciones.length < 2) return;

    const distancias = secciones.map((s) => {
      const lat = Number(s.dataset.lat);
      const lng = Number(s.dataset.lng);
      return { seccion: s, km: haversineKm(latitude, longitude, lat, lng) };
    });

    distancias.sort((a, b) => a.km - b.km);
    const padre = secciones[0].parentNode;
    const primera = distancias[0].seccion;

    for (const d of distancias) {
      padre?.appendChild(d.seccion);
    }

    const ciudad = primera.dataset.ciudad;
    const indicador = document.createElement("p");
    indicador.className = "geo-indicador";
    indicador.textContent = `Mostrando ${ciudad} primero (más cercana a ti)`;
    primera.insertBefore(indicador, primera.querySelector(".grid"));
  }

  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        ultimaPos = { latitude: pos.coords.latitude, longitude: pos.coords.longitude };
        reordenarPorProximidad(ultimaPos.latitude, ultimaPos.longitude);
      },
      () => {},
      { enableHighAccuracy: false, timeout: 10000 }
    );
  }

  // Refresco runtime: los puntos de acopio son una vista del registro unificado
  // (GET /api/ayuda?tipo=acopio). Si el API falla, la página queda como SSG.
  async function refrescar() {
    const data = await fetchPuntosAyuda();
    if (!Array.isArray(data)) return;
    const cont = document.getElementById("contenido-acopios");
    if (!cont) return;
    const previo = (document.getElementById("filtro-ciudad") as HTMLSelectElement | null)?.value ?? "";
    const previoOficiales = (document.getElementById("filtro-oficiales") as HTMLInputElement | null)?.checked ?? false;
    const visibles = (data as PuntoAyuda[])
      .filter((p) => p.tipo === "acopio" && puntoAyudaVisible(p))
      .sort((a, b) => b.ultima_actualizacion.localeCompare(a.ultima_actualizacion));
    cont.innerHTML = renderCatalogoPagina("acopio", visibles);
    filtrar = bindFiltros();
    const select = document.getElementById("filtro-ciudad") as HTMLSelectElement | null;
    if (previo && select && Array.from(select.options).some((o) => o.value === previo)) {
      select.value = previo;
    }
    const check = document.getElementById("filtro-oficiales") as HTMLInputElement | null;
    if (check) check.checked = previoOficiales;
    filtrar();
    if (ultimaPos) reordenarPorProximidad(ultimaPos.latitude, ultimaPos.longitude);
  }
  void refrescar();
</script>
