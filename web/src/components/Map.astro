---
import type { Acopio, Albergue, CentroSalud, JornadaSangre } from "../lib/catalogs";
import type { Zona } from "../lib/zonas";
import evento from "../../../data/evento.json";
import { haversineKm, formatearDistancia } from "../lib/geo";

interface Props {
  acopios: Acopio[];
  albergues: Albergue[];
  centros: CentroSalud[];
  jornadas?: JornadaSangre[];
  zonas?: Zona[];
}

const { acopios, albergues, centros, jornadas = [], zonas = [] } = Astro.props;

type Punto = {
  id: string;
  nombre: string;
  lat: number;
  lng: number;
  tipo: "acopio" | "albergue" | "salud" | "sangre";
  estado: string;
  ciudad: string;
  direccion: string;
  fuente: string;
  detalle?: string;
};

const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const fmtDia = (iso: string) => {
  const [, m, d] = iso.split("-").map(Number);
  return `${d} ${MESES[m - 1]}`;
};

const puntos: Punto[] = [
  ...acopios.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "acopio" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...albergues.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "albergue" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...centros.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "salud" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...jornadas.map((e) => ({
    id: e.id,
    nombre: e.punto,
    lat: e.lat,
    lng: e.lng,
    tipo: "sangre" as const,
    estado: e.estado,
    ciudad: e.ciudad,
    direccion: e.direccion,
    fuente: e.fuente,
    detalle: `${e.fecha_fin ? `${fmtDia(e.fecha_inicio)} → ${fmtDia(e.fecha_fin)}` : `Desde ${fmtDia(e.fecha_inicio)}`} · ${e.horario}`,
  })),
];

// Distancia al epicentro calculada en build (haversine) y pasada al cliente.
const epicentro = zonas.find((z) => z.tipo === "epicentro");
const zonasConDistancia = zonas.map((z) => ({
  ...z,
  distEpicentroKm: epicentro && z.id !== epicentro.id
    ? haversineKm(z.lat, z.lng, epicentro.lat, epicentro.lng)
    : 0,
}));

const puntosJson = JSON.stringify(puntos);
const zonasJson = JSON.stringify(zonasConDistancia);
const eventoJson = JSON.stringify({ fecha: evento.fecha.slice(0, 10) });
---

<div class="mapa-full" id="mapa-libre" data-puntos={puntosJson} data-zonas={zonasJson} data-evento={eventoJson}></div>

<script>
  import maplibre from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { oklchAHex } from "../lib/color";

  type Punto = {
    id: string;
    nombre: string;
    lat: number;
    lng: number;
    tipo: "acopio" | "albergue" | "salud" | "sangre";
    estado: string;
    ciudad: string;
    direccion: string;
    fuente: string;
    detalle?: string;
  };

  type Zona = {
    id: string;
    nombre: string;
    tipo: "epicentro" | "ciudad";
    lat: number;
    lng: number;
    intensidad?: number;
    detalle?: string;
    fuente: string;
    distEpicentroKm: number;
  };

  const el = document.getElementById("mapa-libre") as HTMLDivElement;
  const contenedor = el.closest(".dash");

  // Progresivo: el contenido base ya es legible. El mapa solo se muestra
  // cuando carga sin errores. Sin WebGL, con error o tras 8 s → fallback.
  let cargado = false;
  let fallido = false;

  function activarMapa() {
    if (!fallido && contenedor) contenedor.classList.add("con-mapa");
  }

  const tieneWebGL = (() => {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  })();

  if (!tieneWebGL) {
    fallido = true;
  } else {
    // Colores desde los tokens del diseño (tokens.css) — nunca valores sueltos.
    // MapLibre no acepta oklch(): se convierte a hex en runtime.
    const cssVar = (name: string, fallback: string) => {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      if (!v) return fallback;
      return oklchAHex(v) ?? v;
    };

    const COLORS: Record<string, string> = {
      acopio: cssVar("--color-accent", "#1d4ed8"),
      albergue: cssVar("--color-ok", "#2f7d4f"),
      salud: cssVar("--color-error", "#9e2a1d"),
      sangre: cssVar("--color-sangre", "#e40095"),
      neutral: cssVar("--color-neutral", "#6b7280"),
      geo: cssVar("--color-geo", "#2563eb"),
    };
    const PAPER = cssVar("--color-paper", "#f8f9fb");
    const INK = cssVar("--color-ink", "#1b2733");

    const ESTADOS: Record<string, string> = {
      abierto: "Abierto",
      activa: "Activa",
      finalizada: "Finalizada",
      operativo: "Operativo",
      limitado: "Limitado",
      cerrado: "Cerrado",
      "sin-confirmar": "Sin confirmar",
    };

    const ROMANOS = ["", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];

    // Escapa texto de datos antes de inyectarlo en el popup (nunca markup).
    const escapar = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    const puntos: Punto[] = JSON.parse(el.dataset.puntos ?? "[]");
    const zonas: Zona[] = JSON.parse(el.dataset.zonas ?? "[]");
    const { fecha } = JSON.parse(el.dataset.evento ?? "{}") as { fecha?: string };
    const epicentro = zonas.find((z) => z.tipo === "epicentro") ?? null;

    // Rama Mercalli desde tokens; sin intensidad → neutral.
    const colorIntensidad = (i: number | undefined) =>
      i ? cssVar(`--mercalli-${i}`, COLORS.neutral) : COLORS.neutral;
    const radioIntensidad = (i: number | undefined) => (i ? Math.round(5 + i * 0.9) : 7);

    // Cadena de respaldo: OpenFreeMap → OSM raster → lista de datos.
    const ESTILO_OSM = {
      version: 8 as const,
      sources: {
        osm: {
          type: "raster" as const,
          tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
          tileSize: 256,
          attribution: "© OpenStreetMap contributors",
        },
      },
      layers: [{ id: "osm", type: "raster" as const, source: "osm" }],
    };
    let estiloAlternativo = false;

    const map = new maplibre.Map({
      container: el,
      // Estilo completo de OpenFreeMap: tiles, glifos y sprites incluidos.
      style: "https://tiles.openfreemap.org/styles/liberty",
      center: [-75.6, 4.4],
      zoom: 6,
    });

    map.addControl(new maplibre.NavigationControl({ showCompass: false }), "top-right");

    function featureCollection(lista: Punto[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((p) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [p.lng, p.lat] },
          properties: { ...p, color: COLORS[p.tipo] },
        })),
      };
    }

    function featureCollectionZonas(lista: Zona[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((z) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [z.lng, z.lat] },
          properties: {
            ...z,
            color: colorIntensidad(z.intensidad),
            radio: radioIntensidad(z.intensidad),
          },
        })),
      };
    }

    function featureOnda(r: number, o: number) {
      if (!epicentro) return null;
      return {
        type: "FeatureCollection" as const,
        features: [
          {
            type: "Feature" as const,
            geometry: { type: "Point" as const, coordinates: [epicentro.lng, epicentro.lat] },
            properties: { r, o },
          },
        ],
      };
    }

    function featureUsuario(lat: number, lng: number) {
      return {
        type: "FeatureCollection" as const,
        features: [
          {
            type: "Feature" as const,
            geometry: { type: "Point" as const, coordinates: [lng, lat] },
            properties: {},
          },
        ],
      };
    }

    let popupActivo: maplibre.Popup | null = null;

    function abrirPopupZona(z: Zona) {
      const intensidad = z.intensidad
        ? `Intensidad ${ROMANOS[z.intensidad]} — Mercalli`
        : "Sin reporte de intensidad";
      const distancia = z.distEpicentroKm
        ? `A ${formatearDistancia(z.distEpicentroKm)} del epicentro`
        : "";
      popupActivo?.remove();
      popupActivo = new maplibre.Popup({ offset: 16 })
        .setLngLat([z.lng, z.lat])
        .setHTML(
          `<div class="popup popup-zona">` +
            `<strong class="popup-titulo">${escapar(z.nombre)}</strong>` +
            `<p class="popup-meta">${escapar(intensidad)}${distancia ? ` · ${escapar(distancia)}` : ""}</p>` +
            `<p class="popup-linea">${escapar(z.detalle ?? "Sismo sentido")} · ${escapar(fecha ?? "")}</p>` +
            `<p class="popup-coords">${z.lat.toFixed(2)}°N ${z.lng.toFixed(2)}°O</p>` +
            `<p class="popup-fuente">Fuente: <a href="${escapar(z.fuente)}" target="_blank" rel="noopener">SGC</a> · ` +
            `<a href="https://www.google.com/maps/dir/?api=1&destination=${z.lat},${z.lng}" target="_blank" rel="noopener">Cómo llegar</a></p>` +
            `</div>`
        )
        .addTo(map);
      window.dispatchEvent(new CustomEvent("enlace:mapa:zona-activa", { detail: { id: z.id } }));
    }

    function volarAZona(z: Zona) {
      map.flyTo({ center: [z.lng, z.lat], zoom: z.tipo === "epicentro" ? 8 : 9, essential: true });
      abrirPopupZona(z);
    }

    // Última ciudad elegida: volar a la ciudad solo cuando cambia el filtro
    let ciudadFiltro = "";

    function aplicarFiltros(volar = true) {
      const visibles = new Set(
        Array.from(document.querySelectorAll(".leyenda-tira input[type='checkbox']:checked")).map(
          (i) => (i as HTMLInputElement).value
        )
      );
      const ciudad = Array.from(document.querySelectorAll<HTMLSelectElement>(".leyenda-tira select"))
        .map((s) => s.value)
        .find((v) => v !== "") ?? "";
      if (ciudad !== ciudadFiltro) {
        ciudadFiltro = ciudad;
        if (ciudad && volar) {
          const z = zonas.find((x) => x.nombre.toLowerCase() === ciudad.toLowerCase());
          if (z) map.flyTo({ center: [z.lng, z.lat], zoom: 8, essential: true });
        }
      }
      const puntosFiltrados = puntos.filter(
        (p) => visibles.has(p.tipo) && (!ciudad || p.ciudad === ciudad)
      );
      const zonasFiltradas = zonas.filter((z) =>
        z.tipo === "epicentro" ? visibles.has("epicentro") : visibles.has("zona")
      );
      const srcP = map.getSource("puntos");
      if (srcP && "setData" in srcP) {
        (srcP as maplibre.GeoJSONSource).setData(featureCollection(puntosFiltrados));
      }
      const srcZ = map.getSource("zonas");
      if (srcZ && "setData" in srcZ) {
        (srcZ as maplibre.GeoJSONSource).setData(featureCollectionZonas(zonasFiltradas));
      }
      // El anillo del epicentro sigue la casilla "Epicentro"
      if (map.getLayer("epicentro-onda")) {
        map.setLayoutProperty("epicentro-onda", "visibility", visibles.has("epicentro") ? "visible" : "none");
      }
      if (visibles.has("epicentro")) arrancarOnda();
      else detenerOnda();
    }

    // ---- Anillo expansivo del epicentro (rAF, pausa fuera del viewport) ----
    let ondaFrame = 0;
    let ondaActiva = false;
    const ONDA_DUR = 2600;
    const motionReducida = matchMedia("(prefers-reduced-motion: reduce)").matches;

    function arrancarOnda() {
      const src = map.getSource("epicentro-onda");
      if (!src || ondaActiva || !cargado) return;
      ondaActiva = true;
      if (motionReducida) {
        // Movimiento reducido: halo estático, sin animación
        const f = featureOnda(30, 0.14);
        if (f) (src as maplibre.GeoJSONSource).setData(f);
        return;
      }
      const inicio = performance.now();
      const tick = (ahora: number) => {
        if (!ondaActiva) return;
        const p = ((ahora - inicio) % ONDA_DUR) / ONDA_DUR;
        const f = featureOnda(4 + p * 80, (1 - p) * 0.4);
        if (f) (src as maplibre.GeoJSONSource).setData(f);
        ondaFrame = requestAnimationFrame(tick);
      };
      ondaFrame = requestAnimationFrame(tick);
    }

    function detenerOnda() {
      ondaActiva = false;
      cancelAnimationFrame(ondaFrame);
    }

    // ---- Cerca de mí (geolocalización) ----
    const btnGeo = document.getElementById("btn-cerca-de-mi");
    const msgGeo = document.getElementById("geo-mensaje");
    const lineaDist = document.getElementById("dist-epicentro");
    let ultimaPos: GeolocationPosition | null = null;

    function mensajeGeo(texto: string) {
      if (!msgGeo) return;
      msgGeo.textContent = texto;
      msgGeo.hidden = false;
    }

    function actualizarPrecision(accuracy: number) {
      if (!ultimaPos) return;
      if (!map.getLayer("usuario-preciso")) return;
      const lat = ultimaPos.coords.latitude;
      const mpp = (156543.03392 * Math.cos((lat * Math.PI) / 180)) / Math.pow(2, map.getZoom());
      map.setPaintProperty("usuario-preciso", "circle-radius", Math.max(accuracy / mpp, 6));
    }

    function dibujarUsuario(pos: GeolocationPosition) {
      const { latitude, longitude, accuracy } = pos.coords;
      const src = map.getSource("usuario");
      if (src && "setData" in src) {
        (src as maplibre.GeoJSONSource).setData(featureUsuario(latitude, longitude));
      }
      actualizarPrecision(accuracy);
      // Lleva la vista a la ubicación del usuario para que el resultado sea visible
      map.flyTo({ center: [longitude, latitude], zoom: 8, essential: true });
      if (epicentro) {
        const km = haversineKm(latitude, longitude, epicentro.lat, epicentro.lng);
        if (lineaDist) {
          lineaDist.hidden = false;
          lineaDist.textContent = `Estás a ${formatearDistancia(km)} del epicentro`;
        }
      }
      window.dispatchEvent(
        new CustomEvent("enlace:mapa:posicion", {
          detail: {
            distancias: zonas.map((z) => ({
              id: z.id,
              km: haversineKm(latitude, longitude, z.lat, z.lng),
            })),
          },
        })
      );
    }

    function geolocalizar() {
      if (!("geolocation" in navigator)) {
        mensajeGeo("Tu navegador no soporta geolocalización.");
        if (btnGeo) btnGeo.hidden = true;
        return;
      }
      if (btnGeo) btnGeo.setAttribute("aria-busy", "true");
      // Red de seguridad: si el navegador nunca responde (permiso bloqueado,
      // GPS lento), el botón se libera y el usuario recibe un mensaje.
      let pendiente = true;
      const liberar = () => {
        if (!pendiente) return;
        pendiente = false;
        if (btnGeo) btnGeo.removeAttribute("aria-busy");
      };
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          liberar();
          if (msgGeo) msgGeo.hidden = true;
          if (btnGeo) btnGeo.textContent = "Actualizar ubicación";
          ultimaPos = pos;
          try {
            dibujarUsuario(pos);
          } catch (err) {
            console.error("enlace-sismo: error al dibujar la ubicación", err);
          }
        },
        (err) => {
          liberar();
          const msgs: Record<number, string> = {
            [GeolocationPositionError.PERMISSION_DENIED]:
              "Permiso denegado: sin tu ubicación no podemos medir distancias.",
            [GeolocationPositionError.POSITION_UNAVAILABLE]:
              "No pudimos obtener tu ubicación. Intenta de nuevo.",
            [GeolocationPositionError.TIMEOUT]:
              "Tardamos demasiado en obtener tu ubicación. Intenta de nuevo.",
          };
          mensajeGeo(msgs[err.code] ?? "Error al obtener tu ubicación.");
        },
        // Precisión baja: fija rápida por red/Wi-Fi, suficiente para distancias
        // a nivel de ciudad. La alta precisión (GPS) puede no responder en equipos sin GPS.
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
      );
      setTimeout(() => {
        if (pendiente) {
          liberar();
          mensajeGeo("No pudimos obtener tu ubicación. Revisa los permisos de ubicación del navegador.");
        }
      }, 12000);
    }

    btnGeo?.addEventListener("click", geolocalizar);
    map.on("zoomend", () => {
      if (ultimaPos) actualizarPrecision(ultimaPos.coords.accuracy);
    });

    // Pausa del anillo cuando el mapa no es visible (batería)
    const obsOnda = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!cargado) return;
        if (en.isIntersecting) arrancarOnda();
        else detenerOnda();
      });
    });
    obsOnda.observe(el);

    map.on("load", () => {
      cargado = true;
      activarMapa();
      // El contenedor pasa de display:none a visible: MapLibre debe
      // re-medir el canvas o quedaría en blanco (bug clásico).
      requestAnimationFrame(() => requestAnimationFrame(() => map.resize()));

      if (map.getSource("puntos")) return;

      // Anillo expansivo bajo los círculos de zonas
      if (epicentro) {
        map.addSource("epicentro-onda", {
          type: "geojson",
          data: featureOnda(4, 0) ?? { type: "FeatureCollection", features: [] },
        });
        map.addLayer({
          id: "epicentro-onda",
          type: "circle",
          source: "epicentro-onda",
          paint: {
            "circle-radius": ["get", "r"],
            "circle-color": COLORS.salud,
            "circle-opacity": ["get", "o"],
            "circle-stroke-width": 0,
          },
        });
      }

      map.addSource("puntos", { type: "geojson", data: featureCollection(puntos) });
      map.addSource("zonas", { type: "geojson", data: featureCollectionZonas(zonas) });

      // Zonas (epicentro + ciudades) bajo los puntos de datos
      map.addLayer({
        id: "zonas-circulo",
        type: "circle",
        source: "zonas",
        paint: {
          "circle-radius": ["get", "radio"],
          "circle-color": ["get", "color"],
          "circle-stroke-width": ["match", ["get", "tipo"], "epicentro", 3, "ciudad", 2, 2],
          "circle-stroke-color": PAPER,
        },
      });

      map.addLayer({
        id: "zonas-texto",
        type: "symbol",
        source: "zonas",
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": ["match", ["get", "tipo"], "epicentro", 12, "ciudad", 11, 11],
          "text-offset": [0, 1.6],
          "text-anchor": "top",
          "text-max-width": 9,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      map.addLayer({
        id: "puntos-circulo",
        type: "circle",
        source: "puntos",
        paint: {
          "circle-radius": 10,
          "circle-color": ["get", "color"],
          "circle-stroke-width": 2.5,
          "circle-stroke-color": PAPER,
        },
      });

      // Centro blanco: distingue los puntos de datos de los círculos de zona
      map.addLayer({
        id: "puntos-interior",
        type: "circle",
        source: "puntos",
        paint: {
          "circle-radius": 4,
          "circle-color": PAPER,
        },
      });

      map.addLayer({
        id: "puntos-texto",
        type: "symbol",
        source: "puntos",
        minzoom: 7,
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": 10,
          "text-offset": [0, 1.4],
          "text-anchor": "top",
          "text-max-width": 9,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      // Ubicación del usuario (rellenada por "Cerca de mí")
      map.addSource("usuario", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
      map.addLayer({
        id: "usuario-preciso",
        type: "circle",
        source: "usuario",
        paint: {
          "circle-radius": 8,
          "circle-color": COLORS.geo,
          "circle-opacity": 0.15,
        },
      });
      map.addLayer({
        id: "usuario-marcador",
        type: "circle",
        source: "usuario",
        paint: {
          "circle-radius": 7,
          "circle-color": COLORS.geo,
          "circle-stroke-width": 2.5,
          "circle-stroke-color": PAPER,
        },
      });

      map.on("click", "puntos-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const p = f.properties as unknown as Punto;
        const coords = (f.geometry as { type: "Point"; coordinates: [number, number] }).coordinates;
        popupActivo?.remove();
        popupActivo = new maplibre.Popup({ offset: 16 })
          .setLngLat(coords)
          .setHTML(
            `<div class="popup popup-punto">` +
              `<strong class="popup-titulo">${escapar(p.nombre)}</strong>` +
              `<p class="popup-meta"><span class="popup-badge popup-badge-${p.tipo}">${escapar(ESTADOS[p.estado] ?? p.estado)}</span> ${escapar(p.ciudad)}</p>` +
              `<p class="popup-linea">${escapar(p.direccion)}</p>` +
              `${p.detalle ? `<p class="popup-linea">${escapar(p.detalle)}</p>` : ""}` +
              `<p class="popup-fuente">Fuente: <a href="${escapar(p.fuente)}" target="_blank" rel="noopener">ver fuente</a> · ` +
              `<a href="https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}" target="_blank" rel="noopener">Cómo llegar</a></p>` +
              `</div>`
          )
          .addTo(map);
      });

      map.on("mouseenter", "puntos-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "puntos-circulo", () => {
        map.getCanvas().style.cursor = "";
      });

      // Popup y cursor para zonas (sincroniza la lista)
      map.on("click", "zonas-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        abrirPopupZona(f.properties as unknown as Zona);
      });

      map.on("mouseenter", "zonas-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "zonas-circulo", () => {
        map.getCanvas().style.cursor = "";
      });

      arrancarOnda();

      // Deep-link: /?ciudad=<id>#mapa → vuelo + popup
      const ciudadParam = new URLSearchParams(location.search).get("ciudad");
      if (ciudadParam) {
        const z = zonas.find((x) => x.id === ciudadParam);
        if (z) volarAZona(z);
      }
    });

    // Fila de la lista → vuelo + popup; la zona activa filtra los puntos
    // de su ciudad (sin volver a volar: la fila ya lo hizo).
    window.addEventListener(
      "enlace:mapa:volar-zona",
      ((e: CustomEvent<{ id: string }>) => {
        const z = zonas.find((x) => x.id === e.detail.id);
        if (!z) return;
        volarAZona(z);
        const select = document.querySelector<HTMLSelectElement>(".leyenda-tira select");
        if (!select) return;
        if (z.tipo === "epicentro") {
          // El epicentro es el ancla del territorio: vuelve a mostrar todos los puntos
          select.value = "";
          aplicarFiltros(false);
          return;
        }
        if (Array.from(select.options).some((o) => o.value === z.nombre)) {
          select.value = z.nombre;
          aplicarFiltros(false);
        }
      }) as EventListener
    );

    // Marca "Enlace Sismo" en la portada: cerrar popup y volver a la vista inicial
    window.addEventListener("enlace:mapa:reiniciar", () => {
      popupActivo?.remove();
      popupActivo = null;
      map.flyTo({ center: [-75.6, 4.4], zoom: 6, essential: true });
    });

    map.on("styleerror", () => {
      // El proveedor principal falló: reintenta con OSM raster. Si ese
      // también falla, el contenido base (lista) queda como respaldo.
      if (cargado) return;
      if (!estiloAlternativo) {
        estiloAlternativo = true;
        map.setStyle(ESTILO_OSM);
      } else {
        fallido = true;
      }
    });

    map.on("error", () => {
      // Errores de tiles o de render: si el estilo ya cargó, el mapa sigue
      // funcionando; el timeout de 8 s cubre el caso de carga lenta.
    });

    setTimeout(() => {
      if (!cargado) fallido = true;
    }, 8000);

    document.querySelectorAll<HTMLInputElement>(".leyenda-tira input[type='checkbox']").forEach((input) => {
      input.addEventListener("change", aplicarFiltros);
    });
    document.querySelectorAll<HTMLSelectElement>(".leyenda-tira select").forEach((select) => {
      select.addEventListener("change", () => {
        aplicarFiltros();
        // Conexión filtro ↔ zonas: resaltar la fila de la ciudad elegida
        const z = zonas.find((x) => x.nombre === select.value);
        window.dispatchEvent(new CustomEvent("enlace:mapa:zona-activa", { detail: { id: z?.id ?? "" } }));
      });
    });
  }
</script>
