---
import type { Acopio, Albergue, CentroSalud } from "../lib/catalogs";
import type { Zona } from "../lib/zonas";

interface Props {
  acopios: Acopio[];
  albergues: Albergue[];
  centros: CentroSalud[];
  zonas?: Zona[];
}

const { acopios, albergues, centros, zonas = [] } = Astro.props;

type Punto = {
  id: string;
  nombre: string;
  lat: number;
  lng: number;
  tipo: "acopio" | "albergue" | "salud";
  estado: string;
  ciudad: string;
  direccion: string;
  fuente: string;
};

const puntos: Punto[] = [
  ...acopios.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "acopio" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...albergues.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "albergue" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...centros.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "salud" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
];

const puntosJson = JSON.stringify(puntos);
const zonasJson = JSON.stringify(zonas);
---

<div class="mapa-full" id="mapa" data-puntos={puntosJson} data-zonas={zonasJson}></div>

<script>
  import maplibre from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";

  type Punto = {
    id: string;
    nombre: string;
    lat: number;
    lng: number;
    tipo: "acopio" | "albergue" | "salud";
    estado: string;
    ciudad: string;
    direccion: string;
    fuente: string;
  };

  type Zona = {
    id: string;
    nombre: string;
    tipo: "epicentro" | "ciudad";
    lat: number;
    lng: number;
    detalle?: string;
    fuente: string;
  };

  const el = document.getElementById("mapa") as HTMLDivElement;
  const contenedor = el.closest(".dash, .mapa-wrap");

  // Progresivo: el contenido base ya es legible. El mapa solo se muestra
  // cuando carga sin errores. Sin WebGL, con error o tras 8 s → fallback.
  let cargado = false;
  let fallido = false;

  function activarMapa() {
    if (!fallido && contenedor) contenedor.classList.add("con-mapa");
  }

  const tieneWebGL = (() => {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  })();

  if (!tieneWebGL) {
    fallido = true;
  } else {
    // Colores desde los tokens del diseño (tokens.css) — nunca valores sueltos
    const cssVar = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

    const COLORS: Record<string, string> = {
      acopio: cssVar("--color-accent", "#1d4ed8"),
      albergue: cssVar("--color-ok", "#2f7d4f"),
      salud: cssVar("--color-error", "#9e2a1d"),
      neutral: cssVar("--color-neutral", "#6b7280"),
    };
    const PAPER = cssVar("--color-paper", "#f8f9fb");
    const INK = cssVar("--color-ink", "#1b2733");

    const ESTADOS: Record<string, string> = {
      abierto: "Abierto",
      operativo: "Operativo",
      limitado: "Limitado",
      cerrado: "Cerrado",
      "sin-confirmar": "Sin confirmar",
    };

    const puntos: Punto[] = JSON.parse(el.dataset.puntos ?? "[]");
    const zonas: Zona[] = JSON.parse(el.dataset.zonas ?? "[]");

    // Cadena de respaldo: OpenFreeMap → OSM raster → lista de datos.
    const ESTILO_OSM = {
      version: 8 as const,
      sources: {
        osm: {
          type: "raster" as const,
          tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
          tileSize: 256,
          attribution: "© OpenStreetMap contributors",
        },
      },
      layers: [{ id: "osm", type: "raster" as const, source: "osm" }],
    };
    let estiloAlternativo = false;

    const map = new maplibre.Map({
      container: el,
      // Estilo completo de OpenFreeMap: tiles, glifos y sprites incluidos.
      style: "https://tiles.openfreemap.org/styles/liberty",
      center: [-75.6, 4.4],
      zoom: 6,
    });

    map.addControl(new maplibre.NavigationControl({ showCompass: false }), "top-right");
    map.addControl(
      new maplibre.GeolocateControl({
        positionOptions: { enableHighAccuracy: true },
        trackUserLocation: false,
      }),
      "top-right"
    );

    function featureCollection(lista: Punto[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((p) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [p.lng, p.lat] },
          properties: { ...p, color: COLORS[p.tipo] },
        })),
      };
    }

    function featureCollectionZonas(lista: Zona[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((z) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [z.lng, z.lat] },
          properties: z,
        })),
      };
    }

    function aplicarFiltros() {
      const visibles = new Set(
        Array.from(document.querySelectorAll(".mapa-leyenda input[type='checkbox']:checked")).map(
          (i) => (i as HTMLInputElement).value
        )
      );
      const ciudad = Array.from(document.querySelectorAll<HTMLSelectElement>(".mapa-leyenda select"))
        .map((s) => s.value)
        .find((v) => v !== "") ?? "";
      const puntosFiltrados = puntos.filter(
        (p) => visibles.has(p.tipo) && (!ciudad || p.ciudad === ciudad)
      );
      const zonasFiltradas = zonas.filter((z) => visibles.has(z.tipo));
      const srcP = map.getSource("puntos");
      if (srcP && "setData" in srcP) {
        (srcP as maplibre.GeoJSONSource).setData(featureCollection(puntosFiltrados));
      }
      const srcZ = map.getSource("zonas");
      if (srcZ && "setData" in srcZ) {
        (srcZ as maplibre.GeoJSONSource).setData(featureCollectionZonas(zonasFiltradas));
      }
    }

    map.on("load", () => {
      cargado = true;
      activarMapa();
      // El contenedor pasa de display:none a visible: MapLibre debe
      // re-medir el canvas o quedaría en blanco (bug clásico).
      requestAnimationFrame(() => requestAnimationFrame(() => map.resize()));

      if (map.getSource("puntos")) return;

      map.addSource("puntos", { type: "geojson", data: featureCollection(puntos) });
      map.addSource("zonas", { type: "geojson", data: featureCollectionZonas(zonas) });

      // Zonas (epicentro + ciudades) bajo los puntos de datos
      map.addLayer({
        id: "zonas-circulo",
        type: "circle",
        source: "zonas",
        paint: {
          "circle-radius": ["match", ["get", "tipo"], "epicentro", 14, "ciudad", 7, 7],
          "circle-color": ["match", ["get", "tipo"], "epicentro", COLORS.salud, "ciudad", COLORS.neutral, COLORS.neutral],
          "circle-stroke-width": ["match", ["get", "tipo"], "epicentro", 3, "ciudad", 2, 2],
          "circle-stroke-color": PAPER,
        },
      });

      map.addLayer({
        id: "zonas-texto",
        type: "symbol",
        source: "zonas",
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": ["match", ["get", "tipo"], "epicentro", 12, "ciudad", 11, 11],
          "text-offset": [0, 1.6],
          "text-anchor": "top",
          "text-max-width": 9,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      map.addLayer({
        id: "puntos-circulo",
        type: "circle",
        source: "puntos",
        paint: {
          "circle-radius": 9,
          "circle-color": ["get", "color"],
          "circle-stroke-width": 2,
          "circle-stroke-color": PAPER,
        },
      });

      map.addLayer({
        id: "puntos-texto",
        type: "symbol",
        source: "puntos",
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": 11,
          "text-offset": [0, 1.4],
          "text-anchor": "top",
          "text-max-width": 9,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      map.on("click", "puntos-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const p = f.properties as unknown as Punto;
        const coords = (f.geometry as { type: "Point"; coordinates: [number, number] }).coordinates;
        new maplibre.Popup({ offset: 16 })
          .setLngLat(coords)
          .setHTML(
            `<strong>${p.nombre}</strong><br/>${p.ciudad} · ${ESTADOS[p.estado] ?? p.estado}<br/>${p.direccion}<br/><small>Fuente: <a href="${p.fuente}" target="_blank" rel="noopener">ver fuente</a></small>`
          )
          .addTo(map);
      });

      map.on("mouseenter", "puntos-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "puntos-circulo", () => {
        map.getCanvas().style.cursor = "";
      });

      // Popup y cursor para zonas
      map.on("click", "zonas-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const z = f.properties as unknown as Zona;
        const coords = (f.geometry as { type: "Point"; coordinates: [number, number] }).coordinates;
        new maplibre.Popup({ offset: 16 })
          .setLngLat(coords)
          .setHTML(
            `<strong>${z.nombre}</strong><br/>${z.detalle ?? "Sismo sentido"} · 10-08-2026<br/><small>Fuente: <a href="${z.fuente}" target="_blank" rel="noopener">SGC</a></small>`
          )
          .addTo(map);
      });

      map.on("mouseenter", "zonas-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "zonas-circulo", () => {
        map.getCanvas().style.cursor = "";
      });
    });

    map.on("styleerror", () => {
      // El proveedor principal falló: reintenta con OSM raster. Si ese
      // también falla, el contenido base (lista) queda como respaldo.
      if (cargado) return;
      if (!estiloAlternativo) {
        estiloAlternativo = true;
        map.setStyle(ESTILO_OSM);
      } else {
        fallido = true;
      }
    });

    map.on("error", () => {
      // Errores de tiles o de render: si el estilo ya cargó, el mapa sigue
      // funcionando; el timeout de 8 s cubre el caso de carga lenta.
    });

    setTimeout(() => {
      if (!cargado) fallido = true;
    }, 8000);

    document.querySelectorAll<HTMLInputElement>(".mapa-leyenda input[type='checkbox']").forEach((input) => {
      input.addEventListener("change", aplicarFiltros);
    });
    document.querySelectorAll<HTMLSelectElement>(".mapa-leyenda select").forEach((select) => {
      select.addEventListener("change", aplicarFiltros);
    });
  }
</script>
