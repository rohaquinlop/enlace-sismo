---
import type { Acopio, Albergue, CentroSalud, JornadaSangre } from "../lib/catalogs";
import type { Zona } from "../lib/zonas";
import type { PuntoVerificado } from "../lib/puntos-rescate";
import type { CiudadReportada } from "../lib/ciudades";
import evento from "../../../data/evento.json";
import { haversineKm } from "../lib/geo";

interface Props {
  acopios: Acopio[];
  albergues: Albergue[];
  centros: CentroSalud[];
  jornadas?: JornadaSangre[];
  zonas?: Zona[];
  puntosRescate?: PuntoVerificado[];
  ciudadesReportadas?: CiudadReportada[];
}

const { acopios, albergues, centros, jornadas = [], zonas = [], puntosRescate = [], ciudadesReportadas = [] } = Astro.props;

type Punto = {
  id: string;
  nombre: string;
  lat: number;
  lng: number;
  tipo: "acopio" | "albergue" | "salud" | "sangre";
  estado: string;
  ciudad: string;
  direccion: string;
  fuente: string;
  detalle?: string;
};

const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
const fmtDia = (iso: string) => {
  const [, m, d] = iso.split("-").map(Number);
  return `${d} ${MESES[m - 1]}`;
};

const puntos: Punto[] = [
  ...acopios.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "acopio" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...albergues.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "albergue" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...centros.map((e) => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "salud" as const, estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente })),
  ...jornadas.map((e) => ({
    id: e.id,
    nombre: e.punto,
    lat: e.lat,
    lng: e.lng,
    tipo: "sangre" as const,
    estado: e.estado,
    ciudad: e.ciudad,
    direccion: e.direccion,
    fuente: e.fuente,
    detalle: `${e.fecha_fin ? `${fmtDia(e.fecha_inicio)} → ${fmtDia(e.fecha_fin)}` : `Desde ${fmtDia(e.fecha_inicio)}`} · ${e.horario}`,
  })),
];

// Distancia al epicentro calculada en build (haversine) y pasada al cliente.
const epicentro = zonas.find((z) => z.tipo === "epicentro");
const zonasConDistancia = zonas.map((z) => ({
  ...z,
  distEpicentroKm: epicentro && z.id !== epicentro.id
    ? haversineKm(z.lat, z.lng, epicentro.lat, epicentro.lng)
    : 0,
}));

const puntosJson = JSON.stringify(puntos);
const zonasJson = JSON.stringify(zonasConDistancia);
const eventoJson = JSON.stringify({ fecha: evento.fecha.slice(0, 10) });
---

<div class="mapa-full" id="mapa-libre" data-puntos={puntosJson} data-zonas={zonasJson} data-evento={eventoJson} data-rescates={JSON.stringify(puntosRescate)} data-ciudades-reportadas={JSON.stringify(ciudadesReportadas)}></div>

<script>
  import maplibre from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import { oklchAHex } from "../lib/color";
  import { haversineKm, formatearDistancia } from "../lib/geo";
  import { puntoActivo, type PuntoVivo } from "../lib/puntos-rescate";
  import { agruparCiudades, nombreCiudadNormalizado, type CiudadReportada } from "../lib/ciudades";
  import { etiquetaTipo, etiquetaNecesidad, ESTADOS_PUNTO, PRECISION_CORTA, type PrecisionPin } from "../lib/necesidades";
  import type { PuntoVerificado } from "../lib/puntos-rescate";
  import type { Acopio, Albergue, CentroSalud, JornadaSangre } from "../lib/catalogs";
  import type { Zona as ZonaCatalogo } from "../lib/zonas";

  type Punto = {
    id: string;
    nombre: string;
    lat: number;
    lng: number;
    tipo: "acopio" | "albergue" | "salud" | "sangre";
    estado: string;
    ciudad: string;
    direccion: string;
    fuente: string;
    detalle?: string;
  };

  type Zona = {
    id: string;
    nombre: string;
    tipo: "epicentro" | "ciudad";
    lat: number;
    lng: number;
    intensidad?: number;
    detalle?: string;
    fuente: string;
    distEpicentroKm: number;
  };

  // Ciudades reportadas (marcador neutral agrupado, familia de zonas)
  type PuntoCiudadMap = {
    id: string;
    etiqueta: string;
    lat: number;
    lng: number;
    necesidades: string[];
    confirmaciones: number;
    estado: string;
  };
  type CiudadReportadaMap = {
    nombre: string;
    lat: number;
    lng: number;
    puntos: PuntoCiudadMap[];
  };

  const aCiudadMap = (c: CiudadReportada): CiudadReportadaMap => ({
    nombre: c.nombre,
    lat: c.lat,
    lng: c.lng,
    puntos: c.puntos.map((p) => ({
      id: p.id,
      etiqueta: `${etiquetaTipo(p.tipo)}${p.direccion ? ` — ${p.direccion}` : ""}`,
      lat: p.lat,
      lng: p.lng,
      necesidades: p.necesidades,
      confirmaciones: p.confirmaciones.length,
      estado: p.estado,
    })),
  });
  type PuntoRescateMap = {
    id: string;
    nombre: string;
    lat: number;
    lng: number;
    estado: string;
    coordenadas_nivel?: PrecisionPin;
    ciudad: string;
    direccion: string;
    descripcion: string;
    necesidades: string[];
    otras_necesidades: string;
    contacto: string;
    confirmaciones: number;
    flags: number;
    creado: string;
    fuente: string;
    reporte_id: string;
  };

  const el = document.getElementById("mapa-libre") as HTMLDivElement;
  const contenedor = el.closest<HTMLElement>(".dash");

  // El rail se posiciona bajo la barra de evento. Se mide en runtime para no
  // depender de cálculos frágiles (zoom de fuente, contenido dinámico como
  // la línea de distancia al geolocalizar). Fallback CSS: --barra-h.
  let medirBarra: (() => void) | null = null;
  const barra = document.querySelector<HTMLElement>(".barra-evento");
  if (contenedor && barra && "ResizeObserver" in window) {
    const medir = () => {
      contenedor.style.setProperty("--barra-h-real", `${barra.getBoundingClientRect().height}px`);
    };
    medirBarra = medir;
    medir();
    new ResizeObserver(medir).observe(barra);
    window.addEventListener("resize", medir);
  }

  // Compensación del centro en móvil: la hoja inferior (mapa-overlays) tapa
  // el centro del canvas; el punto objetivo debe quedar en el centro del área
  // visible — entre la barra superior y la hoja. En desktop la hoja es un
  // overlay transparente full-height y no se compensa. Devuelve el offset en
  // píxeles del viewport del mapa (negativo en Y = el punto sube).
  function offsetCentro(): [number, number] {
    if (!contenedor) return [0, 0];
    const hoja = document.querySelector<HTMLElement>(".mapa-overlays");
    const barraEv = document.querySelector<HTMLElement>(".barra-evento");
    if (!hoja || !barraEv) return [0, 0];
    const dashRect = contenedor.getBoundingClientRect();
    const hojaRect = hoja.getBoundingClientRect();
    const barraRect = barraEv.getBoundingClientRect();
    const topVisible = barraRect.bottom - dashRect.top;
    const topHoja = hojaRect.top - dashRect.top;
    // La hoja debe estar anclada a la parte inferior del dash (modo móvil);
    // si ocupa todo el alto (desktop) o está oculta, no hay nada que compensar
    if (topHoja <= topVisible + 16 || hojaRect.height <= 0) return [0, 0];
    const centroVisible = (topVisible + topHoja) / 2;
    return [0, centroVisible - dashRect.height / 2];
  }

  // Detectar móvil: el botón toggle solo es visible en < 60rem
  function esMovilMapa(): boolean {
    const toggle = document.getElementById("rail-toggle");
    return toggle ? getComputedStyle(toggle).display !== "none" : false;
  }

  // Progresivo: el contenido base ya es legible. El mapa solo se muestra
  // cuando carga sin errores. Sin WebGL, con error o tras 8 s → fallback.
  let cargado = false;
  let fallido = false;

  function activarMapa() {
    if (!fallido && contenedor) contenedor.classList.add("con-mapa");
    // La barra pasa de tarjeta (flujo) a barra superior: re-medir en el mismo
    // frame para que el rail no quede desalineado ni un instante
    medirBarra?.();
  }

  const tieneWebGL = (() => {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  })();

  if (!tieneWebGL) {
    fallido = true;
  } else {
    // Colores desde los tokens del diseño (tokens.css) — nunca valores sueltos.
    // MapLibre no acepta oklch(): se convierte a hex en runtime.
    const cssVar = (name: string, fallback: string) => {
      const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      if (!v) return fallback;
      return oklchAHex(v) ?? v;
    };

    const COLORS: Record<string, string> = {
      acopio: cssVar("--color-accent", "#1d4ed8"),
      albergue: cssVar("--color-ok", "#2f7d4f"),
      salud: cssVar("--color-error", "#9e2a1d"),
      sangre: cssVar("--color-sangre", "#e40095"),
      rescate: cssVar("--color-rescate", "#6647c0"),
      neutral: cssVar("--color-neutral", "#6b7280"),
      geo: cssVar("--color-geo", "#2563eb"),
    };
    const PAPER = cssVar("--color-paper", "#f8f9fb");
    const INK = cssVar("--color-ink", "#1b2733");

    const ESTADOS: Record<string, string> = {
      abierto: "Abierto",
      activa: "Activa",
      finalizada: "Finalizada",
      operativo: "Operativo",
      limitado: "Limitado",
      cerrado: "Cerrado",
      "sin-confirmar": "Sin confirmar",
    };

    const ROMANOS = ["", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];

    // Escapa texto de datos antes de inyectarlo en el popup (nunca markup).
    const escapar = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

    let puntos: Punto[] = JSON.parse(el.dataset.puntos ?? "[]");
    let zonas: Zona[] = JSON.parse(el.dataset.zonas ?? "[]");
    let { fecha } = JSON.parse(el.dataset.evento ?? "{}") as { fecha?: string };
    let epicentro = zonas.find((z) => z.tipo === "epicentro") ?? null;

    // Puntos de rescate verificados (catálogo, SSG). Los resueltos no se
    // dibujan: el mapa muestra ayuda activa.
    const rescatesVerificados: PuntoRescateMap[] = (
      JSON.parse(el.dataset.rescates ?? "[]") as PuntoVerificado[]
    )
      .filter((v) => v.estado !== "resuelto")
      .map((v) => ({
        id: v.id,
        nombre: v.nombre,
        lat: v.lat,
        lng: v.lng,
        estado: v.estado,
        coordenadas_nivel: v.coordenadas_nivel ?? "via",
        ciudad: v.ciudad ?? "",
        direccion: v.direccion,
        descripcion: v.descripcion ?? "",
        necesidades: v.necesidades ?? [],
        otras_necesidades: v.otras_necesidades ?? "",
        contacto: v.contacto ?? "",
        confirmaciones: 0,
        flags: 0,
        creado: v.created_at ?? "",
        fuente: v.fuente,
        reporte_id: v.reporte_id ?? "",
      }));
    let rescates: PuntoRescateMap[] = rescatesVerificados;

    // Ciudades reportadas: dataset SSG (dedupe contra el catálogo ya hecho en
    // el build); el fetch del archivo en vivo las regenera en runtime.
    const ciudadesReportadasIniciales: CiudadReportadaMap[] = (
      JSON.parse(el.dataset.ciudadesReportadas ?? "[]") as CiudadReportada[]
    ).map(aCiudadMap);
    let ciudadesReportadasMap: CiudadReportadaMap[] = ciudadesReportadasIniciales;

    // Rama Mercalli desde tokens; sin intensidad → neutral.
    const colorIntensidad = (i: number | undefined) =>
      i ? cssVar(`--mercalli-${i}`, COLORS.neutral) : COLORS.neutral;
    const radioIntensidad = (i: number | undefined) => (i ? Math.round(5 + i * 0.9) : 7);

    // Cadena de respaldo: OpenFreeMap → OSM raster → lista de datos.
    const ESTILO_OSM = {
      version: 8 as const,
      sources: {
        osm: {
          type: "raster" as const,
          tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
          tileSize: 256,
          attribution: "© OpenStreetMap contributors",
        },
      },
      layers: [{ id: "osm", type: "raster" as const, source: "osm" }],
    };
    let estiloAlternativo = false;

    const map = new maplibre.Map({
      container: el,
      // Estilo completo de OpenFreeMap: tiles, glifos y sprites incluidos.
      style: "https://tiles.openfreemap.org/styles/liberty",
      center: [-75.6, 4.4],
      zoom: 6,
    });

    map.addControl(new maplibre.NavigationControl({ showCompass: false }), "top-right");

    // Centrar el mapa tras abrir un popup, midiendo su altura real.
    // En móvil (panel colapsado): calcula el offset para que el popup completo
    // quepa entre la barra superior y el punto. En desktop: usa offsetCentro().
    function centrarEnPopup(coords: [number, number]) {
      if (!esMovilMapa()) {
        map.easeTo({ center: coords, offset: offsetCentro(), duration: 400 });
        return;
      }
      // Esperar un frame para que el popup se renderice y tenga dimensiones
      requestAnimationFrame(() => {
        const popupEl = document.querySelector<HTMLElement>(".maplibregl-popup");
        const barra = document.querySelector<HTMLElement>(".barra-evento");
        const mapRect = contenedor?.getBoundingClientRect();
        if (!mapRect) return;
        const altPopup = popupEl?.offsetHeight ?? 120;
        // Borde inferior de la barra, relativo al top del mapa
        const barraBottom = barra
          ? barra.getBoundingClientRect().bottom - mapRect.top
          : 60;
        const mapHeight = mapRect.height;
        // El punto debe quedar a: barraBottom + altPopup + margen (para que
        // el popup quepa entre la barra y el punto sin solaparse)
        const puntoDeseado = barraBottom + altPopup + 16;
        const offset: [number, number] = [0, puntoDeseado - mapHeight / 2];
        map.easeTo({ center: coords, offset, duration: 400 });
      });
    }

    function featureCollection(lista: Punto[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((p) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [p.lng, p.lat] },
          properties: { ...p, color: COLORS[p.tipo] },
        })),
      };
    }

    function featureCollectionZonas(lista: Zona[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((z) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [z.lng, z.lat] },
          properties: {
            ...z,
            color: colorIntensidad(z.intensidad),
            radio: radioIntensidad(z.intensidad),
          },
        })),
      };
    }

    function featureCollectionRescates(lista: PuntoRescateMap[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((p) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [p.lng, p.lat] },
          properties: { ...p, color: COLORS.rescate },
        })),
      };
    }

    function featureCollectionCiudades(lista: CiudadReportadaMap[]) {
      return {
        type: "FeatureCollection" as const,
        features: lista.map((c) => ({
          type: "Feature" as const,
          geometry: { type: "Point" as const, coordinates: [c.lng, c.lat] },
          properties: { ...c, color: COLORS.neutral },
        })),
      };
    }

    function featureOnda(r: number, o: number) {
      if (!epicentro) return null;
      return {
        type: "FeatureCollection" as const,
        features: [
          {
            type: "Feature" as const,
            geometry: { type: "Point" as const, coordinates: [epicentro.lng, epicentro.lat] },
            properties: { r, o },
          },
        ],
      };
    }

    function featureUsuario(lat: number, lng: number) {
      return {
        type: "FeatureCollection" as const,
        features: [
          {
            type: "Feature" as const,
            geometry: { type: "Point" as const, coordinates: [lng, lat] },
            properties: {},
          },
        ],
      };
    }

    let popupActivo: maplibre.Popup | null = null;

    function abrirPopupZona(z: Zona) {
      const intensidad = z.intensidad
        ? `Intensidad ${ROMANOS[z.intensidad]} — Mercalli`
        : "Sin reporte de intensidad";
      const distancia = z.distEpicentroKm
        ? `A ${formatearDistancia(z.distEpicentroKm)} del epicentro`
        : "";
      popupActivo?.remove();
      popupActivo = new maplibre.Popup({ offset: 16 })
        .setLngLat([z.lng, z.lat])
        .setHTML(
          `<div class="popup popup-zona">` +
            `<strong class="popup-titulo">${escapar(z.nombre)}</strong>` +
            `<p class="popup-meta">${escapar(intensidad)}${distancia ? ` · ${escapar(distancia)}` : ""}</p>` +
            `<p class="popup-linea">${escapar(z.detalle ?? "Sismo sentido")} · ${escapar(fecha ?? "")}</p>` +
            `<p class="popup-coords">${z.lat.toFixed(2)}°N ${z.lng.toFixed(2)}°O</p>` +
            `<p class="popup-fuente">Fuente: <a href="${escapar(z.fuente)}" target="_blank" rel="noopener">SGC</a> · ` +
            `<a href="https://www.google.com/maps/dir/?api=1&destination=${z.lat},${z.lng}" target="_blank" rel="noopener">Cómo llegar</a></p>` +
            `</div>`
        )
        .addTo(map);
      window.dispatchEvent(new CustomEvent("enlace:mapa:zona-activa", { detail: { id: z.id } }));
    }

    function volarAZona(z: Zona) {
      abrirPopupZona(z);
      const zoom = z.tipo === "epicentro" ? 8 : 9;
      if (!esMovilMapa()) {
        map.flyTo({ center: [z.lng, z.lat], zoom, offset: offsetCentro(), essential: true });
      } else {
        // En móvil: volar primero, luego ajustar con el popup medido
        map.flyTo({ center: [z.lng, z.lat], zoom, essential: true });
        map.once("moveend", () => centrarEnPopup([z.lng, z.lat]));
      }
    }

    // Popup de puntos de rescate: tipo, necesidades, contacto, estado.
    // Compartido por el clic en el mapa y por el vuelo desde el panel Rescates.
    function abrirPopupRescate(p: PuntoRescateMap, coords: [number, number]) {
      window.dispatchEvent(new CustomEvent("enlace:mapa:punto-click"));
      popupActivo?.remove();
      // MapLibre serializa arrays/objetos en properties como strings JSON
      const necesidades: string[] = typeof p.necesidades === "string" ? JSON.parse(p.necesidades) : (p.necesidades ?? []);
      const needs = necesidades.length
        ? `<span class="popup-rescate-ns">${necesidades
            .map((n) => `<span>${escapar(etiquetaNecesidad(n))}</span>`)
            .join("")}</span>`
        : "";
      const otras = p.otras_necesidades ? `<p class="popup-linea">${escapar(p.otras_necesidades)}</p>` : "";
      const contacto = p.contacto ? `<p class="popup-linea">Contacto: ${escapar(p.contacto)}</p>` : "";
      const flags = p.flags > 0 ? `<p class="popup-linea">${p.flags} reporte(s) de falso</p>` : "";
      const precision = `<p class="popup-linea">Precisión: ${escapar(PRECISION_CORTA[p.coordenadas_nivel ?? "via"])}</p>`;
      popupActivo = new maplibre.Popup({ offset: 16 })
        .setLngLat(coords)
        .setHTML(
          `<div class="popup popup-punto">` +
            `<strong class="popup-titulo">${escapar(p.nombre)}</strong>` +
            `<p class="popup-meta"><span class="popup-badge popup-badge-rescate">${escapar(ESTADOS_PUNTO[p.estado] ?? p.estado)}</span> ${p.fuente ? "Verificado por fuente" : `${p.confirmaciones} confirmación(es)`}</p>` +
            `${p.descripcion ? `<p class="popup-linea">${escapar(p.descripcion)}</p>` : ""}` +
            `${needs}${otras}${contacto}${flags}${precision}` +
            `<p class="popup-fuente">${p.fuente ? `Fuente: <a href="${escapar(p.fuente)}" target="_blank" rel="noopener">ver fuente</a> · ` : "Reporte ciudadano · "}` +
            `<a href="https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}" target="_blank" rel="noopener">Cómo llegar</a></p>` +
            `</div>`
        )
        .addTo(map);
      centrarEnPopup(coords);
    }

    // Última ciudad elegida: volar a la ciudad solo cuando cambia el filtro
    let ciudadFiltro = "";

    function aplicarFiltros(volar = true) {
      const visibles = new Set(
        Array.from(document.querySelectorAll(".leyenda-tira input[type='checkbox']:checked")).map(
          (i) => (i as HTMLInputElement).value
        )
      );
      const ciudad = Array.from(document.querySelectorAll<HTMLSelectElement>(".leyenda-tira select"))
        .map((s) => s.value)
        .find((v) => v !== "") ?? "";
      if (ciudad !== ciudadFiltro) {
        ciudadFiltro = ciudad;
        if (ciudad && volar) {
          const z = zonas.find((x) => x.nombre.toLowerCase() === ciudad.toLowerCase());
          if (z) map.flyTo({ center: [z.lng, z.lat], zoom: 8, offset: offsetCentro(), essential: true });
        }
      }
      const puntosFiltrados = puntos.filter(
        (p) => visibles.has(p.tipo) && (!ciudad || p.ciudad === ciudad)
      );
      const zonasFiltradas = zonas.filter((z) =>
        z.tipo === "epicentro" ? visibles.has("epicentro") : visibles.has("zona")
      );
      const srcP = map.getSource("puntos");
      if (srcP && "setData" in srcP) {
        (srcP as maplibre.GeoJSONSource).setData(featureCollection(puntosFiltrados));
      }
      // Conteo de puntos visibles en la tira (instrumento: cuánto hay aquí)
      const conteo = document.getElementById("puntos-conteo");
      if (conteo) {
        conteo.textContent =
          puntosFiltrados.length === 1 ? "1 punto" : `${puntosFiltrados.length} puntos`;
      }
      const srcZ = map.getSource("zonas");
      if (srcZ && "setData" in srcZ) {
        (srcZ as maplibre.GeoJSONSource).setData(featureCollectionZonas(zonasFiltradas));
      }
      // El anillo del epicentro sigue la casilla "Epicentro"
      if (map.getLayer("epicentro-onda")) {
        map.setLayoutProperty("epicentro-onda", "visibility", visibles.has("epicentro") ? "visible" : "none");
      }
      if (visibles.has("epicentro")) arrancarOnda();
      else detenerOnda();
      // Puntos de rescate: la capa sigue SOLO al chip; el filtro de ciudad
      // se aplica abajo (cada reporte lleva su ciudad).
      const rescatesVisibles = visibles.has("rescates");
      for (const idLayer of ["rescates-circulo", "rescates-texto"]) {
        if (map.getLayer(idLayer)) {
          map.setLayoutProperty(idLayer, "visibility", rescatesVisibles ? "visible" : "none");
        }
      }
      // Ciudades reportadas: familia de zonas (chip "Zonas")
      for (const idLayer of ["ciudades-reportadas-circulo", "ciudades-reportadas-texto"]) {
        if (map.getLayer(idLayer)) {
          map.setLayoutProperty(idLayer, "visibility", visibles.has("zona") ? "visible" : "none");
        }
      }
      // El filtro de ciudad SÍ aplica a los puntos de rescate: cada reporte
      // lleva su ciudad (derivada del reverse geocode); sin ciudad se oculta
      // bajo un filtro activo (información honesta).
      const rescatesFiltrados = rescates.filter((p) => !ciudad || p.ciudad === ciudad);
      const srcR = map.getSource("rescates");
      if (srcR && "setData" in srcR) {
        (srcR as maplibre.GeoJSONSource).setData(featureCollectionRescates(rescatesFiltrados));
      }
    }

    // ---- Datos frescos del dashboard (desacoplar-datos-deploy) ----
    // El script de la página refresca catálogos, zonas, evento y registro
    // desde /api/datos/:catalogo y los comparte con el mapa. Sin datos
    // frescos, el mapa conserva los del build (SSG).
    interface DatosFrescos {
      acopios?: Acopio[];
      albergues?: Albergue[];
      centros?: CentroSalud[];
      jornadas?: JornadaSangre[];
      zonas?: ZonaCatalogo[];
      evento?: { fecha?: string };
      registro?: PuntoVivo[];
    }

    const MESES = ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"];
    const fmtDia = (iso: string) => {
      const [, m, d] = iso.split("-").map(Number);
      return `${d} ${MESES[m - 1]}`;
    };
    const aPuntoAcopio = (e: Acopio): Punto => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "acopio", estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente });
    const aPuntoAlbergue = (e: Albergue): Punto => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "albergue", estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente });
    const aPuntoSalud = (e: CentroSalud): Punto => ({ id: e.id, nombre: e.nombre, lat: e.lat, lng: e.lng, tipo: "salud", estado: e.estado, ciudad: e.ciudad, direccion: e.direccion, fuente: e.fuente });
    const aPuntoSangre = (e: JornadaSangre): Punto => ({
      id: e.id,
      nombre: e.punto,
      lat: e.lat,
      lng: e.lng,
      tipo: "sangre",
      estado: e.estado,
      ciudad: e.ciudad,
      direccion: e.direccion,
      fuente: e.fuente,
      detalle: `${e.fecha_fin ? `${fmtDia(e.fecha_inicio)} → ${fmtDia(e.fecha_fin)}` : `Desde ${fmtDia(e.fecha_inicio)}`} · ${e.horario}`,
    });
    const conDistancia = (zs: ZonaCatalogo[]): Zona[] => {
      const epi = zs.find((z) => z.tipo === "epicentro");
      return zs.map((z) => ({
        ...z,
        distEpicentroKm: epi && z.id !== epi.id ? haversineKm(z.lat, z.lng, epi.lat, epi.lng) : 0,
      }));
    };

    // ---- Registro en vivo: fetch del archivo commiteado por el worker ----
    // Respaldo del refresco del dashboard: si el script de la página falla,
    // el mapa igual carga los reportes activos desde la copia estática.
    function aplicarRegistroMapa(vivos: PuntoVivo[]) {
      if (!Array.isArray(vivos)) return;
      const promovidos = new Set(
        rescatesVerificados.filter((v) => v.reporte_id).map((v) => v.reporte_id)
      );
      const enVivo = vivos
        .filter((p) => puntoActivo(p) && !promovidos.has(p.id))
        .map((p) => ({
          id: p.id,
          nombre: `${etiquetaTipo(p.tipo)}${p.direccion ? ` — ${p.direccion}` : ""}`,
          lat: p.lat,
          lng: p.lng,
          estado: p.estado,
          coordenadas_nivel: p.coordenadas_nivel ?? "via",
          ciudad: p.ciudad ?? "",
          direccion: p.direccion ?? "",
          descripcion: p.descripcion,
          necesidades: p.necesidades,
          otras_necesidades: p.otras_necesidades ?? "",
          contacto: p.contacto ?? "",
          confirmaciones: p.confirmaciones.length,
          flags: p.flags.length,
          creado: p.created_at,
          fuente: "",
          reporte_id: "",
        }));
      rescates = [...rescatesVerificados, ...enVivo];
      // Ciudades reportadas: se regeneran en runtime (dedupe contra el
      // catálogo de puntos y zonas SGC).
      const catalogadas = new Set([
        ...puntos.map((p) => nombreCiudadNormalizado(p.ciudad)),
        ...zonas.filter((z) => z.tipo === "ciudad").map((z) => nombreCiudadNormalizado(z.nombre)),
      ]);
      ciudadesReportadasMap = agruparCiudades(vivos)
        .filter((c) => !catalogadas.has(nombreCiudadNormalizado(c.nombre)))
        .map(aCiudadMap);
      const srcC = map.getSource("ciudades-reportadas");
      if (srcC && "setData" in srcC) {
        (srcC as maplibre.GeoJSONSource).setData(featureCollectionCiudades(ciudadesReportadasMap));
      }
      if (cargado) aplicarFiltros();
    }

    fetch("/datos/reportes-puntos.json")
      .then((r) => (r.ok ? r.json() : []))
      .then((vivos: unknown) => aplicarRegistroMapa(vivos as PuntoVivo[]))
      .catch(() => {
        // Sin archivo o red caída: quedan los verificados (SSG).
      });

    // Refresco del dashboard: catálogos, zonas, evento y registro frescos.
    window.addEventListener(
      "enlace:mapa:datos-frescos",
      ((e: CustomEvent<DatosFrescos>) => {
        const d = e.detail;
        if (!d || typeof d !== "object") return;
        if (d.acopios || d.albergues || d.centros || d.jornadas) {
          const porTipo = (t: Punto["tipo"]) => puntos.filter((p) => p.tipo === t);
          puntos = [
            ...(d.acopios ? d.acopios.map(aPuntoAcopio) : porTipo("acopio")),
            ...(d.albergues ? d.albergues.map(aPuntoAlbergue) : porTipo("albergue")),
            ...(d.centros ? d.centros.map(aPuntoSalud) : porTipo("salud")),
            ...(d.jornadas ? d.jornadas.map(aPuntoSangre) : porTipo("sangre")),
          ];
        }
        if (d.zonas) {
          zonas = conDistancia(d.zonas);
          epicentro = zonas.find((z) => z.tipo === "epicentro") ?? null;
        }
        if (d.evento?.fecha) fecha = d.evento.fecha.slice(0, 10);
        if (d.registro) aplicarRegistroMapa(d.registro);
        if (cargado) {
          const srcP = map.getSource("puntos");
          if (srcP && "setData" in srcP) {
            (srcP as maplibre.GeoJSONSource).setData(featureCollection(puntos));
          }
          const srcZ = map.getSource("zonas");
          if (srcZ && "setData" in srcZ) {
            (srcZ as maplibre.GeoJSONSource).setData(featureCollectionZonas(zonas));
          }
          aplicarFiltros();
        }
      }) as EventListener
    );

    // ---- Anillo expansivo del epicentro (rAF, pausa fuera del viewport) ----
    let ondaFrame = 0;
    let ondaActiva = false;
    const ONDA_DUR = 2600;
    const motionReducida = matchMedia("(prefers-reduced-motion: reduce)").matches;

    function arrancarOnda() {
      const src = map.getSource("epicentro-onda");
      if (!src || ondaActiva || !cargado) return;
      ondaActiva = true;
      if (motionReducida) {
        // Movimiento reducido: halo estático, sin animación
        const f = featureOnda(30, 0.14);
        if (f) (src as maplibre.GeoJSONSource).setData(f);
        return;
      }
      const inicio = performance.now();
      const tick = (ahora: number) => {
        if (!ondaActiva) return;
        const p = ((ahora - inicio) % ONDA_DUR) / ONDA_DUR;
        const f = featureOnda(4 + p * 80, (1 - p) * 0.4);
        if (f) (src as maplibre.GeoJSONSource).setData(f);
        ondaFrame = requestAnimationFrame(tick);
      };
      ondaFrame = requestAnimationFrame(tick);
    }

    function detenerOnda() {
      ondaActiva = false;
      cancelAnimationFrame(ondaFrame);
    }

    // ---- Cerca de mí (geolocalización) ----
    const btnGeo = document.getElementById("btn-cerca-de-mi");
    const msgGeo = document.getElementById("geo-mensaje");
    const lineaDist = document.getElementById("dist-epicentro");
    let ultimaPos: GeolocationPosition | null = null;

    function mensajeGeo(texto: string) {
      if (!msgGeo) return;
      msgGeo.textContent = texto;
      msgGeo.hidden = false;
    }

    function actualizarPrecision(accuracy: number) {
      if (!ultimaPos) return;
      if (!map.getLayer("usuario-preciso")) return;
      const lat = ultimaPos.coords.latitude;
      const mpp = (156543.03392 * Math.cos((lat * Math.PI) / 180)) / Math.pow(2, map.getZoom());
      map.setPaintProperty("usuario-preciso", "circle-radius", Math.max(accuracy / mpp, 6));
    }

    function dibujarUsuario(pos: GeolocationPosition) {
      const { latitude, longitude, accuracy } = pos.coords;
      const src = map.getSource("usuario");
      if (src && "setData" in src) {
        (src as maplibre.GeoJSONSource).setData(featureUsuario(latitude, longitude));
      }
      actualizarPrecision(accuracy);
      // Lleva la vista a la ubicación del usuario para que el resultado sea visible
      map.flyTo({ center: [longitude, latitude], zoom: 8, offset: offsetCentro(), essential: true });
      if (epicentro) {
        const km = haversineKm(latitude, longitude, epicentro.lat, epicentro.lng);
        if (lineaDist) {
          lineaDist.hidden = false;
          lineaDist.textContent = `Estás a ${formatearDistancia(km)} del epicentro`;
        }
      }
      window.dispatchEvent(
        new CustomEvent("enlace:mapa:posicion", {
          detail: {
            distancias: zonas.map((z) => ({
              id: z.id,
              km: haversineKm(latitude, longitude, z.lat, z.lng),
            })),
          },
        })
      );
    }

    function geolocalizar() {
      if (!("geolocation" in navigator)) {
        mensajeGeo("Tu navegador no soporta geolocalización.");
        if (btnGeo) btnGeo.hidden = true;
        return;
      }
      if (btnGeo) btnGeo.setAttribute("aria-busy", "true");
      // Red de seguridad: si el navegador nunca responde (permiso bloqueado,
      // GPS lento), el botón se libera y el usuario recibe un mensaje.
      let pendiente = true;
      const liberar = () => {
        if (!pendiente) return;
        pendiente = false;
        if (btnGeo) btnGeo.removeAttribute("aria-busy");
      };
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          liberar();
          if (msgGeo) msgGeo.hidden = true;
          if (btnGeo) btnGeo.textContent = "Actualizar ubicación";
          ultimaPos = pos;
          try {
            dibujarUsuario(pos);
          } catch (err) {
            console.error("enlace-sismo: error al dibujar la ubicación", err);
          }
        },
        (err) => {
          liberar();
          const msgs: Record<number, string> = {
            [GeolocationPositionError.PERMISSION_DENIED]:
              "Permiso denegado: sin tu ubicación no podemos medir distancias.",
            [GeolocationPositionError.POSITION_UNAVAILABLE]:
              "No pudimos obtener tu ubicación. Intenta de nuevo.",
            [GeolocationPositionError.TIMEOUT]:
              "Tardamos demasiado en obtener tu ubicación. Intenta de nuevo.",
          };
          mensajeGeo(msgs[err.code] ?? "Error al obtener tu ubicación.");
        },
        // Precisión baja: fija rápida por red/Wi-Fi, suficiente para distancias
        // a nivel de ciudad. La alta precisión (GPS) puede no responder en equipos sin GPS.
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
      );
      setTimeout(() => {
        if (pendiente) {
          liberar();
          mensajeGeo("No pudimos obtener tu ubicación. Revisa los permisos de ubicación del navegador.");
        }
      }, 12000);
    }

    btnGeo?.addEventListener("click", geolocalizar);
    map.on("zoomend", () => {
      if (ultimaPos) actualizarPrecision(ultimaPos.coords.accuracy);
    });

    // Pausa del anillo cuando el mapa no es visible (batería)
    const obsOnda = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!cargado) return;
        if (en.isIntersecting) arrancarOnda();
        else detenerOnda();
      });
    });
    obsOnda.observe(el);

    map.on("load", () => {
      cargado = true;
      activarMapa();
      // El contenedor pasa de display:none a visible: MapLibre debe
      // re-medir el canvas o quedaría en blanco (bug clásico).
      requestAnimationFrame(() => requestAnimationFrame(() => map.resize()));

      if (map.getSource("puntos")) return;

      // Anillo expansivo bajo los círculos de zonas
      if (epicentro) {
        map.addSource("epicentro-onda", {
          type: "geojson",
          data: featureOnda(4, 0) ?? { type: "FeatureCollection", features: [] },
        });
        map.addLayer({
          id: "epicentro-onda",
          type: "circle",
          source: "epicentro-onda",
          paint: {
            "circle-radius": ["get", "r"],
            "circle-color": COLORS.salud,
            "circle-opacity": ["get", "o"],
            "circle-stroke-width": 0,
          },
        });
      }

      map.addSource("puntos", { type: "geojson", data: featureCollection(puntos) });
      map.addSource("zonas", { type: "geojson", data: featureCollectionZonas(zonas) });

      // Zonas (epicentro + ciudades) bajo los puntos de datos
      map.addLayer({
        id: "zonas-circulo",
        type: "circle",
        source: "zonas",
        paint: {
          "circle-radius": ["get", "radio"],
          "circle-color": ["get", "color"],
          "circle-stroke-width": ["match", ["get", "tipo"], "epicentro", 3, "ciudad", 2, 2],
          "circle-stroke-color": PAPER,
        },
      });

      map.addLayer({
        id: "zonas-texto",
        type: "symbol",
        source: "zonas",
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": ["match", ["get", "tipo"], "epicentro", 12, "ciudad", 11, 11],
          "text-offset": [0, 1.6],
          "text-anchor": "top",
          "text-max-width": 9,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      // Ciudades reportadas: marcador neutral agrupado (familia de zonas,
      // chip "Zonas"). Sin intensidad: nunca se estima Mercalli sin fuente.
      map.addSource("ciudades-reportadas", {
        type: "geojson",
        data: featureCollectionCiudades(ciudadesReportadasMap),
      });
      map.addLayer({
        id: "ciudades-reportadas-circulo",
        type: "circle",
        source: "ciudades-reportadas",
        paint: {
          "circle-radius": 8,
          "circle-color": ["get", "color"],
          "circle-stroke-width": 2.5,
          "circle-stroke-color": PAPER,
        },
      });
      map.addLayer({
        id: "ciudades-reportadas-texto",
        type: "symbol",
        source: "ciudades-reportadas",
        minzoom: 7,
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": 10,
          "text-offset": [0, 1.6],
          "text-anchor": "top",
          "text-max-width": 10,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      map.addLayer({
        id: "puntos-circulo",
        type: "circle",
        source: "puntos",
        paint: {
          "circle-radius": 10,
          "circle-color": ["get", "color"],
          "circle-stroke-width": 2.5,
          "circle-stroke-color": PAPER,
        },
      });

      // Centro blanco: distingue los puntos de datos de los círculos de zona
      map.addLayer({
        id: "puntos-interior",
        type: "circle",
        source: "puntos",
        paint: {
          "circle-radius": 4,
          "circle-color": PAPER,
        },
      });

      map.addLayer({
        id: "puntos-texto",
        type: "symbol",
        source: "puntos",
        minzoom: 7,
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": 10,
          "text-offset": [0, 1.4],
          "text-anchor": "top",
          "text-max-width": 9,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      // Puntos de rescate (reportes ciudadanos en vivo + verificados)
      map.addSource("rescates", { type: "geojson", data: featureCollectionRescates(rescates) });
      map.addLayer({
        id: "rescates-circulo",
        type: "circle",
        source: "rescates",
        paint: {
          "circle-radius": 9,
          "circle-color": ["get", "color"],
          "circle-stroke-width": 2.5,
          "circle-stroke-color": PAPER,
        },
      });
      map.addLayer({
        id: "rescates-texto",
        type: "symbol",
        source: "rescates",
        minzoom: 10,
        layout: {
          "text-field": ["get", "nombre"],
          "text-size": 9,
          "text-offset": [0, 1.4],
          "text-anchor": "top",
          "text-max-width": 12,
        },
        paint: {
          "text-color": INK,
          "text-halo-color": PAPER,
          "text-halo-width": 1.5,
        },
      });

      // Ubicación del usuario (rellenada por "Cerca de mí")
      map.addSource("usuario", { type: "geojson", data: { type: "FeatureCollection", features: [] } });
      map.addLayer({
        id: "usuario-preciso",
        type: "circle",
        source: "usuario",
        paint: {
          "circle-radius": 8,
          "circle-color": COLORS.geo,
          "circle-opacity": 0.15,
        },
      });
      map.addLayer({
        id: "usuario-marcador",
        type: "circle",
        source: "usuario",
        paint: {
          "circle-radius": 7,
          "circle-color": COLORS.geo,
          "circle-stroke-width": 2.5,
          "circle-stroke-color": PAPER,
        },
      });

      map.on("click", "puntos-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const p = f.properties as unknown as Punto;
        const coords = (f.geometry as { type: "Point"; coordinates: [number, number] }).coordinates;
        window.dispatchEvent(new CustomEvent("enlace:mapa:punto-click"));
        popupActivo?.remove();
        popupActivo = new maplibre.Popup({ offset: 16 })
          .setLngLat(coords)
          .setHTML(
            `<div class="popup popup-punto">` +
              `<strong class="popup-titulo">${escapar(p.nombre)}</strong>` +
              `<p class="popup-meta"><span class="popup-badge popup-badge-${p.tipo}">${escapar(ESTADOS[p.estado] ?? p.estado)}</span> ${escapar(p.ciudad)}</p>` +
              `<p class="popup-linea">${escapar(p.direccion)}</p>` +
              `${p.detalle ? `<p class="popup-linea">${escapar(p.detalle)}</p>` : ""}` +
              `<p class="popup-fuente">Fuente: <a href="${escapar(p.fuente)}" target="_blank" rel="noopener">ver fuente</a> · ` +
              `<a href="https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}" target="_blank" rel="noopener">Cómo llegar</a></p>` +
              `</div>`
          )
          .addTo(map);
        centrarEnPopup(coords);
      });

      map.on("mouseenter", "puntos-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "puntos-circulo", () => {
        map.getCanvas().style.cursor = "";
      });

      // Popup de puntos de rescate: tipo, necesidades, contacto, estado
      map.on("click", "rescates-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const p = f.properties as unknown as PuntoRescateMap;
        const coords = (f.geometry as { type: "Point"; coordinates: [number, number] }).coordinates;
        abrirPopupRescate(p, coords);
      });

      map.on("mouseenter", "rescates-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "rescates-circulo", () => {
        map.getCanvas().style.cursor = "";
      });

      // Popup de ciudad reportada: lista los puntos ciudadanos de esa ciudad
      map.on("click", "ciudades-reportadas-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const c = f.properties as unknown as CiudadReportadaMap;
        const coords = (f.geometry as { type: "Point"; coordinates: [number, number] }).coordinates;
        window.dispatchEvent(new CustomEvent("enlace:mapa:punto-click"));
        popupActivo?.remove();
        const puntosHtml = c.puntos
          .map((p) => {
            const needs = p.necesidades.length
              ? `<span class="popup-rescate-ns">${p.necesidades
                  .map((n) => `<span>${escapar(etiquetaNecesidad(n))}</span>`)
                  .join("")}</span>`
              : "";
            return (
              `<div class="popup-linea"><strong>${escapar(p.etiqueta)}</strong> · ${p.confirmaciones} conf. · ${escapar(ESTADOS_PUNTO[p.estado] ?? p.estado)}</div>` +
              needs +
              `<p class="popup-fuente"><a href="https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lng}" target="_blank" rel="noopener">Cómo llegar</a></p>`
            );
          })
          .join("");
        popupActivo = new maplibre.Popup({ offset: 16 })
          .setLngLat(coords)
          .setHTML(
            `<div class="popup popup-punto">` +
              `<strong class="popup-titulo">${escapar(c.nombre)}</strong>` +
              `<p class="popup-meta">Sin reporte de intensidad · ${c.puntos.length} punto${c.puntos.length === 1 ? "" : "s"} ciudadano${c.puntos.length === 1 ? "" : "s"}</p>` +
              puntosHtml +
              `</div>`
          )
          .addTo(map);
        centrarEnPopup(coords);
      });

      map.on("mouseenter", "ciudades-reportadas-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "ciudades-reportadas-circulo", () => {
        map.getCanvas().style.cursor = "";
      });

      // Popup y cursor para zonas (sincroniza la lista)
      map.on("click", "zonas-circulo", (e) => {
        const f = e.features?.[0];
        if (!f) return;
        window.dispatchEvent(new CustomEvent("enlace:mapa:punto-click"));
        volarAZona(f.properties as unknown as Zona);
      });

      map.on("mouseenter", "zonas-circulo", () => {
        map.getCanvas().style.cursor = "pointer";
      });
      map.on("mouseleave", "zonas-circulo", () => {
        map.getCanvas().style.cursor = "";
      });

      arrancarOnda();

      // Deep-link: /?ciudad=<id>#mapa → vuelo + popup
      const ciudadParam = new URLSearchParams(location.search).get("ciudad");
      if (ciudadParam) {
        const z = zonas.find((x) => x.id === ciudadParam);
        if (z) volarAZona(z);
      }
    });

    // Fila de la lista → vuelo + popup; la zona activa filtra los puntos
    // de su ciudad (sin volver a volar: la fila ya lo hizo).
    window.addEventListener(
      "enlace:mapa:volar-zona",
      ((e: CustomEvent<{ id: string }>) => {
        const z = zonas.find((x) => x.id === e.detail.id);
        if (!z) return;
        volarAZona(z);
        const select = document.querySelector<HTMLSelectElement>(".leyenda-tira select");
        if (!select) return;
        if (z.tipo === "epicentro") {
          // El epicentro es el ancla del territorio: vuelve a mostrar todos los puntos
          select.value = "";
          aplicarFiltros(false);
          return;
        }
        if (Array.from(select.options).some((o) => o.value === z.nombre)) {
          select.value = z.nombre;
          aplicarFiltros(false);
        }
      }) as EventListener
    );

    // Fila del panel Rescates → volar al punto y abrir su popup
    window.addEventListener(
      "enlace:mapa:volar-rescate",
      ((e: CustomEvent<{ id: string }>) => {
        const p = rescates.find((x) => x.id === e.detail?.id);
        if (!p) return;
        const coords: [number, number] = [p.lng, p.lat];
        abrirPopupRescate(p, coords);
        if (!esMovilMapa()) {
          map.flyTo({ center: coords, zoom: 13, offset: offsetCentro(), essential: true });
        } else {
          map.flyTo({ center: coords, zoom: 13, essential: true });
          map.once("moveend", () => centrarEnPopup(coords));
        }
      }) as EventListener
    );

    // Marca "Enlace Sismo" en la portada: cerrar popup y volver a la vista inicial
    window.addEventListener("enlace:mapa:reiniciar", () => {
      popupActivo?.remove();
      popupActivo = null;
      map.flyTo({ center: [-75.6, 4.4], zoom: 6, essential: true });
    });

    map.on("styleerror", () => {
      // El proveedor principal falló: reintenta con OSM raster. Si ese
      // también falla, el contenido base (lista) queda como respaldo.
      if (cargado) return;
      if (!estiloAlternativo) {
        estiloAlternativo = true;
        map.setStyle(ESTILO_OSM);
      } else {
        fallido = true;
      }
    });

    map.on("error", () => {
      // Errores de tiles o de render: si el estilo ya cargó, el mapa sigue
      // funcionando; el timeout de 8 s cubre el caso de carga lenta.
    });

    setTimeout(() => {
      if (!cargado) fallido = true;
    }, 8000);

    document.querySelectorAll<HTMLInputElement>(".leyenda-tira input[type='checkbox']").forEach((input) => {
      input.addEventListener("change", () => aplicarFiltros());
    });
    document.querySelectorAll<HTMLSelectElement>(".leyenda-tira select").forEach((select) => {
      select.addEventListener("change", () => {
        aplicarFiltros();
        // Conexión filtro ↔ zonas: resaltar la fila de la ciudad elegida.
        // Si la ciudad es reportada (sin zona en el catálogo), volar al
        // centroide y resaltar su fila ciudadana.
        const z = zonas.find((x) => x.nombre === select.value);
        if (z) {
          window.dispatchEvent(new CustomEvent("enlace:mapa:zona-activa", { detail: { id: z.id } }));
          return;
        }
        const c = ciudadesReportadasMap.find((x) => x.nombre === select.value);
        if (c) {
          map.flyTo({ center: [c.lng, c.lat], zoom: 10, offset: offsetCentro(), essential: true });
          window.dispatchEvent(
            new CustomEvent("enlace:mapa:ciudad-reportada", { detail: { nombre: c.nombre } })
          );
          return;
        }
        window.dispatchEvent(new CustomEvent("enlace:mapa:zona-activa", { detail: { id: "" } }));
      });
    });

    // Fila ciudadana del rail → volar al centroide + filtrar por esa ciudad
    window.addEventListener(
      "enlace:mapa:ciudad-reportada",
      ((e: CustomEvent<{ nombre: string }>) => {
        const c = ciudadesReportadasMap.find((x) => x.nombre === e.detail?.nombre);
        if (!c) return;
        const select = document.querySelector<HTMLSelectElement>(".leyenda-tira select");
        if (select && Array.from(select.options).some((o) => o.value === c.nombre)) {
          select.value = c.nombre;
          aplicarFiltros(false);
        }
        map.flyTo({ center: [c.lng, c.lat], zoom: 10, offset: offsetCentro(), essential: true });
      }) as EventListener
    );
  }
</script>
