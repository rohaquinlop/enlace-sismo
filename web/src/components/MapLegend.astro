---
import { jornadasSangre } from "../lib/catalogs";

interface Props {
  ciudades: string[];
  mostrarZonas?: boolean;
  mostrarAyuda?: boolean;
  ayudaConteos?: { acopio: number; albergue: number; hospital: number; otro: number };
}

const {
  ciudades,
  mostrarZonas = false,
  mostrarAyuda = false,
  ayudaConteos = { acopio: 0, albergue: 0, hospital: 0, otro: 0 },
} = Astro.props;

// Los catálogos de lugares (acopios/albergues/salud) son entradas del
// registro de ayuda: el chip "Ayuda" los cubre. La capa de catálogos solo
// conserva las jornadas de sangre (cambio catalogos-comunitarios).
const CATEGORIAS = [
  { valor: "sangre", nombre: "Donar sangre", conteo: jornadasSangre.length, clase: "punto-sangre" },
];

const ZONAS = [
  { valor: "zona", etiqueta: "Zonas", clase: "punto-zona" },
  { valor: "epicentro", etiqueta: "Epicentro", clase: "punto-epicentro" },
];
---

<!-- Barra de herramientas del mapa, siempre visible. Una sola instancia en el
     DOM: desktop la posiciona en la base del mapa y móvil sobre la hoja
     inferior (mismo componente, CSS distinto).
     .tira-scroll agrupa filtros (capas + ciudad + conteo): scrollea en una
     línea en móvil, envuelve en desktop. Las acciones (Cómo ayudar, Cerca de
     mí) quedan fijas fuera del scroll. -->
<div class="leyenda-tira" aria-label="Filtros del mapa">
  <div class="tira-scroll">
    <div class="tira-chips" role="group" aria-label="Capas visibles en el mapa">
      {CATEGORIAS.map((c) => (
        <label class="tira-chip">
          <input type="checkbox" value={c.valor} checked />
          <span class:list={["tira-dot", c.clase]} aria-hidden="true"></span>
          <span class="tira-label">
            {c.nombre} (<span data-ayuda-conteo={c.valor}>{c.conteo}</span>)
          </span>
        </label>
      ))}
      {
        mostrarAyuda &&
          [
            { valor: "acopio", nombre: "Acopios", conteo: ayudaConteos.acopio, clase: "punto-acopio" },
            { valor: "albergue", nombre: "Albergues", conteo: ayudaConteos.albergue, clase: "punto-albergue" },
            { valor: "hospital", nombre: "Salud", conteo: ayudaConteos.hospital, clase: "punto-salud" },
            { valor: "otro", nombre: "Otro", conteo: ayudaConteos.otro, clase: "punto-ayuda" },
          ].map((c) => (
            <label class="tira-chip">
              <input type="checkbox" value={c.valor} checked />
              <span class:list={["tira-dot", c.clase]} aria-hidden="true"></span>
              <span class="tira-label">
                {c.nombre} (<span data-ayuda-conteo={c.valor}>{c.conteo}</span>)
              </span>
            </label>
          ))
      }
      {
        mostrarZonas &&
          ZONAS.map((c) => (
            <label class="tira-chip">
              <input type="checkbox" value={c.valor} checked />
              <span class:list={["tira-dot", c.clase]} aria-hidden="true"></span>
              <span class="tira-label">{c.etiqueta}</span>
            </label>
          ))
      }
    </div>
    <span class="tira-sep" aria-hidden="true"></span>
    {
      ciudades.length > 0 && (
        <span class="tira-chip tira-chip-select" title="Filtrar puntos por ciudad">
          <select aria-label="Filtrar por ciudad">
            <option value="">Ciudad: Todas</option>
            {ciudades.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </span>
        <!-- Deseleccionar zona: visible solo con un filtro de ciudad activo -->
        <button type="button" class="tira-chip tira-chip-todas" id="btn-todas-ciudades" hidden>Ver todas</button>
      )
    }
    <!-- Cada chip lleva su conteo ("Donar sangre (N)", "Ayuda (N)"); el
         contador global se eliminó en el audit (duplicaba los chips). -->
  </div>
  {
    mostrarZonas && (
      <a class="tira-chip-ayuda" href="/ayuda">
        Cómo ayudar
      </a>
    )
  }
  {
    mostrarZonas && (
      <button type="button" class="tira-chip-geo" id="btn-cerca-de-mi" aria-label="Cerca de mí: usar mi ubicación">
        <svg class="tira-chip-geo-icono" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none">
          <circle cx="8" cy="8" r="4" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 1.5v2.5M8 12v2.5M1.5 8H4M12 8h2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span class="tira-chip-geo-label">Cerca de mí</span>
      </button>
    )
  }
  <p class="geo-mensaje" id="geo-mensaje" hidden aria-live="polite"></p>
</div>
