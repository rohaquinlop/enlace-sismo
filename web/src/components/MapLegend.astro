---
import { acopios, albergues, centrosSalud, jornadasSangre } from "../lib/catalogs";

interface Props {
  ciudades: string[];
  mostrarZonas?: boolean;
}

const { ciudades, mostrarZonas = false } = Astro.props;

const CATEGORIAS = [
  { valor: "acopio", etiqueta: `Acopios (${acopios.length})`, clase: "punto-acopio" },
  { valor: "albergue", etiqueta: `Albergues (${albergues.length})`, clase: "punto-albergue" },
  { valor: "salud", etiqueta: `Salud (${centrosSalud.length})`, clase: "punto-salud" },
  { valor: "sangre", etiqueta: `Donar sangre (${jornadasSangre.length})`, clase: "punto-sangre" },
];

const ZONAS = [
  { valor: "zona", etiqueta: "Zonas", clase: "punto-zona" },
  { valor: "epicentro", etiqueta: "Epicentro", clase: "punto-epicentro" },
];

const totalPuntos = acopios.length + albergues.length + centrosSalud.length + jornadasSangre.length;
const etiquetaPuntos = totalPuntos === 1 ? "1 punto" : `${totalPuntos} puntos`;
---

<!-- Barra de herramientas del mapa, siempre visible. Una sola instancia en el
     DOM: desktop la posiciona en la base del mapa y móvil sobre la hoja
     inferior (mismo componente, CSS distinto). Grupos separados por regla:
     capas | ciudad + conteo | acción. -->
<div class="leyenda-tira" aria-label="Filtros del mapa">
  <div class="tira-chips" role="group" aria-label="Capas visibles en el mapa">
    {CATEGORIAS.map((c) => (
      <label class="tira-chip">
        <input type="checkbox" value={c.valor} checked />
        <span class:list={["tira-dot", c.clase]} aria-hidden="true"></span>
        <span class="tira-label">{c.etiqueta}</span>
      </label>
    ))}
    {
      mostrarZonas &&
        ZONAS.map((c) => (
          <label class="tira-chip">
            <input type="checkbox" value={c.valor} checked />
            <span class:list={["tira-dot", c.clase]} aria-hidden="true"></span>
            <span class="tira-label">{c.etiqueta}</span>
          </label>
        ))
    }
  </div>
  <span class="tira-sep" aria-hidden="true"></span>
  {
    ciudades.length > 0 && (
      <span class="tira-chip tira-chip-select" title="Filtrar puntos por ciudad">
        <select aria-label="Filtrar por ciudad">
          <option value="">Ciudad: Todas</option>
          {ciudades.map((c) => (
            <option value={c}>{c}</option>
          ))}
        </select>
      </span>
    )
  }
  <!-- Actualizado por el script del mapa al filtrar; en el fallback sin mapa
       muestra el total del build -->
  <span class="tira-conteo" id="puntos-conteo">{etiquetaPuntos}</span>
  {
    mostrarZonas && (
      <a class="tira-chip-ayuda" href="/ayuda">
        Cómo ayudar
      </a>
    )
  }
  {
    mostrarZonas && (
      <button type="button" class="tira-chip-geo" id="btn-cerca-de-mi">
        Cerca de mí
      </button>
    )
  }
  <p class="geo-mensaje" id="geo-mensaje" hidden aria-live="polite"></p>
</div>
