---
import evento from "../../../data/evento.json";

const lectura = {
  linea1: `Sismo M${evento.magnitud} · Epicentro ${evento.epicentro}`,
  linea2: `Profundidad ${evento.profundidad_km} km · Sentido en ${evento.ciudades_sentido.length} ciudades`,
  linea3: `Réplicas ${evento.replicas}`,
};
---

<!-- Barra de estado del evento — lectura de instrumento, el único momento
     oscuro por página (design.md). En flujo es tarjeta; con mapa, barra superior.
     La leyenda de verificación (oficial/confirmado/sin-confirmar) vive en el
     pie del rail, no aquí: la barra lee el evento, el rail explica el dato. -->
<div class="barra-evento">
  <div class="barra-fila-1">
    <span class="status-chip">Confirmado · SGC</span>
    <!-- ids: el script del dashboard refresca la lectura con el evento fresco
         del API (/api/datos/evento) sin tocar el resto de la barra -->
    <h2 id="barra-linea1">{lectura.linea1}</h2>
  </div>
  <div class="barra-fila-2">
    <p class="graphite-line" id="barra-linea2">{lectura.linea2}</p>
    <p class="graphite-line" id="barra-linea3">{lectura.linea3}</p>
    <!-- Llenada por el script del mapa tras "Cerca de mí" (geolocalización) -->
    <p class="graphite-line" id="dist-epicentro" hidden></p>
    <span class="barra-fuente" id="barra-fuente">
      Fuente: <a id="barra-fuente-enlace" href={evento.fuente_url} target="_blank" rel="noopener">{evento.fuente}</a> ·{" "}
      <span id="barra-fuente-fecha">{evento.fecha.slice(0, 10)}</span>
    </span>
    <a
      class="barra-reporte"
      href="https://github.com/rohaquinlop/enlace-sismo/issues"
      target="_blank"
      rel="noopener"
      aria-label="¿Ves un dato incorrecto? Repórtalo en GitHub"
    >
      Repórtalo
    </a>
  </div>
</div>
