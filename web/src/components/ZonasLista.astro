---
import type { Zona } from "../lib/zonas";
import type { CiudadReportada } from "../lib/ciudades";
import evento from "../../../data/evento.json";
import { haversineKm, formatearDistancia } from "../lib/geo";

interface Props {
  zonas: Zona[];
  ciudadesReportadas?: CiudadReportada[];
}

const { zonas, ciudadesReportadas = [] } = Astro.props;

const ROMANOS = ["", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const epicentro = zonas.find((z) => z.tipo === "epicentro");
const fecha = evento.fecha.slice(0, 10);
const filas = zonas.map((z) => ({
  z,
  km: epicentro && z.id !== epicentro.id ? haversineKm(z.lat, z.lng, epicentro.lat, epicentro.lng) : 0,
}));

// Dot con el color Mercalli real de la zona; sin intensidad → neutral.
// El epicentro conserva su marca propia.
const claseDot = (z: Zona) =>
  z.tipo === "epicentro" ? "zona-dot-epicentro" : z.intensidad ? `mercalli-${z.intensidad}` : "zona-dot-ciudad";

// Meta compacta: numeral Mercalli (o "Sin reporte") + distancia al epicentro.
const metaFila = (z: Zona, km: number) => {
  const intensidad = z.intensidad ? ROMANOS[z.intensidad] : "Sin reporte";
  return km > 0 ? `${intensidad} · a ${formatearDistancia(km)} del epicentro` : intensidad;
};
---

<div class="dash-index zonas-overlay">
  <div class="zonas-header">
    <div class="zonas-titulo">
      <h3>Zonas</h3>
      <span class="zonas-count" aria-label={`${filas.length} zonas`}>{filas.length}</span>
    </div>
    <!-- Escala etiquetada: los dots solo tienen sentido con su clave visible -->
    <div class="zonas-escala" aria-label="Escala de intensidad Mercalli, de I a XII">
      <span class="zonas-escala-label">Mercalli I–XII</span>
      <span class="mercalli-ref">
        {ROMANOS.slice(1).map((r, i) => (
          <span class:list={["punto", `mercalli-${i + 1}`]} title={`Intensidad ${r}`} aria-hidden="true"></span>
        ))}
        <span class="punto punto-zona" title="Sin reporte de intensidad" aria-hidden="true"></span>
      </span>
    </div>
  </div>
  {
    filas.map(({ z, km }) => (
      <button
        type="button"
        class="dash-row zona-fila"
        data-zona-id={z.id}
        data-tipo={z.tipo}
        aria-pressed="false"
        title={z.intensidad ? `Intensidad Mercalli ${ROMANOS[z.intensidad]}` : "Sin reporte de intensidad"}
      >
        <span class="zona-fila-top">
          <span class:list={["zona-dot", claseDot(z)]} aria-hidden="true"></span>
          <span class="zona-fila-nombre">{z.nombre}</span>
          <span class="dash-row-chevron" aria-hidden="true">›</span>
        </span>
        <span class="zona-fila-meta">{metaFila(z, km)}</span>
        <span class="zona-fila-linea">{z.detalle ?? "Sismo sentido"} · {fecha} · SGC</span>
        <span class="dist-usuario" hidden></span>
      </button>
    ))
  }
  {
    ciudadesReportadas.length > 0 && (
      <div class="zonas-ciudadanas" id="zonas-ciudadanas">
        <div class="zonas-ciudadanas-head">
          <span class="zonas-ciudadanas-label">Ciudades con reportes ciudadanos</span>
          <span class="zonas-count" aria-label={`${ciudadesReportadas.length} ciudades reportadas`}>{ciudadesReportadas.length}</span>
        </div>
        {
          ciudadesReportadas.map((c) => (
            <button
              type="button"
              class="dash-row zona-fila zona-fila-ciudadana"
              data-ciudad-nombre={c.nombre}
              aria-pressed="false"
              title="Ciudad reportada por ciudadanos — sin intensidad hasta verificación oficial"
            >
              <span class="zona-fila-top">
                <span class="zona-dot zona-dot-ciudad" aria-hidden="true"></span>
                <span class="zona-fila-nombre">{c.nombre}</span>
                <span class="dash-row-chevron" aria-hidden="true">›</span>
              </span>
              <span class="zona-fila-meta">{c.puntos.length} punto{c.puntos.length === 1 ? "" : "s"} · sin confirmar</span>
              <span class="zona-fila-linea">Reportada por ciudadanos · sin intensidad (falta fuente oficial)</span>
            </button>
          ))
        }
      </div>
    )
  }
</div>

<script>
  import { formatearDistancia } from "../lib/geo";

  // Las filas ciudadanas reusan el estilo zona-fila pero NO participan del
  // flujo de zonas (volar/resaltar/ordenar por distancia): se excluyen aquí.
  // Re-query en cada uso: el dashboard re-renderiza el panel con datos frescos
  // del API (desacoplar-datos-deploy) y los listeners sobreviven por delegación.
  function filasZona(): HTMLButtonElement[] {
    return Array.from(document.querySelectorAll<HTMLButtonElement>(".zona-fila")).filter(
      (f) => !f.classList.contains("zona-fila-ciudadana")
    );
  }
  // El contenedor de delegación es el SLOT del dashboard (#zonas-slot), que
  // el refresco runtime NUNCA reemplaza (solo su innerHTML). Anclarse al
  // .zonas-overlay original rompe los clics tras el primer re-render.
  const contenedorZonas = (document.getElementById("zonas-slot") ?? document.querySelector(".zonas-overlay")) as HTMLElement | null;

  function resaltar(id: string) {
    filasZona().forEach((f) => {
      const activa = f.dataset.zonaId === id;
      f.classList.toggle("zona-activa", activa);
      f.setAttribute("aria-pressed", String(activa));
    });
  }

  function resaltarCiudadana(nombre: string) {
    document.querySelectorAll<HTMLButtonElement>(".zona-fila-ciudadana").forEach((f) => {
      const activa = f.dataset.ciudadNombre === nombre;
      f.classList.toggle("zona-activa", activa);
      f.setAttribute("aria-pressed", String(activa));
      if (activa) f.scrollIntoView({ block: "nearest" });
    });
  }

  // Fila → el mapa vuela a la zona y abre su popup. Delegación en el contenedor:
  // las filas re-renderizadas por el refresco runtime conservan el listener.
  contenedorZonas?.addEventListener("click", (e) => {
    const fila = (e.target as HTMLElement).closest<HTMLButtonElement>(".zona-fila");
    if (!fila || fila.classList.contains("zona-fila-ciudadana")) return;
    window.dispatchEvent(new CustomEvent("enlace:mapa:volar-zona", { detail: { id: fila.dataset.zonaId } }));
  });

  // Fila ciudadana → el mapa vuela al centroide y filtra por esa ciudad
  // (delegación: la sección se refresca en runtime sin perder el listener)
  contenedorZonas?.addEventListener("click", (e) => {
    const fila = (e.target as HTMLElement).closest<HTMLButtonElement>(".zona-fila-ciudadana");
    const nombre = fila?.dataset.ciudadNombre;
    if (!nombre) return;
    window.dispatchEvent(new CustomEvent("enlace:mapa:ciudad-reportada", { detail: { nombre } }));
  });

  // Popup abierto en el mapa → fila resaltada
  window.addEventListener(
    "enlace:mapa:zona-activa",
    ((e: CustomEvent<{ id: string }>) => {
      resaltar(e.detail.id);
      filasZona().find((f) => f.dataset.zonaId === e.detail.id)?.scrollIntoView({ block: "nearest" });
    }) as EventListener
  );

  // Ciudad seleccionada en el mapa/select → fila ciudadana resaltada
  window.addEventListener(
    "enlace:mapa:ciudad-reportada",
    ((e: CustomEvent<{ nombre: string }>) => {
      if (e.detail?.nombre) resaltarCiudadana(e.detail.nombre);
    }) as EventListener
  );

  // Marca "Enlace Sismo": limpiar resaltado al reiniciar la vista del mapa
  window.addEventListener("enlace:mapa:reiniciar", () => {
    resaltar("");
    resaltarCiudadana("");
  });

  // Filtro por las casillas de la tira de leyenda (zonas / epicentro)
  function aplicarFiltroLista() {
    const visibles = new Set(
      Array.from(document.querySelectorAll<HTMLInputElement>(".leyenda-tira input[type='checkbox']:checked")).map(
        (i) => i.value
      )
    );
    filasZona().forEach((f) => {
      const tipo = f.dataset.tipo;
      f.hidden = tipo === "epicentro" ? !visibles.has("epicentro") : !visibles.has("zona");
    });
    document.querySelectorAll<HTMLButtonElement>(".zona-fila-ciudadana").forEach((f) => {
      f.hidden = !visibles.has("zona");
    });
  }
  document.querySelectorAll<HTMLInputElement>(".leyenda-tira input[type='checkbox']").forEach((i) => {
    i.addEventListener("change", aplicarFiltroLista);
  });
  aplicarFiltroLista();

  // Cerca de mí: ordenar por distancia al usuario y resaltar la más cercana
  window.addEventListener(
    "enlace:mapa:posicion",
    ((e: CustomEvent<{ distancias: { id: string; km: number }[] }>) => {
      try {
        const filas = filasZona();
        const porKm = new Map(e.detail.distancias.map((d) => [d.id, d.km]));
        const orden = [...filas].sort(
          (a, b) => (porKm.get(a.dataset.zonaId ?? "") ?? 0) - (porKm.get(b.dataset.zonaId ?? "") ?? 0)
        );
        orden.forEach((f, i) => {
          const km = porKm.get(f.dataset.zonaId ?? "");
          const p = f.querySelector<HTMLElement>(".dist-usuario");
          if (p && km != null) {
            p.hidden = false;
            p.textContent = `A ${formatearDistancia(km)} de ti`;
          }
          f.classList.toggle("zona-cercana", i === 0);
        });
        const contenedor = document.querySelector(".zonas-overlay");
        // Insertar antes de la sección de ciudades reportadas: al reordenar,
        // las zonas no deben saltar debajo de ella.
        const seccionCiudades = document.getElementById("zonas-ciudadanas");
        orden.forEach((f) => contenedor?.insertBefore(f, seccionCiudades ?? null));      } catch (err) {
        console.error("enlace-sismo: error al ordenar zonas", err);
      }
    }) as EventListener
  );

  // El dashboard re-renderizó el panel con datos frescos: re-aplicar el filtro
  // de las casillas y limpiar resaltados (los clicks ya son por delegación).
  window.addEventListener("enlace:zonas:re-render", () => {
    aplicarFiltroLista();
    resaltar("");
    resaltarCiudadana("");
  });
</script>
