---
import type { Zona } from "../lib/zonas";
import evento from "../../../data/evento.json";
import { haversineKm, formatearDistancia } from "../lib/geo";

interface Props {
  zonas: Zona[];
}

const { zonas } = Astro.props;

const ROMANOS = ["", "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"];
const epicentro = zonas.find((z) => z.tipo === "epicentro");
const fecha = evento.fecha.slice(0, 10);
const filas = zonas.map((z) => ({
  z,
  km: epicentro && z.id !== epicentro.id ? haversineKm(z.lat, z.lng, epicentro.lat, epicentro.lng) : 0,
}));

// Dot con el color Mercalli real de la zona; sin intensidad → neutral.
// El epicentro conserva su marca propia.
const claseDot = (z: Zona) =>
  z.tipo === "epicentro" ? "zona-dot-epicentro" : z.intensidad ? `mercalli-${z.intensidad}` : "zona-dot-ciudad";

// Meta compacta: numeral Mercalli (o "Sin reporte") + distancia al epicentro.
const metaFila = (z: Zona, km: number) => {
  const intensidad = z.intensidad ? ROMANOS[z.intensidad] : "Sin reporte";
  return km > 0 ? `${intensidad} · a ${formatearDistancia(km)} del epicentro` : intensidad;
};
---

<div class="dash-index zonas-overlay">
  <div class="zonas-header">
    <h3>Zonas afectadas</h3>
    <div class="zonas-header-derecha">
      <span class="zonas-count" aria-label={`${filas.length} zonas afectadas`}>{filas.length}</span>
      <div class="mercalli-ref" aria-label="Escala de intensidad Mercalli, de I a XII">
        {ROMANOS.slice(1).map((r, i) => (
          <span class:list={["punto", `mercalli-${i + 1}`]} title={`Intensidad ${r}`} aria-hidden="true"></span>
        ))}
        <span class="punto punto-zona" title="Sin reporte de intensidad" aria-hidden="true"></span>
      </div>
    </div>
  </div>
  {
    filas.map(({ z, km }) => (
      <button
        type="button"
        class="dash-row zona-fila"
        data-zona-id={z.id}
        data-tipo={z.tipo}
        aria-pressed="false"
        title={z.intensidad ? `Intensidad Mercalli ${ROMANOS[z.intensidad]}` : "Sin reporte de intensidad"}
      >
        <span class="zona-fila-top">
          <span class:list={["zona-dot", claseDot(z)]} aria-hidden="true"></span>
          <span class="zona-fila-nombre">{z.nombre}</span>
          <span class="zona-fila-meta">{metaFila(z, km)}</span>
          <span class="dash-row-chevron" aria-hidden="true">›</span>
        </span>
        <span class="zona-fila-linea">{z.detalle ?? "Sismo sentido"} · {fecha} · SGC</span>
        <span class="dist-usuario" hidden></span>
      </button>
    ))
  }
</div>

<script>
  import { formatearDistancia } from "../lib/geo";

  const filas = Array.from(document.querySelectorAll<HTMLButtonElement>(".zona-fila"));

  function resaltar(id: string) {
    filas.forEach((f) => {
      const activa = f.dataset.zonaId === id;
      f.classList.toggle("zona-activa", activa);
      f.setAttribute("aria-pressed", String(activa));
    });
  }

  // Fila → el mapa vuela a la zona y abre su popup
  filas.forEach((f) => {
    f.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("enlace:mapa:volar-zona", { detail: { id: f.dataset.zonaId } }));
    });
  });

  // Popup abierto en el mapa → fila resaltada
  window.addEventListener(
    "enlace:mapa:zona-activa",
    ((e: CustomEvent<{ id: string }>) => {
      resaltar(e.detail.id);
      filas.find((f) => f.dataset.zonaId === e.detail.id)?.scrollIntoView({ block: "nearest" });
    }) as EventListener
  );

  // Marca "Enlace Sismo": limpiar resaltado al reiniciar la vista del mapa
  window.addEventListener("enlace:mapa:reiniciar", () => resaltar(""));

  // Filtro por las casillas de la tira de leyenda (zonas / epicentro)
  function aplicarFiltroLista() {
    const visibles = new Set(
      Array.from(document.querySelectorAll<HTMLInputElement>(".leyenda-tira input[type='checkbox']:checked")).map(
        (i) => i.value
      )
    );
    filas.forEach((f) => {
      const tipo = f.dataset.tipo;
      f.hidden = tipo === "epicentro" ? !visibles.has("epicentro") : !visibles.has("zona");
    });
  }
  document.querySelectorAll<HTMLInputElement>(".leyenda-tira input[type='checkbox']").forEach((i) => {
    i.addEventListener("change", aplicarFiltroLista);
  });
  aplicarFiltroLista();

  // Cerca de mí: ordenar por distancia al usuario y resaltar la más cercana
  window.addEventListener(
    "enlace:mapa:posicion",
    ((e: CustomEvent<{ distancias: { id: string; km: number }[] }>) => {
      try {
        const porKm = new Map(e.detail.distancias.map((d) => [d.id, d.km]));
        const orden = [...filas].sort(
          (a, b) => (porKm.get(a.dataset.zonaId ?? "") ?? 0) - (porKm.get(b.dataset.zonaId ?? "") ?? 0)
        );
        orden.forEach((f, i) => {
          const km = porKm.get(f.dataset.zonaId ?? "");
          const p = f.querySelector<HTMLElement>(".dist-usuario");
          if (p && km != null) {
            p.hidden = false;
            p.textContent = `A ${formatearDistancia(km)} de ti`;
          }
          f.classList.toggle("zona-cercana", i === 0);
        });
        const contenedor = document.querySelector(".zonas-overlay");
        orden.forEach((f) => contenedor?.appendChild(f));
      } catch (err) {
        console.error("enlace-sismo: error al ordenar zonas", err);
      }
    }) as EventListener
  );
</script>
