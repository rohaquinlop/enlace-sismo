---
import { acopios, albergues, centrosSalud } from "../lib/catalogs";

const GITHUB = "https://github.com/rohaquinlop/enlace-sismo";

const SECCIONES = [
  { href: "/#mapa", titulo: "Mapa", descripcion: "Zonas afectadas, epicentro y puntos sobre el territorio.", meta: "geo" },
  { href: "/acopios", titulo: "Puntos de acopio", descripcion: "Dónde entregar alimentos, ropa, agua y medicamentos.", meta: `${acopios.length} verificados` },
  { href: "/albergues", titulo: "Albergues", descripcion: "Refugios habilitados, con capacidad y estado.", meta: `${albergues.length} verificados` },
  { href: "/salud", titulo: "Centros de salud", descripcion: "Hospitales, clínicas y primeros auxilios operativos.", meta: `${centrosSalud.length} verificados` },
  { href: "/desaparecidos", titulo: "Personas desaparecidas", descripcion: "Reportes de personas desaparecidas en ColombiaTeBusca, el registro ciudadano de referencia.", meta: "referencia" },
  { href: "/ayuda", titulo: "Cómo ayudar", descripcion: "Canales oficiales de donación y voluntariado.", meta: "verificado" },
  { href: "/alertas", titulo: "Alertas oficiales", descripcion: "Boletines de SGC, UNGRD y alcaldías.", meta: "en vivo" },
  { href: "/contactos", titulo: "Contactos de emergencia", descripcion: "123, Bomberos, Cruz Roja, Defensa Civil, UNGRD.", meta: "oficial" },
];
---

<div class="dash-index">
  <h3>Secciones</h3>
  {
    SECCIONES.map((s) => (
      <a class="dash-row" href={s.href}>
        <span class="dash-row-top">
          <span class="dash-row-nombre">{s.titulo}</span>
          <span class="dash-row-meta">{s.meta}</span>
        </span>
        <p>{s.descripcion}</p>
      </a>
    ))
  }
  <div class="dash-colabora">
    <h3>Colabora</h3>
    <a href={GITHUB} target="_blank" rel="noopener">Código</a>
    <a href={`${GITHUB}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">Guía</a>
    <a href={`${GITHUB}/issues`} target="_blank" rel="noopener">Reportar error</a>
  </div>
</div>
