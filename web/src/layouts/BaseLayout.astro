---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const GITHUB = "https://github.com/rohaquinlop/enlace-sismo";

const SECCIONES = [
  { href: "/#mapa", label: "Mapa", descripcion: "Zonas afectadas, epicentro y puntos sobre el territorio." },
  { href: "/acopios", label: "Puntos de acopio", descripcion: "Dónde entregar alimentos, ropa, agua y medicamentos." },
  { href: "/albergues", label: "Albergues", descripcion: "Refugios habilitados para damnificados." },
  { href: "/salud", label: "Centros de salud", descripcion: "Hospitales, clínicas y primeros auxilios." },
  { href: "/desaparecidos", label: "Desaparecidos", descripcion: "Reportes de personas desaparecidas en ColombiaTeBusca." },
  { href: "/reportar", label: "Reportar punto", descripcion: "Reporta un punto de rescate con ubicación exacta." },
  { href: "/ayuda", label: "Cómo ayudar", descripcion: "Canales oficiales de donación y voluntariado." },
  { href: "/contactos", label: "Contactos", descripcion: "Líneas de emergencia oficiales." },
];

// La paleta enlaza ciudades al mapa de la portada con deep-link: /?ciudad=<id>#mapa
const slugCiudad = (c: string) =>
  c
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\s+/g, "-");
const CIUDADES = [
  "Bogotá", "Cali", "Medellín", "Pereira", "Manizales", "Armenia", "Chocó", "Valle del Cauca",
].map((c) => ({ label: c, href: `/?ciudad=${slugCiudad(c)}#mapa` }));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="sismo colombia, terremoto, ayuda, acopios, albergues, desaparecidos, San José del Palmar, Chocó"
    />
    <link rel="canonical" href={`https://enlacesismo.com${Astro.url.pathname}`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta name="theme-color" content="#f8f9fb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://enlacesismo.com${Astro.url.pathname}`} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Service worker solo en producción. En dev (Vite) los estilos se sirven
         por URLs estables con contenido mutable: un SW cache-first los
         congelaría y cada recarga mezclaría CSS viejo con HTML nuevo.
         En dev, además, se libera cualquier SW previo que haya quedado. -->
    <script>
      if ("serviceWorker" in navigator) {
        if (import.meta.env.PROD) {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        } else {
          navigator.serviceWorker.getRegistrations().then((rs) => rs.forEach((r) => r.unregister()));
        }
      }
    </script>
  </head>
  <body>
    <header class="site-nav">
      <a class="brand" href="/">
        <span class="brand-dot" aria-hidden="true"></span>
        Enlace Sismo
      </a>
      <nav class="nav-secciones" aria-label="Secciones">
        {SECCIONES.map((s) => (
          <a href={s.href} class:list={{ active: Astro.url.pathname === new URL(s.href, Astro.url).pathname }}>
            {s.label}
          </a>
        ))}
      </nav>
      <div class="nav-actions">
        <button class="nav-hamburguesa" id="nav-hamburguesa" aria-label="Abrir menú" aria-expanded="false">
          <span class="hamburguesa-linea"></span>
          <span class="hamburguesa-linea"></span>
          <span class="hamburguesa-linea"></span>
        </button>
      </div>
      <a class="btn btn-primary" href="https://colombiatebusca.com" target="_blank" rel="noopener noreferrer">
        <span class="btn-cta-full">Buscar o reportar desaparecidos</span>
        <span class="btn-cta-movil" aria-hidden="true">Desaparecidos</span>
      </a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="foot-line">
        <strong>ENLACE SISMO</strong>
        <span class="foot-sep">·</span>
        <span>datos verificados contra fuente</span>
        <span class="foot-sep">·</span>
        <span>SGC · UNGRD · Cruz Roja</span>
        <span class="foot-sep">·</span>
        <span>emergencia <strong>123</strong></span>
        <span class="foot-sep">·</span>
        <a href={GITHUB} target="_blank" rel="noopener">código (MIT)</a>
        <span class="foot-sep">·</span>
        <a href={`${GITHUB}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">contribuir</a>
      </div>
    </footer>

    <script is:inline define:vars={{ SECCIONES, CIUDADES, GITHUB }}>
      // Marca "Enlace Sismo": en la portada vuelve al mapa y limpia el deep-link
      // sin recargar la página; en otras páginas navega a la portada (comportamiento normal).
      const brand = document.querySelector(".brand");
      brand?.addEventListener("click", (e) => {
        const enPortada = location.pathname.replace(/\/+$/, "") === "";
        if (!enPortada) return;
        e.preventDefault();
        if (location.search) history.replaceState(null, "", "/");
        window.dispatchEvent(new CustomEvent("enlace:mapa:reiniciar"));
        const mapa = document.getElementById("mapa");
        (mapa ?? document.body).scrollIntoView({ behavior: "smooth", block: "start" });
      });

      // Header colapsable por ajuste: la hamburguesa aparece cuando las
      // secciones no caben en una sola fila (.nav-overflow) y despliega el
      // panel en el mismo lugar — en todas las páginas y anchos.
      const btnHamburguesa = document.getElementById("nav-hamburguesa");
      const siteNav = document.querySelector(".site-nav");

      function colapsarNavApp() {
        siteNav?.setAttribute("data-expandido", "false");
        btnHamburguesa?.setAttribute("aria-expanded", "false");
        btnHamburguesa?.setAttribute("aria-label", "Abrir menú");
      }
      function alternarNavApp() {
        const expandido = siteNav?.getAttribute("data-expandido") === "true";
        siteNav?.setAttribute("data-expandido", expandido ? "false" : "true");
        btnHamburguesa?.setAttribute("aria-expanded", String(!expandido));
        btnHamburguesa?.setAttribute("aria-label", expandido ? "Abrir menú" : "Cerrar menú");
      }

      btnHamburguesa?.addEventListener("click", alternarNavApp);
      // Clic en una sección del panel desplegado: colapsar
      siteNav?.addEventListener("click", (e) => {
        if (e.target instanceof Element && e.target.closest("a")) colapsarNavApp();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") colapsarNavApp();
      });

      // Detección de desborde por clonado: se clona la fila de secciones
      // fuera de pantalla y se mide su ancho real. Medir sobre el elemento
      // vivo altera el layout del nav (revelar/ocultar) y provoca saltos
      // de altura, parpadeos y el blur del modo app "mezclándose".
      const navSecciones = document.querySelector(".nav-secciones");
      const brandEl = document.querySelector(".brand");
      const navAcciones = document.querySelector(".nav-actions");
      const navCta = document.querySelector(".site-nav > .btn");
      if (siteNav && navSecciones) {
        function anchoSecciones() {
          const clone = navSecciones.cloneNode(true);
          clone.style.cssText =
            "position:fixed;left:-9999px;top:0;visibility:hidden;display:flex;flex-direction:row;flex-wrap:nowrap;width:max-content";
          document.body.appendChild(clone);
          const ancho = clone.scrollWidth;
          clone.remove();
          return ancho;
        }
        // El CTA puede estar oculto por el propio colapso (offsetWidth 0):
        // medirlo en vivo haría que la barra "quepa" sin él y oscilaría.
        function anchoCta() {
          if (!navCta) return 0;
          const clone = navCta.cloneNode(true);
          clone.style.cssText = "position:fixed;left:-9999px;top:0;visibility:hidden;display:inline-flex";
          document.body.appendChild(clone);
          const ancho = clone.offsetWidth;
          clone.remove();
          return ancho;
        }
        function seccionesCaben() {
          const disponible =
            siteNav.clientWidth -
            (brandEl?.offsetWidth ?? 0) -
            (navAcciones?.offsetWidth ?? 0) -
            anchoCta() -
            40; // padding del nav (modo mapa) + gaps
          return anchoSecciones() <= disponible;
        }
        let pendiente = false;
        function programarActualizacion() {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(() => {
            pendiente = false;
            if (seccionesCaben()) {
              siteNav.classList.remove("nav-overflow");
              colapsarNavApp(); // si ya cabe, cerrar el panel
            } else {
              siteNav.classList.add("nav-overflow");
            }
          });
        }
        programarActualizacion();
        if ("ResizeObserver" in window) {
          const obs = new ResizeObserver(programarActualizacion);
          obs.observe(siteNav);
          obs.observe(navSecciones);
        }
        window.addEventListener("resize", programarActualizacion);
        document.fonts?.ready?.then(programarActualizacion).catch(() => {});
      }
    </script>
  </body>
</html>
