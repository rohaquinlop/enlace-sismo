---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const GITHUB = "https://github.com/rohaquinlop/enlace-sismo";

const SECCIONES = [
  { href: "/#mapa", label: "Mapa", descripcion: "Zonas afectadas, epicentro y puntos sobre el territorio." },
  { href: "/acopios", label: "Puntos de acopio", descripcion: "Dónde entregar alimentos, ropa, agua y medicamentos." },
  { href: "/albergues", label: "Albergues", descripcion: "Refugios habilitados para damnificados." },
  { href: "/salud", label: "Centros de salud", descripcion: "Hospitales, clínicas y primeros auxilios." },
  { href: "/desaparecidos", label: "Desaparecidos", descripcion: "Reportes de personas desaparecidas en ColombiaTeBusca." },
  { href: "/reportar", label: "Reportar punto", descripcion: "Reporta un punto de rescate con ubicación exacta." },
  { href: "/ayuda", label: "Cómo ayudar", descripcion: "Canales oficiales de donación y voluntariado." },
  { href: "/contactos", label: "Contactos", descripcion: "Líneas de emergencia oficiales." },
];

// La paleta enlaza ciudades al mapa de la portada con deep-link: /?ciudad=<id>#mapa
const slugCiudad = (c: string) =>
  c
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/\s+/g, "-");
const CIUDADES = [
  "Bogotá", "Cali", "Medellín", "Pereira", "Manizales", "Armenia", "Chocó", "Valle del Cauca",
].map((c) => ({ label: c, href: `/?ciudad=${slugCiudad(c)}#mapa` }));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="sismo colombia, terremoto, ayuda, acopios, albergues, desaparecidos, San José del Palmar, Chocó"
    />
    <link rel="canonical" href={`https://enlacesismo.com${Astro.url.pathname}`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <meta name="theme-color" content="#f8f9fb" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`https://enlacesismo.com${Astro.url.pathname}`} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Service worker solo en producción. En dev (Vite) los estilos se sirven
         por URLs estables con contenido mutable: un SW cache-first los
         congelaría y cada recarga mezclaría CSS viejo con HTML nuevo.
         En dev, además, se libera cualquier SW previo que haya quedado. -->
    <script>
      if ("serviceWorker" in navigator) {
        if (import.meta.env.PROD) {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        } else {
          navigator.serviceWorker.getRegistrations().then((rs) => rs.forEach((r) => r.unregister()));
        }
      }
    </script>
  </head>
  <body>
    <header class="site-nav">
      <a class="brand" href="/">
        <span class="brand-dot" aria-hidden="true"></span>
        Enlace Sismo
      </a>
      <nav class="nav-secciones" aria-label="Secciones">
        {SECCIONES.map((s) => (
          <a href={s.href} class:list={{ active: Astro.url.pathname === new URL(s.href, Astro.url).pathname }}>
            {s.label}
          </a>
        ))}
      </nav>
      <div class="nav-actions">
        <button class="nav-hamburguesa" id="nav-hamburguesa" aria-label="Abrir menú" aria-expanded="false">
          <span class="hamburguesa-linea"></span>
          <span class="hamburguesa-linea"></span>
          <span class="hamburguesa-linea"></span>
        </button>
        <a class="btn btn-primary" href="https://colombiatebusca.com" target="_blank" rel="noopener noreferrer">
          <span class="btn-cta-full">Buscar o reportar desaparecidos</span>
          <span class="btn-cta-movil" aria-hidden="true">Desaparecidos</span>
        </a>
      </div>
    </header>

    <aside class="nav-sidebar" id="nav-sidebar" aria-hidden="true">
      <div class="nav-sidebar-header">
        <span class="nav-sidebar-titulo">Secciones</span>
        <button class="nav-sidebar-cerrar" id="nav-sidebar-cerrar" aria-label="Cerrar menú">&times;</button>
      </div>
      <nav class="nav-sidebar-links">
        {SECCIONES.map((s) => (
          <a href={s.href} class:list={{ active: Astro.url.pathname === new URL(s.href, Astro.url).pathname }}>
            {s.label}
          </a>
        ))}
      </nav>
    </aside>
    <div class="nav-sidebar-backdrop" id="nav-sidebar-backdrop"></div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="foot-line">
        <strong>ENLACE SISMO</strong>
        <span class="foot-sep">·</span>
        <span>datos verificados contra fuente</span>
        <span class="foot-sep">·</span>
        <span>SGC · UNGRD · Cruz Roja</span>
        <span class="foot-sep">·</span>
        <span>emergencia <strong>123</strong></span>
        <span class="foot-sep">·</span>
        <a href={GITHUB} target="_blank" rel="noopener">código (MIT)</a>
        <span class="foot-sep">·</span>
        <a href={`${GITHUB}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">contribuir</a>
      </div>
    </footer>

    <script is:inline define:vars={{ SECCIONES, CIUDADES, GITHUB }}>
      // Marca "Enlace Sismo": en la portada vuelve al mapa y limpia el deep-link
      // sin recargar la página; en otras páginas navega a la portada (comportamiento normal).
      const brand = document.querySelector(".brand");
      brand?.addEventListener("click", (e) => {
        const enPortada = location.pathname.replace(/\/+$/, "") === "";
        if (!enPortada) return;
        e.preventDefault();
        if (location.search) history.replaceState(null, "", "/");
        window.dispatchEvent(new CustomEvent("enlace:mapa:reiniciar"));
        const mapa = document.getElementById("mapa");
        (mapa ?? document.body).scrollIntoView({ behavior: "smooth", block: "start" });
      });

      // Sidebar móvil
      const btnHamburguesa = document.getElementById("nav-hamburguesa");
      const sidebar = document.getElementById("nav-sidebar");
      const backdrop = document.getElementById("nav-sidebar-backdrop");
      const btnCerrar = document.getElementById("nav-sidebar-cerrar");

      function abrirSidebar() {
        sidebar?.setAttribute("aria-hidden", "false");
        backdrop?.setAttribute("data-open", "true");
        btnHamburguesa?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }
      function cerrarSidebar() {
        sidebar?.setAttribute("aria-hidden", "true");
        backdrop?.setAttribute("data-open", "false");
        btnHamburguesa?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }

      btnHamburguesa?.addEventListener("click", abrirSidebar);
      btnCerrar?.addEventListener("click", cerrarSidebar);
      backdrop?.addEventListener("click", cerrarSidebar);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") cerrarSidebar();
      });
    </script>
  </body>
</html>
